<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="FaciTrack - Progressive Web Application for Faculty Appointment and Real-Time Monitoring System at Camarines Sur Polytechnic Colleges">
    <meta name="keywords" content="faculty, appointment, monitoring, BLE, IoT, CSPC">
    <meta name="author" content="CSPC - College of Computer Studies">
    <meta name="theme-color" content="#0A3D62">
    <%# Tab title reads "Page | FaciTrack". Controllers still pass the older
        "FaciTrack - Page" form, so the brand prefix is stripped here rather
        than in every render call. %>
    <% const pageName = String(locals.title || '').replace(/^\s*FaciTrack\s*(?:[-|–]\s*|$)/i, '').trim(); %>
    <title><%= pageName ? pageName + ' | FaciTrack' : 'FaciTrack' %></title>
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/images/icon-192.png" type="image/png" sizes="192x192">
    <%# iOS ignores the manifest's icons and reads this instead. It also has no
        maskable concept, so it gets the opaque one — a transparent icon would
        come out black on the home screen. %>
    <link rel="apple-touch-icon" href="/images/icon-maskable-192.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet"></noscript>
    <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>">
    <link rel="stylesheet" href="/css/header.css?v=<%= Date.now() %>">
</head>
<body>
    <header class="main-header">
        <div class="header-container">
            <div class="logo">
                <div class="logo-icon">
                    <img src="/images/FaciTrack-logo.png" alt="FaciTrack Logo">
                </div>
            </div>
            <div class="header-institution">
                <%# Pages without a sidebar (error pages) opt out — the panel script never loads there %>
                <% const _showNotif = (typeof showNotifications !== 'undefined') ? showNotifications : true; %>
                <% if (_showNotif) { %>
                <% const _notifSource = (typeof notifications !== 'undefined') ? notifications : []; %>
                <% const unreadCount = _notifSource.filter(n => !n.read).length; %>
                    <div class="notif-wrapper">
                        <button class="btn-notif-bell header-notif" id="btnNotifBell" aria-label="Notifications">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                            <% if (unreadCount > 0) { %>
                            <span class="notif-bell-badge" id="notifBellBadge"><%= unreadCount %></span>
                            <% } else { %>
                            <span class="notif-bell-badge" id="notifBellBadge" style="display:none">0</span>
                            <% } %>
                        </button>
                    </div>
                <% } %>
                <%# Below 1024px the institution name gives up its place to the
                    navigation toggle. The sidebar keeps the real toggle and all
                    its behaviour; this button just forwards to it. %>
                <button class="header-menu-toggle" id="headerMenuToggle" type="button"
                        aria-label="Toggle navigation" aria-expanded="false" hidden>
                    <svg class="icon-menu" width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
                    </svg>
                    <svg class="icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none;">
                        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            </div>
        </div>
    </header>
