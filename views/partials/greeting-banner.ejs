<%#
  Greeting banner: "Good morning/afternoon/evening," the user's name, and
  today's date.
  Used by the student Faculty Directory and the instructor and dean
  dashboards; styles live in public/css/greeting-banner.css, loaded here so a
  page only has to include this partial. Put it first inside .main-container,
  so on a phone it sits flush under whatever is above it.

  Locals:
    name  — the full name to greet; shown uppercased.
    today — optional. A list of pills beside the greeting, behind a divider,
            on large screens only:
              items  [{ time, name, status }] or [{ text, status }]
              more   how many were left out ("+N more")
              label  heading (default "Today's consultations")
              empty  shown when there are no items
              pendingNote  false to drop the "(Pending)" suffix, for a list
                           that is all pending anyway
%>
<link rel="stylesheet" href="/css/greeting-banner.css?v=<%= assetVersion %>">
<%# Only for the script greeting line. %>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@1,500&display=swap" rel="stylesheet">
<%
  // The greeting and date follow the campus clock, not the server's: on Vercel
  // the server runs on UTC, which would greet a 9 AM visitor with "Good
  // evening" and show yesterday's date before 8 AM.
  const _tz = process.env.APP_TIMEZONE || 'Asia/Manila';
  const _now = new Date();
  const _bannerDate = _now.toLocaleDateString('en-PH', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: _tz });
  const _hour = Number(new Intl.DateTimeFormat('en-US', { hour: 'numeric', hourCycle: 'h23', timeZone: _tz }).format(_now));
  // Morning until noon, afternoon until 6 PM, evening after.
  const _greeting = _hour < 12 ? 'Good Morning,' : _hour < 18 ? 'Good Afternoon,' : 'Good Evening,';
  const _today = (typeof today !== 'undefined' && today) ? today : null;
%>
<div class="greeting-banner<%= _today ? ' has-today' : '' %>">
    <%# The CSPC seal as a white silhouette. cspc-silhouette.png is
        CSPC-logo.png with every opaque pixel turned white (its light areas
        are already transparent), shrunk to 360px: 35 KB instead of 250 KB
        for a decoration. %>
    <img class="greeting-banner-art" src="/images/cspc-silhouette.png" alt="" aria-hidden="true">

    <div class="greeting-banner-hello">
        <p class="greeting-banner-greeting"><%= _greeting %></p>
        <p class="greeting-banner-name"><%= String(typeof name !== 'undefined' && name ? name : '').toUpperCase() %></p>
        <p class="greeting-banner-date"><%= _bannerDate %></p>
    </div>

    <% if (_today) { %>
    <div class="greeting-banner-divider" aria-hidden="true"></div>
    <div class="greeting-banner-today">
        <p class="greeting-banner-today-label"><%= _today.label || "Today's consultations" %></p>
        <% if (!_today.items.length) { %>
            <p class="greeting-banner-today-empty"><%= _today.empty || 'No consultations scheduled for today' %></p>
        <% } else { %>
        <ul class="greeting-banner-pills">
            <% _today.items.forEach(item => { %>
            <li class="greeting-banner-pill <%= item.status %>">
                <svg class="greeting-banner-pill-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                    <% if (item.status === 'pending') { %><polyline points="12 13.5 12 16 13.8 17.2"/><% } else { %><polyline points="9 16 11 18 15 14"/><% } %>
                </svg>
                <span><%= item.text || (item.time + ' · ' + item.name) %><% if (item.status === 'pending' && _today.pendingNote !== false) { %> <em>(Pending)</em><% } %></span>
            </li>
            <% }); %>
            <% if (_today.more > 0) { %>
            <li class="greeting-banner-pill more">+<%= _today.more %> more</li>
            <% } %>
        </ul>
        <% } %>
    </div>
    <% } %>
</div>

