<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/instructor/dashboard.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/report-table.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/student/appointments.css?v=<%= assetVersion %>">

<div class="instructor-layout">
    <%- include('../../partials/student-sidebar', { activePage: 'appointments', appointmentCount: appointments.length }) %>

    <main class="instructor-main">
        <div class="main-container">

            <% const initials = name => name.split(/[\s,]+/).filter(Boolean).slice(0, 2).map(n => n[0]).join('').toUpperCase(); %>

            <div class="page-header">
                <div>
                    <h1 class="page-title">My Appointments</h1>
                    <p class="page-subtitle">
                        <% if (instructors.length) { %>
                            Your consultations with <%= instructors.length %> instructor<%= instructors.length === 1 ? '' : 's' %>
                        <% } else { %>
                            View and manage your consultation bookings
                        <% } %>
                    </p>
                </div>
                <div class="header-actions">
                    <div class="view-toggle-group">
                        <button type="button" class="view-toggle-btn active" id="btnListView">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                            Instructors
                        </button>
                        <button type="button" class="view-toggle-btn" id="btnCalendarView">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            Calendar
                        </button>
                    </div>
                </div>
            </div>

            <!-- Instructor grid -->
            <div id="listViewContainer" class="list-container active">

            <% if (!instructors.length) { %>
                <div class="empty-state">
                    <div class="empty-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    </div>
                    <h3 class="empty-title">No Appointments Yet</h3>
                    <p class="empty-desc">You haven't booked any consultations. Browse the faculty directory to schedule your first appointment.</p>
                    <a href="/student/dashboard" class="btn-header-action primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect>
                            <rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect>
                        </svg>
                        Browse Faculty
                    </a>
                </div>
            <% } else { %>
                <div class="card-toolbar">
                    <div class="toolbar-group">
                        <span class="toolbar-label">Search</span>
                        <input type="search" class="table-search" id="instSearch" placeholder="Instructor name or position…">
                    </div>
                    <span class="result-count" id="instCount">—</span>
                </div>

                <div class="no-results" id="instEmpty" hidden>
                    <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <p>No instructor matches your search.</p>
                </div>

                <div class="instructor-grid">
                    <%# One card per instructor. The whole card is the link, so the
                        tap target on a phone is the card rather than a small chevron.
                        data-search is what the toolbar matches against. %>
                    <% instructors.forEach(inst => { %>
                    <a class="inst-card" href="/student/appointments/<%= inst.instructorId %>"
                       data-search="<%= [inst.facultyDisplayName, inst.facultyName, inst.position, inst.departmentName].filter(Boolean).join(' ').toLowerCase() %>">
                        <div class="inst-card-top">
                            <div class="inst-avatar">
                                <% if (inst.facultyPhoto) { %>
                                    <img src="<%= inst.facultyPhoto %>" alt="<%= inst.facultyDisplayName %>">
                                <% } else { %>
                                    <%= initials(inst.facultyDisplayName) %>
                                <% } %>
                            </div>
                            <div class="inst-id">
                                <p class="inst-name"><%= inst.facultyDisplayName %></p>
                                <p class="inst-sub"><%= inst.position || inst.departmentName || 'Faculty' %></p>
                            </div>
                        </div>

                        <div class="inst-counts">
                            <% if (inst.pending) { %>
                            <span class="inst-chip pending"><%= inst.pending %> pending</span>
                            <% } %>
                            <% if (inst.upcoming) { %>
                            <span class="inst-chip upcoming"><%= inst.upcoming %> upcoming</span>
                            <% } %>
                            <% if (inst.completed) { %>
                            <span class="inst-chip"><%= inst.completed %> completed</span>
                            <% } %>
                        </div>

                        <% if (inst.nextDate) { %>
                        <div class="inst-next">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            <span>Next: <%= new Date(inst.nextDate + 'T00:00:00').toLocaleDateString('en-PH', { month: 'short', day: 'numeric', timeZone: 'Asia/Manila' }) %> · <%= inst.nextSlot %></span>
                        </div>
                        <% } else { %>
                        <div class="inst-next quiet">
                            <span>Last seen <%= new Date(inst.lastDate + 'T00:00:00').toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'Asia/Manila' }) %></span>
                        </div>
                        <% } %>

                        <div class="inst-foot">
                            <span class="inst-total"><%= inst.total %> appointment<%= inst.total === 1 ? '' : 's' %></span>
                            <span class="inst-open">
                                View
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                            </span>
                        </div>
                    </a>
                    <% }); %>
                </div>
            <% } %>
            </div>


            <!-- Calendar View Container — every instructor, so it stays here -->
            <div id="calendarViewContainer" class="calendar-container">
                <div class="calendar-wrapper">
                    <div class="calendar-header">
                        <h3 class="calendar-title" id="calendarMonthYear">—</h3>
                        <div class="calendar-nav">
                            <button type="button" class="calendar-nav-btn" id="btnPrevMonth">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                            </button>
                            <button type="button" class="calendar-nav-btn" id="btnNextMonth">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                            </button>
                        </div>
                    </div>
                    <div class="calendar-grid" id="calendarGrid">
                        <div class="calendar-day-header">Sun</div>
                        <div class="calendar-day-header">Mon</div>
                        <div class="calendar-day-header">Tue</div>
                        <div class="calendar-day-header">Wed</div>
                        <div class="calendar-day-header">Thu</div>
                        <div class="calendar-day-header">Fri</div>
                        <div class="calendar-day-header">Sat</div>
                    </div>
                    <div class="calendar-legend">
                        <div class="calendar-legend-item"><div class="calendar-legend-dot pending"></div> Pending</div>
                        <div class="calendar-legend-item"><div class="calendar-legend-dot confirmed"></div> Confirmed</div>
                        <div class="calendar-legend-item"><div class="calendar-legend-dot completed"></div> Completed</div>
                        <div class="calendar-legend-item"><div class="calendar-legend-dot rescheduled"></div> Rescheduled</div>
                        <div class="calendar-legend-item"><div class="calendar-legend-dot declined"></div> Declined</div>
                        <div class="calendar-legend-item"><div class="calendar-legend-dot cancelled"></div> Cancelled</div>
                    </div>
                </div>
            </div>

        </div>
    </main>
</div>

<div class="toast-container" id="toastContainer"></div>

<%- include('../../partials/footer') %>
<%- include('../../partials/script') %>
<script>
  window.STUDENT_APPOINTMENTS = <%- JSON.stringify(appointments) %>;
</script>
<script src="/js/card-filter.js?v=<%= assetVersion %>"></script>
<script src="/js/student-appointments.js?v=<%= assetVersion %>"></script>
