<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/login.css?v=<%= Date.now() %>">

<div class="lp-wrap">

    <!-- ── Left: CSPC Background ── -->
    <div class="lp-bg">
        <div class="lp-bg-content">
            <img src="/images/CSPC-logo.png" alt="CSPC Logo" class="lp-logo-img">
            <h2 class="lp-school-name">CSPC</h2>
            <p class="lp-school-sub">Camarines Sur Polytechnic Colleges</p>
            <span class="lp-tagline">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                Faculty Consultation Tracking System
            </span>
        </div>
    </div>

    <!-- ── Right: Login Card ── -->
    <div class="lp-card-wrap">
        <div class="lp-card">

            <!-- App Brand -->
            <div class="lp-brand">
                <img src="/images/FaciTrack-logo.png" alt="FaciTrack Logo" class="lp-brand-logo"
                     onerror="this.style.display='none'">
                <h1 class="lp-brand-name">FaciTrack</h1>
                <p class="lp-brand-desc">Sign in to your account</p>
            </div>

            <!-- Error -->
            <% if (typeof error !== 'undefined' && error) { %>
            <div class="lp-error">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <%= error %>
            </div>
            <% } %>

            <!-- Staff / Admin Login -->
            <p class="lp-form-label">Instructor &amp; Admin</p>
            <form action="/login" method="POST" class="lp-form">
                <div class="lp-field">
                    <input type="text" name="email" id="email"
                        class="lp-input <%= (typeof error !== 'undefined' && error && error !== 'Please enter your password.') ? 'error' : '' %>"
                        placeholder="Email address" required autofocus autocomplete="email">
                </div>

                <div class="lp-field">
                    <span class="lp-field-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    </span>
                    <input type="password" name="password" id="password"
                        class="lp-input <%= (typeof error !== 'undefined' && error === 'Please enter your password.') ? 'error' : '' %>"
                        placeholder="Password" required autocomplete="current-password">
                </div>

                <button type="submit" class="lp-btn-submit">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
                    Sign In
                </button>
            </form>

            <!-- Divider -->
            <div class="lp-divider">or</div>

            <!-- Student Google Login -->
            <p class="lp-google-label">Student Login</p>
            <a href="/auth/google" class="lp-btn-google">
                <svg class="lp-google-icon" viewBox="0 0 24 24" aria-label="Google Logo" role="img" style="width: 18px; height: 18px;">
                    <path fill="#EA4335" d="M12 10.2v3.9h5.4c-.2 1.3-1.5 3.9-5.4 3.9-3.3 0-6-2.7-6-6s2.7-6 6-6c1.9 0 3.2.8 3.9 1.5l2.7-2.6C16.7 3.1 14.6 2.2 12 2.2 6.9 2.2 2.7 6.4 2.7 11.5S6.9 20.8 12 20.8c6.9 0 11.5-4.8 11.5-11.6 0-.8-.1-1.4-.2-2H12Z"/>
                    <path fill="#34A853" d="M3.8 7.1l3.5 2.6c1-1.8 3-3 5.7-3 1.9 0 3.2.8 3.9 1.5l2.7-2.6C16.7 3.1 14.6 2.2 12 2.2 8.2 2.2 4.9 4.5 3.8 7.1Z"/>
                    <path fill="#FBBC05" d="M3.8 16.9c1.1 2.6 4.4 4.6 8.2 4.6 2.5 0 4.6-.9 6.1-2.4l-2.8-2.4c-.8.6-1.9 1-3.3 1-2.7 0-4.9-1.9-5.4-4.2l-3.1 2.4Z"/>
                    <path fill="#4285F4" d="M12 20.8c2.3 0 4.3-.8 5.7-2.2l-2.8-2.4c-.8.6-1.9 1-3.3 1-2.7 0-4.9-1.9-5.4-4.2l-3.1 2.4c1.1 4.1 5 7.1 10.9 7.1Z"/>
                </svg>
                Sign in with CSPC Mail
            </a>
            <p class="lp-google-note">For students with @my.cspc.edu.ph accounts</p>

            <!-- Role hints -->
            <div class="lp-roles">
                <span class="lp-role-chip instr">Instructor</span>
                <span class="lp-role-chip dean">Dean</span>
                <span class="lp-role-chip admin">Admin</span>
            </div>

        </div>
    </div>

</div>

<%- include('../partials/footer') %>
<%- include('../partials/script') %>
