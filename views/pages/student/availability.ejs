<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/instructor/dashboard.css?v=<%= assetVersion %>">
<style>
    .avail-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(190px,1fr)); gap:1rem; }
    .avail-card { background:#fff; border:1px solid var(--gray-200); border-radius:var(--radius-lg); box-shadow:var(--shadow-sm); overflow:hidden; display:flex; flex-direction:column; transition:transform .2s,box-shadow .2s,border-color .2s; }
    .avail-card:hover { transform:translateY(-3px); box-shadow:var(--shadow-md); }
    .avail-card.in-room { border-color:rgba(22,163,74,.35); }
    .avail-card[hidden] { display:none !important; }
    .avail-photo { width:100%; aspect-ratio:1/1; background:linear-gradient(135deg,#e8eef5,#d0dce8); display:flex; align-items:center; justify-content:center; position:relative; flex-shrink:0; }
    .avail-photo svg { width:42%; height:42%; color:#a0b4c8; }
    .avail-photo img { width:100%; height:100%; object-fit:cover; }
    /* "IN" on the photo's top-left corner while the lounge detects them: a soft
       green wash with a light blur so it reads over any photo without shouting. */
    /* Lounge presence on the photo's top-left corner: a rounded square. IN is
       green and breathes gently; OUT is a muted red that stays quiet next to
       it. No badge when nothing has ever reported on the person. */
    .avail-presence { position:absolute; top:8px; left:8px; padding:3px 8px; border-radius:6px; font-size:.625rem; font-weight:800; letter-spacing:.08em; line-height:1.4; -webkit-backdrop-filter:blur(4px); backdrop-filter:blur(4px); }
    .avail-presence[hidden] { display:none; }
    .avail-presence.in-room { background:rgba(240,253,244,.92); color:#15803d; border:1px solid rgba(22,163,74,.35); animation:presence-breathe 2.4s ease-in-out infinite; }
    /* A green dot before "IN"; drawn by CSS so live updates, which only swap
       the class, keep it without touching the markup. */
    .avail-presence.in-room { display:inline-flex; align-items:center; gap:4px; }
    .avail-presence.in-room::before { content:''; width:6px; height:6px; border-radius:50%; background:#16a34a; flex-shrink:0; }
    .avail-presence.in-room[hidden] { display:none; }
    .avail-presence.out-of-room { background:rgba(254,242,242,.85); color:#b4636b; border:1px solid rgba(220,38,38,.15); }
    /* Breathing: the IN badge fades down and back to full, with a soft glow
       swelling at the same time, so it reads as alive without flashing. */
    @keyframes presence-breathe {
        0%, 100% { opacity:1;   box-shadow:0 0 0 0 rgba(22,163,74,.45); }
        50%      { opacity:.35; box-shadow:0 0 0 6px rgba(22,163,74,0); }
    }
    @media (prefers-reduced-motion: reduce) { .avail-presence.in-room { animation:none; } }
    /* Third line of the card: when they were last seen, muted. */
    .avail-seen { font-size:.6875rem; color:var(--gray-400); margin:0; }
    .avail-seen:empty { display:none; }
    /* Name, status badge and last-seen line, centred under the photo. */
    .avail-info { padding:.75rem .875rem; display:flex; flex-direction:column; align-items:center; text-align:center; gap:.375rem; }
    .avail-info .avail-badge { align-self:center; }
    .avail-name { font-weight:700; font-size:.875rem; color:var(--gray-900); margin:0; line-height:1.3; }

    /* Two independent signals, never merged into one verdict */
    .avail-badge { display:inline-flex; align-items:center; gap:.3rem; padding:3px 10px; border-radius:var(--radius-full); font-size:.6875rem; font-weight:700; letter-spacing:.4px; align-self:flex-start; white-space:nowrap; }
    .avail-badge.available { background:#f0fdf4; color:#16a34a; border:1px solid #bbf7d0; }
    .avail-badge.dnd       { background:#fef2f2; color:#b91c1c; border:1px solid #fecaca; }
    .avail-badge.travel    { background:#fff7ed; color:#c2410c; border:1px solid #fed7aa; }
    .avail-badge.leave     { background:#fef2f2; color:#dc2626; border:1px solid #fecaca; }
    .avail-badge.meeting   { background:#f5f3ff; color:#6d28d9; border:1px solid #ddd6fe; }
    .avail-badge.none      { background:var(--gray-100); color:var(--gray-500); border:1px solid var(--gray-200); }


    .live-pill { display:inline-flex; align-items:center; gap:6px; border-radius:var(--radius-full); padding:5px 14px; font-size:.78rem; font-weight:700; letter-spacing:.5px; }
    .live-pill.on  { background:#f0fdf4; color:#16a34a; border:1px solid #bbf7d0; }
    .live-pill.off { background:var(--gray-100); color:var(--gray-500); border:1px solid var(--gray-200); }
    .live-dot { width:7px; height:7px; background:currentColor; border-radius:50%; }
    .live-pill.on .live-dot { animation:blink 1.5s infinite; }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:.3} }

    .presence-notice { display:flex; align-items:flex-start; gap:.75rem; padding:.875rem 1.125rem; background:#eff6ff; border:1px solid #bfdbfe; border-radius:var(--radius-md); margin-bottom:1rem; }
    .presence-notice svg { color:#2563eb; flex-shrink:0; margin-top:1px; }
    .presence-notice p { font-size:.8125rem; color:#1e40af; margin:0; line-height:1.5; }

    .avail-toolbar { display:flex; gap:.625rem; align-items:center; flex-wrap:wrap; }
    .avail-search-wrap { position:relative; flex:1; min-width:220px; }
    .avail-search-wrap svg { position:absolute; left:12px; top:50%; transform:translateY(-50%); color:var(--gray-400); pointer-events:none; }
    .avail-search { width:100%; padding:.6rem 1rem .6rem 2.4rem; border:1.5px solid var(--gray-200); border-radius:var(--radius-md); font-size:.875rem; font-family:var(--font-body); background:#fff; color:var(--gray-800); outline:none; }
    .avail-search:focus { border-color:var(--primary-blue); }
    .avail-select { padding:.6rem .875rem; border:1.5px solid var(--gray-200); border-radius:var(--radius-md); font-size:.875rem; font-family:var(--font-body); background:#fff; color:var(--gray-800); outline:none; cursor:pointer; }
    .avail-count { font-size:.78rem; color:var(--gray-500); font-weight:600; white-space:nowrap; }

    @media (max-width:600px) {
        .avail-grid { grid-template-columns:repeat(2,1fr); }
        .avail-toolbar { flex-direction:column; align-items:stretch; }
        .avail-search-wrap, .avail-select { width:100%; }
        .avail-count { align-self:flex-start; }
        .presence-notice { padding:.75rem .875rem; }
        .presence-notice p { font-size:.75rem; }
    }
</style>

<div class="instructor-layout">
    <%- include('../../partials/student-sidebar', { activePage: 'availability', appointmentCount: 0 }) %>

    <main class="instructor-main">
        <div class="main-container">

            <% const initials = n => n.split(/[\s,]+/).filter(Boolean).slice(0, 2).map(p => p[0]).join('').toUpperCase(); %>

            <div class="page-header">
                <div>
                    <h1 class="page-title">Faculty Lounge</h1>
                    <p class="page-subtitle">
                        <% if (departmentMissing) { %>
                            Set your department to see who is in
                        <% } else { %>
                            <%= faculty.length %> instructor<%= faculty.length === 1 ? '' : 's' %> —
                            <%= loungeCovered ? 'live lounge presence' : 'showing self-reported status' %>
                        <% } %>
                    </p>
                </div>
                <% if (!departmentMissing) { %>
                <div class="header-actions">
                    <%# The pill only claims LIVE when something is actually reporting %>
                    <div class="live-pill <%= loungeCovered ? 'on' : 'off' %>">
                        <span class="live-dot"></span><%= loungeCovered ? 'LIVE' : 'NOT LIVE' %>
                    </div>
                </div>
                <% } %>
            </div>

<% if (departmentMissing) { %>
            <%# The normal first visit, not an error: the sidebar link is always
                there, so this is where a student who has not set a department
                lands. It names what the page does before asking for anything,
                so the feature is discoverable rather than invisible. %>
            <div class="content-card">
                <div class="card-body" style="text-align:center;padding:3rem 1.5rem;">
                    <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin:0 auto 1rem;display:block;color:var(--gray-300);"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                    <h3 style="font-size:1rem;color:var(--gray-800);margin:0 0 .5rem;">Set your department to use this page</h3>
                    <p style="font-size:.875rem;color:var(--gray-500);line-height:1.65;margin:0 auto 1.25rem;max-width:32rem;">
                        The Faculty Lounge shows which of your instructors are at the lounge
                        right now, and the availability each of them has set. It needs to know
                        which department's lounge to watch — that is the only thing missing.
                    </p>
                    <a href="/student/settings" class="btn-primary" style="display:inline-flex;align-items:center;gap:.4rem;padding:.6rem 1.1rem;border-radius:var(--radius-md);text-decoration:none;font-size:.875rem;font-weight:600;">
                        Go to Settings
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                    </a>
                </div>
            </div>
<% } else { %>

            <%# In and Out on this page mean the Faculty Lounge specifically.
                When nothing is watching one, every card reads "No data" — which
                looks broken unless the page says why. %>
            <% if (loungeNotice && faculty.length) { %>
            <div class="presence-notice">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                <p><strong>Lounge presence is not available.</strong> <%= loungeNotice %></p>
            </div>
            <% } %>

            <div class="content-card" style="margin-bottom:1rem;">
                <div class="card-body" style="padding:.875rem 1.25rem;">
                    <div class="avail-toolbar">
                        <div class="avail-search-wrap">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <input type="search" class="avail-search" id="availSearch" placeholder="Search instructor or department…">
                        </div>
                        <% if (departments.length > 1) { %>
                        <select class="avail-select" id="availDept">
                            <option value="all">All Departments</option>
                            <% departments.forEach(d => { %>
                            <option value="<%= d %>"><%= d %></option>
                            <% }); %>
                        </select>
                        <% } %>
                        <select class="avail-select" id="availStatus">
                            <option value="all">All Status</option>
                            <option value="available">Available</option>
                            <option value="dnd">Do Not Disturb</option>
                            <option value="meeting">In a Meeting</option>
                            <option value="travel">Official Travel</option>
                            <option value="leave">On Leave</option>
                            <option value="none">Not set</option>
                        </select>
                        <select class="avail-select" id="availPresence">
                            <option value="all">Anywhere</option>
                            <option value="in-room">At the lounge</option>
                            <option value="out-of-room">Not at the lounge</option>
                            <option value="unknown">Awaiting Data</option>
                        </select>
                        <span class="avail-count" id="availCount">—</span>
                    </div>
                </div>
            </div>

            <div class="content-card">
                <div class="card-header">
                    <h3 class="card-title">Faculty Status</h3>
                </div>
                <div class="card-body" style="padding:1.25rem;">
                    <% if (!faculty.length) { %>
                    <p style="text-align:center;padding:2rem;color:var(--gray-400);font-size:.875rem;margin:0;">
                        No instructors are registered yet.
                    </p>
                    <% } else { %>
                    <div class="avail-grid" id="availGrid">
                        <% faculty.forEach(f => { %>
                        <div class="avail-card <%= f.bleStatus %>"
                             data-instructor="<%= f.id %>"
                             data-status="<%= f.availability || 'none' %>"
                             data-presence="<%= f.bleStatus %>"
                             data-dept="<%= f.department %>"
                             data-name="<%= f.name %>"
                             data-search="<%= [f.name, f.department].filter(Boolean).join(' ').toLowerCase() %>">
                            <div class="avail-photo">
                                <% if (f.photo) { %>
                                    <img src="<%= f.photo %>" alt="<%= f.name %>">
                                <% } else { %>
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                <% } %>
                                <%# IN / OUT at the lounge; no badge when no scanner has
                                    ever reported on this person. %>
                                <span class="avail-presence <%= f.bleStatus %>"
                                      title="<%= f.bleStatus === 'in-room' ? 'At the Faculty Lounge' : 'Not at the Faculty Lounge' %>"
                                      <%= f.bleStatus === 'unknown' ? 'hidden' : '' %>><%= f.bleStatus === 'in-room' ? 'IN' : 'OUT' %></span>
                            </div>
                            <div class="avail-info">
                                <p class="avail-name"><%= f.name %></p>
                                <%# The instructor's own status, separate from lounge presence. %>
                                <span class="avail-badge <%= f.availability || 'none' %>"><%= f.availabilityLabel %></span>
                                <%# Third line, muted: "Just now" while in, otherwise when
                                    they were last seen. Empty when nothing is known. %>
                                <p class="avail-seen"><%= f.bleStatus === 'in-room' ? 'Just now' : (f.bleStatus === 'out-of-room' && f.lastSeen ? f.lastSeen : '') %></p>
                            </div>
                        </div>
                        <% }); %>
                    </div>
                    <p id="availEmpty" style="display:none;text-align:center;padding:2rem;color:var(--gray-400);font-size:.875rem;">No instructor matches your search.</p>
                    <% } %>
                </div>
            </div>
<% } %>

        </div>
    </main>
</div>

<%- include('../../partials/footer') %>
<%- include('../../partials/script') %>
<script src="/js/presence-live.js?v=<%= assetVersion %>"></script>
<script src="/js/card-filter.js?v=<%= assetVersion %>"></script>
<script>
(function () {
    'use strict';
    if (!window.CardFilter) return;
    // No toolbar when the page is showing the "set your department" state.
    if (!document.getElementById('availSearch')) return;

    var empty = document.getElementById('availEmpty');
    var filters = [
        { selector: '#availStatus', attr: 'status' },
        { selector: '#availPresence', attr: 'presence' },
    ];
    if (document.getElementById('availDept')) {
        filters.push({ selector: '#availDept', attr: 'dept' });
    }

    var filter = window.CardFilter.create({
        cardSelector: '.avail-card',
        search: '#availSearch',
        filters: filters,
        count: '#availCount',
        noun: 'instructor',
        onFilter: function (visible) {
            if (empty) empty.style.display = visible.length ? 'none' : 'block';
        },
    });

    /* ── Live presence ──
       This page is the one people leave open, so a card that was accurate at
       load and never again is the most misleading thing here. Repaint on the
       same event the scanners already emit, then re-run the filter: someone
       who has just left has to drop out of an "In Room only" view, and the
       count beside the search box has to agree with what is on screen. */

    var PRESENCE_CLASSES = ['in-room', 'out-of-room', 'unknown'];

    function swap(el, presence) {
        if (!el) return;
        PRESENCE_CLASSES.forEach(function (c) { el.classList.remove(c); });
        el.classList.add(presence);
    }

    function repaint(faculty) {
        var byId = {};
        faculty.forEach(function (f) { byId[f.id] = f; });

        document.querySelectorAll('.avail-card').forEach(function (card) {
            var entry = byId[card.getAttribute('data-instructor')];
            if (!entry) return;

            // The lounge answer, not the building-wide one — this page asks
            // whether somebody is at the lounge, and the feed carries both.
            var presence = entry.lounge;
            var previous = card.getAttribute('data-presence');

            swap(card, presence);
            card.setAttribute('data-presence', presence);

            var tag = card.querySelector('.avail-presence');
            if (tag) {
                swap(tag, presence);
                tag.hidden = presence === 'unknown';
                tag.textContent = presence === 'in-room' ? 'IN' : 'OUT';
                tag.title = presence === 'in-room' ? 'At the Faculty Lounge' : 'Not at the Faculty Lounge';
            }

            // Only touch the "last seen" line when this person's presence
            // changed: the event covers everyone, and rewriting every card
            // would wipe each "2 hours ago" the server rendered. Arriving or
            // just leaving both mean they were seen now.
            var seen = card.querySelector('.avail-seen');
            if (seen && previous !== presence) {
                seen.textContent = presence === 'unknown' ? '' : 'Just now';
            }

            // Availability is the instructor's own word about themselves and
            // arrives on the same feed, but stays a separate indicator.
            var badge = card.querySelector('.avail-badge');
            if (badge) {
                badge.className = 'avail-badge ' + (entry.availability || 'none');
                badge.textContent = entry.availabilityLabel;
            }
            card.setAttribute('data-status', entry.availability || 'none');
        });

        sortCards();
        filter.apply();
    }

    // Same order the server renders: whoever is IN first, then by name.
    // Re-run after a live update so an arrival moves to the front.
    function sortCards() {
        var grid = document.getElementById('availGrid');
        if (!grid) return;
        var cards = Array.prototype.slice.call(grid.querySelectorAll('.avail-card'));
        cards.sort(function (a, b) {
            var ai = a.getAttribute('data-presence') === 'in-room' ? 0 : 1;
            var bi = b.getAttribute('data-presence') === 'in-room' ? 0 : 1;
            if (ai !== bi) return ai - bi;
            return (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '');
        });
        cards.forEach(function (c) { grid.appendChild(c); });
    }

    if (window.PresenceLive) window.PresenceLive.onUpdate(repaint);
}());
</script>
