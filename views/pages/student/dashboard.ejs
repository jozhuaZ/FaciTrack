<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/instructor/dashboard.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/student/dashboard.css?v=<%= assetVersion %>">
<style>
    /* Photo placeholder in faculty cards */
    .card-photo-placeholder {
        width: 52px;
        height: 52px;
        border-radius: var(--radius-full);
        background: linear-gradient(135deg, #e8eef5 0%, #d0dce8 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 2px 8px rgba(10,61,98,0.12);
    }
    .card-photo-placeholder svg {
        width: 26px;
        height: 26px;
        color: #a0b4c8;
    }
    /* Same footprint as the placeholder, so a card is the same height either way */
    .card-photo {
        width: 52px;
        height: 52px;
        border-radius: var(--radius-full);
        object-fit: cover;
        flex-shrink: 0;
        box-shadow: 0 2px 8px rgba(10,61,98,0.12);
    }

    /* ── Directory pagination ── */
    .fac-pager {
        display: flex; align-items: center; justify-content: space-between;
        gap: 1rem; flex-wrap: wrap;
        padding: 0.9rem 1.25rem; border-top: 1px solid var(--gray-200);
    }
    .fac-pager-info { font-size: 0.8125rem; color: var(--gray-500); }
    .fac-pager-buttons { display: flex; gap: 0.5rem; }
    .fac-pager-buttons button {
        padding: 0.45rem 0.9rem; border: 1.5px solid var(--gray-300);
        border-radius: var(--radius-md); background: #fff; color: var(--gray-700);
        font-size: 0.8125rem; font-weight: 600; font-family: var(--font-body);
        cursor: pointer; transition: all var(--transition-base);
    }
    .fac-pager-buttons button:hover:not(:disabled) { border-color: var(--primary-blue); color: var(--primary-blue); }
    .fac-pager-buttons button:disabled { opacity: 0.45; cursor: default; }

    @media (max-width: 640px) {
        #deptFilter {
            width: 100%;
        }
        .fac-pager { justify-content: center; }
    }
</style>

<div class="instructor-layout">
    <%- include('../../partials/student-sidebar', { activePage: 'dashboard', appointmentCount: appointmentCount }) %>

    <main class="instructor-main">
        <div class="main-container">

            <div class="page-header">
                <div>
                    <h1 class="page-title">Faculty Directory</h1>
                    <p class="page-subtitle">Browse faculty members by filtering on their department and book a consultation appointment</p>
                </div>
            </div>

            <!-- Search and Filter Bar -->
            <div class="content-card" style="margin-bottom:1rem;">
                <div class="card-body" style="padding:0.875rem 1.25rem;">
                    <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
                        <div style="position:relative;flex:.75;min-width:160px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--gray-400);pointer-events:none;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <input type="text" id="searchInput" placeholder="Search name or specialization..." style="width:100%;padding:0.6rem 1rem 0.6rem 2.4rem;border:1.5px solid var(--gray-200);border-radius:var(--radius-md);font-size:0.875rem;font-family:var(--font-body);background:#fff;color:var(--gray-800);outline:none;transition:border-color 0.2s;" onfocus="this.style.borderColor='var(--secondary-teal)'" onblur="this.style.borderColor='var(--gray-200)'">
                        </div>
                        <select id="deptFilter" class="form-select" style="flex:.25">
                            <option value="all">All Departments</option>
                            <% departments.forEach(d => { %>
                                <option value="<%= d.id %>"><%= d.full_name %></option>
                            <% }); %>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Faculty Card Grid -->
            <div class="content-card" style="flex:1;min-height:0;">
                <div class="card-body" style="padding:1.25rem;overflow-y:auto;height:100%;">
                    <div class="faculty-grid" id="facultyGrid" style="grid-template-columns:repeat(auto-fill,minmax(260px,1fr));">

                        <div class="empty-state" id="emptyState" style="display:none;grid-column:1/-1;text-align:center;padding:3rem;color:var(--gray-400);">
                            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin:0 auto 1rem;display:block;"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                            <p style="font-size:0.9rem;">No faculty found for the selected filters.</p>
                        </div>

                        <% facultyList.forEach((faculty, index) => { %>
                        <a href="/student/faculty/<%= faculty.instructor_id %>" class="faculty-card" data-status="<%= faculty.status %>" data-name="<%= (faculty.full_name || '').toLowerCase() %>" data-spec="<%= (faculty.position || '').toLowerCase() %>" data-dept="<%= faculty.department_id %>">
                            <div class="card-top">
                                <% if (faculty.profile_picture) { %>
                                    <img src="<%= faculty.profile_picture %>" alt="<%= faculty.full_name %>" class="card-photo" loading="lazy">
                                <% } else { %>
                                    <div class="card-photo-placeholder">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                    </div>
                                <% } %>
                            </div>
                            <div class="card-body">
                                <h3 class="card-name"><%= faculty.full_name %></h3>
                                <p class="card-position"><%= faculty.position %></p>
                                <p class="card-college">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                                    <%= faculty.department_name %>
                                </p>
                                <p class="card-spec">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                                    <%= faculty.position %>
                                </p>
                            </div>
                            <div class="card-footer">
                                <div class="next-available">
                                    <span class="next-label">Next available:</span>
                                    <span class="next-time"><%= faculty.nextAvailable %></span>
                                </div>
                                <span class="btn-view-inline">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                                </span>
                            </div>
                        </a>
                        <% }); %>
                    </div>
                </div>

                <%# Hidden until there is more than one page — a pager under a
                    single screen of cards is just noise. %>
                <div class="fac-pager" id="facPager" hidden>
                    <span class="fac-pager-info" id="facPagerInfo"></span>
                    <div class="fac-pager-buttons">
                        <button type="button" id="facPrev">Previous</button>
                        <button type="button" id="facNext">Next</button>
                    </div>
                </div>
            </div>

        </div>
    </main>
</div>

<div class="toast-container" id="toastContainer"></div>

<%- include('../../partials/footer') %>
<%- include('../../partials/script') %>
<script>
// The department the directory should open on: null unless Settings has
// "Start in my department" turned on and a department is actually set.
window.STUDENT_DEFAULT_DEPT = <%- JSON.stringify(typeof defaultDeptId !== 'undefined' ? defaultDeptId : null) %>;

function showToast(type, title, message) {
    const c = document.getElementById('toastContainer');
    const t = document.createElement('div');
    t.className = `toast ${type}`;
    t.innerHTML = `<div class="toast-content"><p class="toast-title">${title}</p><p class="toast-message">${message}</p></div>`;
    c.appendChild(t);
    setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 300); }, 4000);
}
document.addEventListener('DOMContentLoaded', function () {
    const searchInput = document.getElementById('searchInput');
    const deptFilter = document.getElementById('deptFilter');
    const cards = Array.from(document.querySelectorAll('.faculty-card'));
    const emptyState = document.getElementById('emptyState');
    const pager = document.getElementById('facPager');
    const pagerInfo = document.getElementById('facPagerInfo');
    const prevBtn = document.getElementById('facPrev');
    const nextBtn = document.getElementById('facNext');

    const PER_PAGE = 12;
    let page = 1;
    let matches = cards;

    // Filtering decides which cards qualify; paging decides how many of those are
    // on screen. Keeping the two separate is what lets the filters behave exactly
    // as they did before — the pager only ever narrows what already matched.
    function applyFilters() {
        const dept = deptFilter.value;
        const query = searchInput.value.toLowerCase().trim();

        matches = cards.filter(card =>
            (dept === 'all' || card.dataset.dept === dept) &&
            (!query || card.dataset.name.includes(query) || card.dataset.spec.includes(query))
        );

        page = 1;   // a changed filter always starts from the first page
        renderPage();
    }

    function renderPage() {
        const pages = Math.max(1, Math.ceil(matches.length / PER_PAGE));
        if (page > pages) page = pages;

        const start = (page - 1) * PER_PAGE;
        const shown = matches.slice(start, start + PER_PAGE);

        cards.forEach(card => { card.style.display = 'none'; });
        shown.forEach(card => { card.style.display = ''; });

        emptyState.style.display = matches.length === 0 ? 'block' : 'none';

        pager.hidden = matches.length <= PER_PAGE;
        pagerInfo.textContent = matches.length
            ? 'Showing ' + (start + 1) + '–' + (start + shown.length) + ' of ' + matches.length + ' faculty'
            : '';
        prevBtn.disabled = page === 1;
        nextBtn.disabled = page === pages;
    }

    // Back to the top of the list on a page change — otherwise the next page
    // opens halfway down and looks like nothing happened.
    function scrollGridTop() {
        const grid = document.getElementById('facultyGrid');
        if (grid && grid.parentElement) grid.parentElement.scrollTop = 0;
    }

    prevBtn.addEventListener('click', function () {
        if (page > 1) { page--; renderPage(); scrollGridTop(); }
    });
    nextBtn.addEventListener('click', function () {
        if (page * PER_PAGE < matches.length) { page++; renderPage(); scrollGridTop(); }
    });

    searchInput.addEventListener('input', applyFilters);
    deptFilter.addEventListener('change', applyFilters);

    // Settings > "Start in my department" only picks the opening filter value.
    // Every department stays selectable and filtering works exactly as before.
    var preferred = window.STUDENT_DEFAULT_DEPT;
    if (preferred && deptFilter.querySelector('option[value="' + preferred + '"]')) {
        deptFilter.value = String(preferred);
    }

    applyFilters();
});

(function() {
    const params = new URLSearchParams(window.location.search);
    if (params.get('bookingError') === 'slotTaken') {
        showToast('error', 'Slot Unavailable', 'That consultation slot no longer exists. Please pick another available consultation slot of the faculty member.');
        window.history.replaceState({}, '', window.location.pathname);
    }
})();
</script>
