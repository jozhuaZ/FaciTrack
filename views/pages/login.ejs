<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FaciTrack - Login</title>
  <link rel="icon" href="/images/FaciTrack-logo.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=<%= Date.now() %>">
  <link rel="stylesheet" href="/css/login.css?v=<%= Date.now() %>">
</head>
<body>

<main class="login-main">

  <!-- Back to Home button -->
  <div class="login-back-wrapper">
    <a href="/" class="login-back">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
        stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"/>
        <polyline points="12 19 5 12 12 5"/>
      </svg>
      Back to Home
    </a>
  </div>

  <!-- Centered card -->
  <div class="login-container">
    <div class="login-card">

      <!-- CSPC Logo -->
      <div class="login-icon">
        <img src="/images/CSPC-logo.png" alt="CSPC Logo" style="width:100%;height:100%;object-fit:contain;">
      </div>

      <div class="login-header">
        <h1 class="login-title">Login</h1>
      </div>

      <form action="/login" method="POST" class="login-form" id="loginForm" novalidate>

        <!-- Email field -->
        <div class="form-group">
          <label for="email" class="form-label">Email / Username <span class="required">*</span></label>
          <input
            type="email"
            id="email"
            name="email"
            class="form-input <%= (error && error !== 'Please enter your password.') ? 'input-error' : '' %>"
            placeholder="Enter your email"
            autofocus>
          <!-- Client-side empty validation -->
          <span class="field-error" id="emailError">Email is required.</span>
          <!-- Server-side error -->
          <% if (error && error !== 'Please enter your password.') { %>
            <span class="field-error visible"><%= error %></span>
          <% } else { %>
            <span class="field-error" aria-hidden="true"></span>
          <% } %>
        </div>

        <!-- Password field -->
        <div class="form-group">
          <label for="password" class="form-label">Password <span class="required">*</span></label>
          <input
            type="password"
            id="password"
            name="password"
            class="form-input <%= (error === 'Please enter your password.') ? 'input-error' : '' %>"
            placeholder="Enter your password">
          <!-- Client-side empty validation -->
          <span class="field-error" id="passwordError">Password is required.</span>
          <!-- Server-side error -->
          <% if (error === 'Please enter your password.') { %>
            <span class="field-error visible"><%= error %></span>
          <% } else { %>
            <span class="field-error" aria-hidden="true"></span>
          <% } %>
        </div>

        <button type="submit" class="btn-login">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
            <polyline points="10 17 15 12 10 7"/>
            <line x1="15" y1="12" x2="3" y2="12"/>
          </svg>
          Sign In
        </button>
      </form>

      <script>
        document.getElementById('loginForm').addEventListener('submit', function(e) {
          var email    = document.getElementById('email');
          var password = document.getElementById('password');
          var emailErr = document.getElementById('emailError');
          var passErr  = document.getElementById('passwordError');
          var valid    = true;

          // Reset
          emailErr.classList.remove('visible');
          passErr.classList.remove('visible');
          email.classList.remove('input-error');
          password.classList.remove('input-error');

          if (!email.value.trim()) {
            emailErr.classList.add('visible');
            email.classList.add('input-error');
            valid = false;
          }

          if (!password.value.trim()) {
            passErr.classList.add('visible');
            password.classList.add('input-error');
            valid = false;
          }

          if (!valid) e.preventDefault();
        });

        // Clear error as user types
        document.getElementById('email').addEventListener('input', function() {
          document.getElementById('emailError').classList.remove('visible');
          this.classList.remove('input-error');
        });
        document.getElementById('password').addEventListener('input', function() {
          document.getElementById('passwordError').classList.remove('visible');
          this.classList.remove('input-error');
        });
      </script>

      <!-- Divider -->
      <div class="login-divider">OR</div>

      <!-- Student label -->
      <p class="login-section-label">STUDENT</p>

      <!-- Google sign-in — Google logo replaces icon -->
      <a href="/auth/google" class="btn-google-login">
        <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0;">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
        </svg>
        Sign in with CSPC Email
      </a>

    </div>
  </div>

</main>

</body>
</html>