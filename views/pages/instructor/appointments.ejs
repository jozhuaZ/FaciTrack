<script>
/* ── Generate Logs modal ── */
(function() {
    var genBtn    = document.getElementById('genLogsBtn');
    var modal     = document.getElementById('genLogsModal');
    var closeBtn  = document.getElementById('genLogsClose');
    var cancelBtn = document.getElementById('genLogsCancel');
    var exportBtn = document.getElementById('genLogsExport');
    var logStart  = document.getElementById('logStart');
    var logEnd    = document.getElementById('logEnd');
    var preview   = document.getElementById('logPreviewArea');

    function openModal() {
        var today = new Date();
        var first = new Date(today.getFullYear(), today.getMonth(), 1);
        logStart.valueAsDate = first;
        logEnd.valueAsDate   = today;
        updatePreview();
        modal.classList.add('show');
    }
    function closeModal() { modal.classList.remove('show'); }

    genBtn.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);
    cancelBtn.addEventListener('click', closeModal);
    logStart.addEventListener('change', updatePreview);
    logEnd.addEventListener('change', updatePreview);
    document.getElementById('logChkConfirmed').addEventListener('change', updatePreview);
    document.getElementById('logChkPending').addEventListener('change', updatePreview);
    document.getElementById('logChkDeclined').addEventListener('change', updatePreview);

    function getFiltered() {
        var s = logStart.value, e = logEnd.value;
        if (!s || !e) return [];
        var start = new Date(s), end = new Date(e);
        end.setHours(23,59,59);
        var chkC = document.getElementById('logChkConfirmed').checked;
        var chkP = document.getElementById('logChkPending').checked;
        var chkD = document.getElementById('logChkDeclined').checked;
        return (window.APT_DATA || []).filter(function(a) {
            if (a.status==='confirmed' && !chkC) return false;
            if (a.status==='pending'   && !chkP) return false;
            if (a.status==='declined'  && !chkD) return false;
            var d = new Date(a.date);
            return d >= start && d <= end;
        });
    }

    function updatePreview() {
        var apts = getFiltered();
        if (!apts.length) { preview.textContent = 'No appointments found for the selected range.'; return; }
        preview.innerHTML = apts.map(function(a) {
            return '<div style="padding:.375rem 0;border-bottom:1px solid #f1f5f9;">'
                + '<strong>' + a.studentName + '</strong> (' + a.studentId + ')&nbsp;&nbsp;'
                + '<span style="background:' + (a.status==='confirmed'?'#d1fae5':a.status==='pending'?'#fef3c7':'#fee2e2')
                + ';color:' + (a.status==='confirmed'?'#065f46':a.status==='pending'?'#78350f':'#7f1d1d')
                + ';padding:1px 6px;border-radius:4px;font-size:.7rem;font-weight:700;">' + a.status + '</span><br>'
                + a.date + ' · ' + a.time + ' · ' + (a.duration||'—') + '<br>'
                + '<span style="color:#64748b;">' + a.topic + '</span></div>';
        }).join('');
    }

    exportBtn.addEventListener('click', function() {
        var apts = getFiltered();
        if (!apts.length) { alert('No appointments to export.'); return; }
        var lines = ['CONSULTATION LOGS', '='.repeat(60), 'Generated: ' + new Date().toLocaleString(), ''];
        apts.forEach(function(a) {
            lines.push(a.date + ' | ' + a.time + ' | ' + a.status.toUpperCase());
            lines.push('  Student : ' + a.studentName + ' (' + a.studentId + ')');
            lines.push('  Topic   : ' + a.topic);
            lines.push('  Duration: ' + (a.duration||'—'));
            lines.push('');
        });
        lines.push('='.repeat(60));
        lines.push('Total: ' + apts.length + ' appointment(s)');
        var blob = new Blob([lines.join('\n')], { type: 'text/plain' });
        var url  = URL.createObjectURL(blob);
        var a    = document.createElement('a');
        a.href = url; a.download = 'consultation-logs.txt';
        document.body.appendChild(a); a.click();
        document.body.removeChild(a); URL.revokeObjectURL(url);
        closeModal();
    });
}());

// Blocking a date changes this list — reload once the modal is done
window.onUnavailabilityChanged = function () {
    window.location.reload();
};
</script>

