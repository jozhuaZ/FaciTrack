<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/instructor/dashboard.css?v=<%= Date.now() %>">
<link rel="stylesheet" href="/css/instructor/appointments.css?v=<%= Date.now() %>">

<div class="instructor-layout">
    <%- include('../../partials/instructor-sidebar', { activePage: 'appointments', pendingCount: appointments.filter(a => a.status === 'pending').length }) %>

    <main class="instructor-main">
        <div class="main-container">

            <!-- Page Header -->
            <div class="page-header">
                <div>
                    <h1 class="page-title">Appointments</h1>
                    <p class="page-subtitle">Review and respond to student appointment requests</p>
                </div>
                <div class="header-actions">
                    <% const pendingApts = appointments.filter(a => a.status === 'pending'); %>
                    <button class="btn-header-action apt-btn-approve-all" id="approveAllBtn"
                            <%= pendingApts.length ? '' : 'hidden' %>>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                        Approve All (<span id="approveAllCount"><%= pendingApts.length %></span>)
                    </button>
                    <%# Shown only when a confirmed consultation has actually ended;
                        the count is worked out client-side from endsAt. %>
                    <button class="btn-header-action apt-btn-complete-all" id="completeAllBtn" hidden>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        Complete All (<span id="completeAllCount">0</span>)
                    </button>
                    <button class="btn-header-action" id="btnAddEvent" title="Add your own event or task to this calendar">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="12" y1="14" x2="12" y2="18"/><line x1="10" y1="16" x2="14" y2="16"/></svg>
                        Add Event
                    </button>
                    <button class="btn-header-action" id="calSyncBtn" title="Pull the latest from your connected calendars">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>
                        Sync calendars
                    </button>
                    <button class="btn-header-action" id="genLogsBtn">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
                        Generate Logs
                    </button>
                </div>
            </div>

            <!-- Imported events waiting on a blocking decision.
                 A banner, not a modal: syncs run on a schedule, so there may be
                 nobody here when one lands. Until answered, nothing is blocked. -->
            <div class="cal-pending" id="calPendingBanner" hidden>
                <div class="cal-pending-head">
                    <%# A dropdown: the count and the bulk choices stay in view,
                        the per-event list opens on demand. A long import no
                        longer pushes the calendar below the fold. %>
                    <button type="button" class="cal-pending-toggle" id="calPendingToggle"
                            aria-expanded="false" aria-controls="calPendingList">
                        <svg class="cal-pending-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                        <span>
                            <span class="cal-pending-title">
                                <span id="calPendingCount">0</span> imported <span id="calPendingWord">events need</span> a decision
                            </span>
                            <span class="cal-pending-sub">
                                Should students be able to book over these? Until you choose, they stay bookable.
                            </span>
                        </span>
                    </button>
                    <div class="cal-pending-bulk">
                        <button type="button" id="calPendingBlockAll">Block all</button>
                        <button type="button" id="calPendingAllowAll">Allow all</button>
                    </div>
                </div>
                <ul class="cal-pending-list" id="calPendingList" hidden></ul>
            </div>

            <!-- Stats Bar -->
            <div class="apt-stats-bar">
                <div class="apt-stat-card">
                    <div class="apt-stat-icon total">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    </div>
                    <div>
                        <p class="apt-stat-num" id="aptStatTotal"><%= appointments.length %></p>
                        <p class="apt-stat-lbl">Total</p>
                    </div>
                </div>
                <div class="apt-stat-card">
                    <div class="apt-stat-icon pending">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    </div>
                    <div>
                        <p class="apt-stat-num" id="aptStatPending"><%= appointments.filter(a=>a.status==='pending').length %></p>
                        <p class="apt-stat-lbl">Pending</p>
                    </div>
                </div>
                <div class="apt-stat-card">
                    <div class="apt-stat-icon confirmed">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                    </div>
                    <div>
                        <p class="apt-stat-num" id="aptStatConfirmed"><%= appointments.filter(a=>a.status==='confirmed').length %></p>
                        <p class="apt-stat-lbl">Confirmed</p>
                    </div>
                </div>
                <div class="apt-stat-card">
                    <div class="apt-stat-icon declined">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                    </div>
                    <div>
                        <p class="apt-stat-num" id="aptStatDeclined"><%= appointments.filter(a=>a.status==='declined').length %></p>
                        <p class="apt-stat-lbl">Declined</p>
                    </div>
                </div>
            </div>

            <!-- Search & Filter Bar -->
            <div class="apt-filter-bar">
                <div class="apt-search-wrap">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input type="text" id="aptSearch" placeholder="Search by name, ID, or topic…" autocomplete="off">
                </div>
                <select class="apt-filter-select" id="aptStatusFilter">
                    <option value="all">All Statuses</option>
                    <option value="pending">Pending</option>
                    <option value="confirmed">Confirmed</option>
                    <option value="completed">Completed</option>
                    <option value="cancelled">Cancelled</option>
                    <option value="declined">Declined</option>
                    <option value="rescheduled">Rescheduled</option>
                </select>
                <%# Blocking a date affects these appointments, so the action belongs here too %>
                <button type="button" class="apt-btn-unavail" onclick="UnavailModal.open()">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/>
                        <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                        <line x1="9" y1="16" x2="15" y2="16"/>
                    </svg>
                    Mark Date Unavailable
                </button>
                <div class="apt-view-toggle">
                    <button class="apt-view-btn" data-view="list" title="List view">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                    </button>
                    <button class="apt-view-btn active" data-view="calendar" title="Calendar view">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    </button>
                </div>
            </div>

            <!--  CALENDAR VIEW (default)  -->
            <div id="aptCalView">
                <div class="apt-cal-wrap">
                    <div class="apt-cal-header">
                        <div class="apt-cal-nav">
                            <button class="apt-cal-nav-btn" id="aptCalPrev" title="Previous month">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                            </button>
                            <h3 class="apt-cal-month-title" id="aptCalTitle"></h3>
                            <button class="apt-cal-nav-btn" id="aptCalNext" title="Next month">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                            </button>
                            <button class="apt-cal-today-btn" id="aptCalToday">Today</button>
                        </div>
                    </div>
                    <div class="apt-cal-weekdays">
                        <div class="apt-cal-weekday">Sun</div>
                        <div class="apt-cal-weekday">Mon</div>
                        <div class="apt-cal-weekday">Tue</div>
                        <div class="apt-cal-weekday">Wed</div>
                        <div class="apt-cal-weekday">Thu</div>
                        <div class="apt-cal-weekday">Fri</div>
                        <div class="apt-cal-weekday">Sat</div>
                    </div>
                    <div class="apt-cal-grid" id="aptCalGrid"></div>
                    <div class="apt-cal-legend">
                        <div class="apt-legend-item"><span class="apt-legend-dot pending"></span>Pending</div>
                        <div class="apt-legend-item"><span class="apt-legend-dot confirmed"></span>Confirmed</div>
                        <div class="apt-legend-item"><span class="apt-legend-dot completed"></span>Completed</div>
                        <div class="apt-legend-item"><span class="apt-legend-dot declined"></span>Declined</div>
                        <div class="apt-legend-item"><span class="apt-legend-dot cancelled"></span>Cancelled</div>
                        <div class="apt-legend-item"><span class="apt-legend-dot rescheduled"></span>Rescheduled</div>
                    </div>
                </div>
            </div>

            <!--  LIST VIEW  -->
            <div id="aptListView" style="display:none;">
                <div class="apt-list-wrap">
                    <div class="apt-list-header">
                        <span class="apt-list-header-title">All Appointments</span>
                        <span class="apt-list-header-count" id="aptListHeaderCount"></span>
                    </div>
                    <div id="aptListInner" class="apt-list-inner"></div>
                    <div class="apt-pagination">
                        <span class="apt-pg-info" id="aptPgInfo"></span>
                        <div class="apt-pg-controls" id="aptPgCtrl"></div>
                    </div>
                </div>
            </div>

        </div><!-- /.main-container -->
    </main>
</div>

<!--  POPOVER (anchored near badge) -->
<div id="aptBackdrop"></div>
<div id="aptPopover" role="dialog" aria-label="Appointment details">
    <div class="pop-stripe" id="popStripe"></div>
    <div class="pop-head">
        <div class="pop-student">
            <span class="pop-name" id="popName">—</span>
            <span class="pop-id"   id="popId">—</span>
        </div>
        <div class="pop-head-right">
            <span class="pop-status-pill" id="popStatusPill">—</span>
            <button class="pop-close" id="popClose" aria-label="Close popover">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
    </div>
    <div class="pop-body">
        <div class="pop-row"><span class="pop-lbl">When</span><span class="pop-val" id="popWhen">—</span></div>
        <div class="pop-row"><span class="pop-lbl">Duration</span><span class="pop-val" id="popDuration">—</span></div>
        <div class="pop-divider"></div>
        <%# Only filled for an online consultation. The instructor had no way to
            see the link their own booking was given — not even to check one had
            been created. %>
        <div class="pop-row" id="popLinkRow" hidden>
          <span class="pop-lbl">Meeting link</span>
          <span class="pop-val pop-link-val">
            <a id="popLink" href="#" target="_blank" rel="noopener noreferrer">—</a>
            <button type="button" class="pop-link-copy" id="popLinkCopy">Copy</button>
          </span>
        </div>
        <div class="pop-row"><span class="pop-lbl">Topic</span><span class="pop-val" id="popTopic">—</span></div>
        <div class="pop-row"><span class="pop-lbl">Notes</span><span class="pop-val" id="popNotes">—</span></div>
    </div>
    <!-- Action buttons (pending only) -->
    <div class="pop-actions" id="popActions">
        <button class="pop-btn pop-btn-approve" id="popApprove">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Approve
        </button>
        <button class="pop-btn pop-btn-decline" id="popDeclineBtn">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            Decline
        </button>
    </div>
    <!-- Complete (confirmed + already ended), same rule as the list and day panel -->
    <div class="pop-actions" id="popCompleteActions" style="display:none">
        <button class="pop-btn pop-btn-complete" id="popComplete">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            Complete
        </button>
    </div>
    <!-- Inline decline reason panel -->
    <div class="pop-decline-panel" id="popDeclinePanel">
        <span class="pop-decline-lbl">Reason for declining</span>
        <textarea class="pop-decline-ta" id="popDeclineReason" placeholder="e.g. Schedule conflict, fully booked…" rows="3"></textarea>
        <label class="resched-check">
            <input type="checkbox" id="popReschedCheck">
            Reschedule instead of declining
        </label>
        <div id="popReschedContainer" style="display:none;"></div>
        <div class="pop-decline-footer">
            <button class="pop-decline-cancel" id="popDeclineCancel">Back</button>
            <button class="pop-decline-confirm" id="popDeclineConfirm">Decline &amp; Notify</button>
        </div>
    </div>
    <!-- Post-action feedback -->
    <div class="pop-resolved" id="popResolved">
        <div class="pop-resolved-icon" id="popResolvedIcon"></div>
        <span id="popResolvedMsg">Done</span>
    </div>
</div>

<!-- Toast container -->
<div class="toast-container" id="aptToastContainer"></div>

<!-- Approve All confirmation.
     Handles its own backdrop taps: a finished run has to refresh the page,
     so it opts out of the global handler in main.js. -->
<div class="modal-overlay" id="approveAllModal" data-backdrop-close="manual">
    <div class="modal-content" style="max-width:480px;">
        <div class="modal-header">
            <h3 class="modal-title">Approve all pending requests</h3>
            <button class="modal-close" id="approveAllClose">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="modal-body">
            <div id="approveAllPrompt">
                <p class="modal-description">
                    This confirms <strong id="approveAllTotal">0</strong> pending request<span id="approveAllPlural">s</span>
                    at once. Every student is notified, and the slots are locked in.
                </p>
                <ul class="apt-approve-list" id="approveAllList"></ul>
                <p class="apt-approve-warn">This cannot be undone once — you would have to cancel each one individually.</p>
            </div>
            <div id="approveAllResult" hidden></div>
        </div>
        <div class="modal-footer">
            <button class="btn-modal btn-cancel" id="approveAllCancel">Cancel</button>
            <button class="btn-modal btn-confirm-green" id="approveAllConfirm">Approve all</button>
        </div>
    </div>
</div>

<!-- Add / edit an event or task of the instructor's own.
     Manual backdrop close: a half-typed entry should not vanish on a stray click. -->
<div class="modal-overlay" id="eventModal" data-backdrop-close="manual">
    <div class="modal-content" style="max-width:480px;">
        <div class="modal-header">
            <h3 class="modal-title" id="eventModalTitle">Add to my calendar</h3>
            <button class="modal-close" id="eventClose">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="modal-body">
            <div class="ev-grid">
                <div class="ev-field">
                    <label class="modal-label" for="eventKind">Type</label>
                    <select class="modal-input" id="eventKind">
                        <option value="event">Event</option>
                        <option value="task">Task</option>
                    </select>
                </div>
                <div class="ev-field">
                    <label class="modal-label" for="eventDate">Date</label>
                    <input type="date" class="modal-input" id="eventDate">
                </div>
            </div>

            <div class="ev-field">
                <label class="modal-label" for="eventTitle">Title</label>
                <input type="text" class="modal-input" id="eventTitle" maxlength="200"
                       placeholder="Faculty meeting, thesis defence, grading…">
            </div>

            <label class="ev-check">
                <input type="checkbox" id="eventAllDay">
                <span>All day</span>
            </label>

            <div class="ev-grid" id="eventTimeRow">
                <div class="ev-field">
                    <label class="modal-label" for="eventStart">Start</label>
                    <input type="time" class="modal-input" id="eventStart" step="1800">
                </div>
                <div class="ev-field">
                    <label class="modal-label" for="eventEnd">End</label>
                    <input type="time" class="modal-input" id="eventEnd" step="1800">
                </div>
            </div>

            <div class="ev-field">
                <label class="modal-label" for="eventNotes">Notes <span class="ev-optional">(optional)</span></label>
                <textarea class="modal-input" id="eventNotes" rows="2" maxlength="500"></textarea>
            </div>

            <label class="ev-check">
                <input type="checkbox" id="eventBlocks" checked>
                <span>Block consultations during this time</span>
            </label>
            <p class="ev-hint" id="eventBlocksHint"></p>

            <div class="ev-conflicts" id="eventConflicts" hidden></div>
            <p class="ev-error" id="eventError" hidden></p>
        </div>
        <div class="modal-footer">
            <button class="btn-modal btn-danger-soft" id="eventDelete" hidden>Delete</button>
            <button class="btn-modal btn-cancel" id="eventCancel">Cancel</button>
            <button class="btn-modal btn-confirm-green" id="eventSave">Save</button>
        </div>
    </div>
</div>

<!-- Complete All confirmation. Same manual-backdrop reasoning as Approve All. -->
<div class="modal-overlay" id="completeAllModal" data-backdrop-close="manual">
    <div class="modal-content" style="max-width:480px;">
        <div class="modal-header">
            <h3 class="modal-title">Complete finished consultations</h3>
            <button class="modal-close" id="completeAllClose">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="modal-body">
            <div id="completeAllPrompt">
                <p class="modal-description">
                    This closes out <strong id="completeAllTotal">0</strong> consultation<span id="completeAllPlural">s</span>
                    whose time has already passed. Anything still to come is left alone.
                </p>
                <ul class="apt-approve-list" id="completeAllList"></ul>
                <p class="apt-approve-warn">This cannot be undone in bulk.</p>
            </div>
            <div id="completeAllResult" hidden></div>
        </div>
        <div class="modal-footer">
            <button class="btn-modal btn-cancel" id="completeAllCancel">Cancel</button>
            <button class="btn-modal btn-confirm-green" id="completeAllConfirm">Complete all</button>
        </div>
    </div>
</div>

<!-- Generate Logs Modal -->
<div class="modal-overlay" id="genLogsModal">
    <div class="modal-content" style="max-width:600px;">
        <div class="modal-header">
            <h3 class="modal-title">Generate Consultation Logs</h3>
            <button class="modal-close" id="genLogsClose">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
        </div>
        <div class="modal-body">
            <p class="modal-description">Export appointment records for reporting and documentation.</p>
            <label class="modal-label">Date Range</label>
            <div style="display:flex;gap:.75rem;align-items:center;margin-bottom:1rem;">
                <input type="date" id="logStart" class="modal-textarea" style="height:auto;padding:.6rem;">
                <span style="color:#94a3b8;font-weight:600;">to</span>
                <input type="date" id="logEnd" class="modal-textarea" style="height:auto;padding:.6rem;">
            </div>
            <label class="modal-label">Status to Include</label>
            <div style="display:flex;gap:.625rem;margin-bottom:1rem;flex-wrap:wrap;">
                <label style="display:flex;align-items:center;gap:.4rem;font-size:.875rem;cursor:pointer;"><input type="checkbox" id="logChkConfirmed" checked> Confirmed</label>
                <label style="display:flex;align-items:center;gap:.4rem;font-size:.875rem;cursor:pointer;"><input type="checkbox" id="logChkPending"> Pending</label>
                <label style="display:flex;align-items:center;gap:.4rem;font-size:.875rem;cursor:pointer;"><input type="checkbox" id="logChkDeclined"> Declined</label>
            </div>
            <div id="logPreviewArea" style="max-height:200px;overflow-y:auto;border:1px solid #e5e7eb;border-radius:8px;padding:.75rem;font-size:.8125rem;color:#374151;background:#f8fafc;">
                Select a date range to preview logs.
