<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/instructor/dashboard.css?v=<%= Date.now() %>">
<style>
.report-tabs {
    display: flex;
    gap: 0;
    margin-bottom: 2rem;
    border-bottom: 2px solid var(--gray-200);
    flex-wrap: wrap;
}
.report-tab {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    background: transparent;
    border: none;
    border-bottom: 3px solid transparent;
    color: var(--gray-500);
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    margin-bottom: -2px;
    border-radius: 8px 8px 0 0;
    font-family: var(--font-body);
    transition: color 0.15s, background 0.15s;
}
.report-tab:hover {
    background: rgba(10,61,98,.04);
    color: var(--primary-blue);
}
.report-tab.active {
    color: var(--primary-blue);
    border-bottom-color: var(--primary-blue);
    background: rgba(10,61,98,.04);
}
.report-section { display: none; }
.report-section.active { display: block; }
.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    text-align: center;
}
.empty-state svg { margin-bottom: 1rem; opacity: 0.35; }
.empty-state p { font-size: 0.9375rem; font-weight: 500; margin: 0; color: var(--gray-500); }
@media print {
    @page { size: A4 portrait; margin: 1.5cm }
    * { box-sizing: border-box !important; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important }
    html, body { width: 100% !important; height: auto !important; margin: 0 !important; padding: 0 !important; background: #fff !important; color: #000 !important; font-family: 'Arial','Helvetica',sans-serif !important }
    body.print-mode .report-preview:not(.print-only) { display: none !important }
    .instructor-layout, .instructor-main, .main-container { width: 100% !important; margin: 0 !important; padding: 0 !important; display: block !important; overflow: visible !important }
    .instructor-sidebar, .sidebar-footer, .header-actions, .toast-container, .page-header, .filter-bar-container, .fb-bar, .report-tabs, .stats-overview { display: none !important }
    .content-card { box-shadow: none !important; border: none !important; border-radius: 0 !important; background: #fff !important; margin: 0 !important; padding: 0 !important }
    .card-header, .card-body { padding: 0 !important; margin: 0 !important; background: transparent !important; border: none !important; box-shadow: none !important }
    .report-preview { display: block !important; margin: 0 !important; padding: 0 !important; width: 100% !important }
    .report-section { display: block !important }
    .pagination-bar, button { display: none !important }
    .data-table { margin: 0 !important; padding: 0 !important; width: 100% !important; border-collapse: collapse !important; font-family: 'Arial',sans-serif !important; font-size: 8.5pt !important }
    .data-table th { background: #e8e8e8 !important; border: 1pt solid #000 !important; padding: 0.18cm 0.2cm !important; font-weight: 700 !important; text-align: left !important }
    .data-table td { border: 1pt solid #000 !important; padding: 0.15cm 0.2cm !important; text-align: left !important; vertical-align: top !important }
    .data-table tr:nth-child(even) td { background: #f5f5f5 !important }
    .table-badge { background: none !important; border: none !important; padding: 0 !important; font-weight: 700 !important; font-size: 8pt !important; color: #000 !important }
    .report-header-block { display: block !important; width: 100% !important; border-bottom: 2.5pt solid #000 !important; padding: 0 0 0.3cm 0 !important; margin: 0 0 0.4cm 0 !important; position: relative !important }
    .report-header-block > * { display: none !important }
    .report-header-block > .print-header-inner { display: flex !important; align-items: center !important; gap: 0.4cm !important; padding-top: 0.2cm !important }
    .report-header-block > .print-header-inner > img { width: 1.4cm !important; height: 1.4cm !important; object-fit: contain !important; flex-shrink: 0 !important; display: block !important }
    .report-header-block > .print-header-inner > .print-header-text { flex: 1 !important; text-align: center !important; display: block !important }
    .print-header-inner .ph-republic { display: block !important; font-size: 7.5pt !important; font-style: italic !important; text-align: center !important; margin: 0 !important }
    .print-header-inner .ph-institution { display: block !important; font-size: 13pt !important; font-weight: 900 !important; text-transform: uppercase !important; text-align: center !important }
    .print-header-inner .ph-address { display: block !important; font-size: 8pt !important; text-align: center !important }
    .print-header-inner .ph-title { display: block !important; font-size: 13pt !important; font-weight: 800 !important; text-transform: uppercase !important; text-align: center !important; text-decoration: underline !important }
    .print-header-inner .ph-subtitle { display: block !important; font-size: 9pt !important; font-weight: 600 !important; text-align: center !important }
}
</style>

<div class="instructor-layout">
    <%- include('../../partials/instructor-sidebar', { activePage: 'reports', pendingCount: typeof pendingCount !== 'undefined' ? pendingCount : 0 }) %>
    <main class="instructor-main">
        <div class="main-container">

            <div class="page-header">
                <div>
                    <h1 class="page-title">Reports</h1>
                    <p class="page-subtitle">Consultation appointment logs and schedule records &mdash; <%= instructor.name %></p>
                </div>
            </div>

            <!-- Report Tabs -->
            <div class="report-tabs">
                <button class="report-tab active" onclick="switchReport('appointment-logs', this)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                    Appointment Logs
                </button>
            </div>

            <!-- ===== APPOINTMENT LOGS ===== -->
            <div id="section-appointment-logs" class="report-section active">
                <div class="content-card" style="overflow:visible">
                    <div class="card-body">
                        <div class="report-preview">
                            <div class="report-header-block" style="display:flex;align-items:flex-start;gap:1rem;padding:1.25rem 1.5rem;border-bottom:3px solid #1a1a1a;position:relative">
                                <img src="/images/CSPC-logo.png" alt="CSPC" style="width:64px;height:64px;object-fit:contain;flex-shrink:0" onerror="this.style.display='none'">
                                <div>
                                    <p class="report-republic">Republic of the Philippines</p>
                                    <p class="report-institution">Camarines Sur Polytechnic Colleges</p>
                                    <p class="report-college">College of Computer Studies</p>
                                    <h4 class="report-title-block">Appointment Logs Report</h4>
                                    <p class="report-subtitle" style="margin:0.25rem 0 0;font-size:0.8125rem;color:#555">Instructor Consultation Records &mdash; <%= instructor.name %></p>
                                </div>
                                <div style="margin-left:auto">
                                    <button class="btn-header-action primary" style="height:36px;padding:0 1rem;font-size:.75rem;display:flex;align-items:center;gap:.4rem" onclick="preparePrintReport(this)">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                                        Export/Print
                                    </button>
                                </div>
                            </div>
                            <%- include('../../partials/filter-bar', {
                                filterId: 'log',
                                searchPlaceholder: 'Search student or topic...',
                                filterSections: [
                                    { label: 'By Period', key: 'period', type: 'buttons',
                                      items: [{ value:'all', label:'All Records' }, { value:'week', label:'This Week' }, { value:'month', label:'This Month' }] },
                                    { label: 'By Status', key: 'status', type: 'buttons',
                                      items: [{ value:'all', label:'All' }, { value:'pending', label:'Pending' }, { value:'confirmed', label:'Confirmed' }, { value:'declined', label:'Declined' }, { value:'completed', label:'Completed' }, { value:'cancelled', label:'Cancelled' }] }
                                ]
                            }) %>
                            <div style="padding:0 1.5rem 1.5rem">
                                <div style="overflow-x:auto;margin-top:1rem">
                                    <table class="data-table">
                                        <thead>
                                            <tr>
                                                <th>Student</th>
                                                <th>Date</th>
                                                <th>Time</th>
                                                <th>Topic</th>
                                                <th>Mode</th>
                                                <th>Status</th>
                                            </tr>
                                        </thead>
                                        <tbody id="logReportBody"></tbody>
                                    </table>
                                </div>
                                <div class="pagination-bar" id="logReportPagBar" style="display:none">
                                    <span class="page-info" id="logReportPageInfo"></span>
                                    <div class="pagination-controls">
                                        <button class="btn-page" id="logReportPrev">Prev</button>
                                        <button class="btn-page" id="logReportNext">Next</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </main>
</div>

<div class="toast-container" id="toastContainer"></div>
<%- include('../../partials/footer') %>
<%- include('../../partials/script') %>

<script>
// ===== Tab Switching =====
function switchReport(name, btn) {
    document.querySelectorAll('.report-section').forEach(function(s) { s.classList.remove('active'); });
    document.querySelectorAll('.report-tab').forEach(function(t) { t.classList.remove('active'); });
    var section = document.getElementById('section-' + name);
    if (section) section.classList.add('active');
    if (btn) btn.classList.add('active');
}

// ===== Data =====
var ALL_APPOINTMENTS = <%- JSON.stringify(typeof appointments !== 'undefined' ? appointments : []) %>;
var PAGE = 20;

// ===== Helpers =====
function esc(s) {
    return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function emptyRow(cols, msg) {
    return '<tr><td colspan="' + cols + '">'
        + '<div class="empty-state">'
        + '<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>'
        + '<p>' + esc(msg) + '</p>'
        + '</div></td></tr>';
}

function badgeHtml(status) {
    var map = { pending:'pending', confirmed:'confirmed', declined:'declined', completed:'presence', cancelled:'declined', rescheduled:'workload', Available:'confirmed', Booked:'workload' };
    return '<span class="table-badge ' + (map[status] || 'pending') + '">' + esc(status) + '</span>';
}

function renderPagination(idPrev, idNext, idInfo, idBar, page, total) {
    var pages = Math.max(1, Math.ceil(total / PAGE));
    var bar  = document.getElementById(idBar);
    var info = document.getElementById(idInfo);
    var prev = document.getElementById(idPrev);
    var next = document.getElementById(idNext);
    if (!bar) return;
    if (total === 0) { bar.style.display = 'none'; return; }
    bar.style.display = 'flex';
    var start = (page - 1) * PAGE + 1;
    var end   = Math.min(page * PAGE, total);
    if (info) info.textContent = 'Showing ' + start + '-' + end + ' of ' + total;
    if (prev) prev.disabled = (page <= 1);
    if (next) next.disabled = (page >= pages);
}

// ===== Appointment Logs =====
var logPage = 1, logPeriod = 'all', logStatus = 'all', logSearch = '';

function filterLog() {
    var rows = ALL_APPOINTMENTS.slice();
    if (logStatus !== 'all') rows = rows.filter(function(a) { return a.status === logStatus; });
    if (logSearch) {
        var q = logSearch.toLowerCase();
        rows = rows.filter(function(a) {
            return (a.studentName || '').toLowerCase().indexOf(q) >= 0
                || (a.topic || '').toLowerCase().indexOf(q) >= 0;
        });
    }
    return rows;
}

function renderLogTable() {
    var tbody = document.getElementById('logReportBody');
    if (!tbody) return;
    var rows = filterLog();
    if (rows.length === 0) {
        tbody.innerHTML = emptyRow(6, 'No Appointment Log records found');
        renderPagination('logReportPrev', 'logReportNext', 'logReportPageInfo', 'logReportPagBar', logPage, 0);
        return;
    }
    var pages = Math.max(1, Math.ceil(rows.length / PAGE));
    if (logPage > pages) logPage = pages;
    var start = (logPage - 1) * PAGE;
    tbody.innerHTML = rows.slice(start, start + PAGE).map(function(a) {
        return '<tr>'
            + '<td><div style="display:flex;align-items:center;gap:.5rem">'
            + '<div class="apt-avatar-xs" style="width:32px;height:32px;font-size:.625rem;flex-shrink:0">' + esc((a.studentName||'?').split(' ').map(function(n){return n[0]||'';}).join('').slice(0,2).toUpperCase()) + '</div>'
            + '<span style="font-weight:600;font-size:.875rem">' + esc(a.studentName) + '</span></div></td>'
            + '<td style="font-size:.875rem;white-space:nowrap">' + esc(a.date) + '</td>'
            + '<td style="font-size:.875rem;white-space:nowrap">' + esc(a.time) + '</td>'
            + '<td style="font-size:.875rem;max-width:200px;white-space:normal">' + esc(a.topic) + '</td>'
            + '<td style="font-size:.875rem">' + esc(a.mode || '—') + '</td>'
            + '<td>' + badgeHtml(a.status) + '</td>'
            + '</tr>';
    }).join('');
    renderPagination('logReportPrev', 'logReportNext', 'logReportPageInfo', 'logReportPagBar', logPage, rows.length);
}

document.getElementById('logReportPrev').addEventListener('click', function() { if (logPage > 1) { logPage--; renderLogTable(); } });
document.getElementById('logReportNext').addEventListener('click', function() { if (logPage < Math.ceil(filterLog().length / PAGE)) { logPage++; renderLogTable(); } });

// ===== Filter-bar events =====
document.addEventListener('fbChange', function(e) {
    if (!e.detail) return;
    var id = e.detail.filterId, key = e.detail.section, val = e.detail.value;
    if (id === 'log') {
        if (key === 'status') { logStatus = val; logPage = 1; renderLogTable(); }
        if (key === 'period') { logPeriod = val; logPage = 1; renderLogTable(); }
    }
});
document.addEventListener('fbSearch', function(e) {
    if (!e.detail) return;
    if (e.detail.filterId === 'log') { logSearch = e.detail.value; logPage = 1; renderLogTable(); }
});

// ===== Initial Render =====
renderLogTable();

// ===== Print Helper =====
function preparePrintReport(btn) {
    var preview = btn.closest('.report-preview');
    if (!preview) return;
    preview.querySelectorAll('.report-header-block').forEach(function(hdr) {
        var existing = hdr.querySelector('.print-header-inner');
        if (existing) existing.remove();
        var titleEl    = hdr.querySelector('.report-title-block');
        var subtitleEl = hdr.querySelector('.report-subtitle');
        var imgEl      = hdr.querySelector('img');
        var title    = titleEl    ? titleEl.textContent.trim() : '';
        var subtitle = subtitleEl ? subtitleEl.textContent.trim() : '';
        var imgSrc   = imgEl      ? imgEl.src : '/images/CSPC-logo.png';
        var inner = document.createElement('div');
        inner.className = 'print-header-inner';
        inner.innerHTML =
            '<img src="' + imgSrc + '" alt="CSPC Logo">'
            + '<div class="print-header-text">'
            + '<span class="ph-republic">Republic of the Philippines</span>'
            + '<span class="ph-institution">Camarines Sur Polytechnic Colleges</span>'
            + '<span class="ph-address">Nabua, Camarines Sur</span>'
            + '<span class="ph-title">' + title + '</span>'
            + '<span class="ph-subtitle">' + subtitle + '</span>'
            + '</div>';
        hdr.appendChild(inner);
    });
    document.body.classList.add('print-mode');
    preview.classList.add('print-only');
    setTimeout(function() {
        window.print();
        setTimeout(function() {
            preview.classList.remove('print-only');
            document.body.classList.remove('print-mode');
            preview.querySelectorAll('.print-header-inner').forEach(function(el) { el.remove(); });
        }, 500);
    }, 50);
}
</script>
