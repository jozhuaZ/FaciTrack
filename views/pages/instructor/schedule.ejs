<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/instructor/dashboard.css?v=<%= Date.now() %>">
<link rel="stylesheet" href="/css/instructor/schedule.css?v=<%= Date.now() %>">

<div class="instructor-layout">
  <%- include('../../partials/instructor-sidebar', { activePage: 'schedule' }) %>
  <main class="instructor-main">
    <div class="main-container">
      <div class="page-header">
        <div>
          <h1 class="page-title">Consultation Schedule</h1>
          <p class="page-subtitle">Manage your consultation availability</p>
        </div>
      </div>
      <!-- ─── Unavailability Banner ─── -->
      <div id="unavailBanner" style="display:none;margin-bottom:1rem;padding:.75rem 1rem;background:#fef9ec;border:1px solid #fde68a;border-radius:10px;align-items:center;gap:.6rem;font-size:.84rem;color:#92400e;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <span id="unavailBannerText"></span>
      </div>

      <!-- ─── Mark Unavailable Card ─── -->
      <div class="gcal-wrap" style="margin-bottom:1.25rem;border-color:#fee2e2;background:linear-gradient(135deg,#fffdfd 0%,#fff7f7 100%);">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.75rem;">
          <div>
            <h3 style="font-size:.95rem;font-weight:700;color:#111827;margin:0 0 .25rem;display:flex;align-items:center;gap:.45rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="9" y1="16" x2="15" y2="16"/></svg>
              Block a Day
            </h3>
            <p style="font-size:.78rem;color:#6b7280;margin:0;line-height:1.5;">Choose a date to pause bookings. Existing appointments will be cancelled and students will be notified to reschedule.</p>
          </div>
          <button type="button" onclick="openUnavailModal()" class="btn-modal btn-confirm" style="background:#dc2626;display:inline-flex;align-items:center;gap:.45rem;white-space:nowrap;">
            Set Unavailable Day
          </button>
        </div>
        <div id="unavailList" style="margin-top:1rem;display:none;">
          <p style="font-size:.72rem;font-weight:700;color:#6b7280;text-transform:uppercase;letter-spacing:.04em;margin:0 0 .6rem;">Blocked Days</p>
          <div id="unavailItems" style="display:flex;flex-wrap:wrap;gap:.5rem;"></div>
        </div>
      </div>

      <div class="gcal-wrap">
        <div class="gcal-top"><h3 class="gcal-title">Select an appointment time</h3></div>
        <div class="gcal-body">
          <div class="mini-cal">
            <div class="mini-head"><span class="mini-month" id="miniMonthTitle"></span></div>
            <div class="mini-grid" id="miniCalGrid"></div>
          </div>
          <div style="flex:1;min-width:auto;overflow-x:auto;overflow-y:visible;display:flex;flex-direction:column;" class="gcal-content-wrapper">
            <div class="week-strip-wrapper">
              <div class="week-strip" id="weekStrip"></div>
            </div>
            <div class="week-empty" id="weekEmpty" style="display:none">No availability during these days<br><a href="#" id="jumpBookable">Jump to the next bookable date</a></div>
            <!-- Day slots panel   shown when a day card background is clicked -->
            <div id="daySlotPanel">
              <div class="dsp-header">
                <span class="dsp-title" id="dspTitle">Slots</span>
                <button class="dsp-close" id="dspClose" title="Close">&times;</button>
              </div>
              <div id="dspBody"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- ─── Mark Unavailable Modal ─── -->
<div class="modal-overlay" id="unavailModal" onclick="if(event.target===this){closeUnavailModal();}">
  <div class="modal-content" style="max-width:460px;">
    <div class="modal-header">
      <h3 class="modal-title">Mark Date as Unavailable</h3>
      <button class="modal-close" type="button" onclick="closeUnavailModal();">&times;</button>
    </div>
    <div class="modal-body">
      <p style="font-size:.82rem;color:#6b7280;margin:0 0 1.1rem;line-height:1.55;">
        Pick a date to pause bookings for that day. Existing appointments will be cancelled and students will be notified to reschedule.
      </p>
      <div class="slot-form-group">
        <label class="slot-form-label" for="unavailDateInput">Date <span style="color:#dc2626">*</span></label>
        <input type="date" id="unavailDateInput" class="slot-form-input" style="text-align:left;">
        <p id="unavailDateError" style="display:none;font-size:.75rem;color:#dc2626;margin:.3rem 0 0;"></p>
      </div>
      <div class="slot-form-group">
        <label class="slot-form-label" for="unavailReasonInput">Reason <span style="font-weight:400;color:var(--gray-400)">(optional)</span></label>
        <input type="text" id="unavailReasonInput" class="slot-form-input" placeholder="e.g. Leave, meeting" maxlength="300">
      </div>
      <div id="unavailAffected" style="display:none;padding:.65rem .85rem;background:#fef9ec;border:1px solid #fde68a;border-radius:8px;font-size:.8rem;color:#92400e;margin-top:.25rem;">
        <strong id="unavailAffectedCount">0</strong> appointment(s) will be cancelled on this date.
      </div>
      <div id="unavailSuccessMsg" style="display:none;padding:.65rem .85rem;background:#f0fdf4;border:1px solid #bbf7d0;border-radius:8px;font-size:.8rem;color:#166534;margin-top:.5rem;"></div>
    </div>
    <div class="modal-footer">
      <button class="btn-modal btn-cancel" type="button" onclick="closeUnavailModal();">Cancel</button>
      <button class="btn-modal btn-confirm" type="button" id="unavailConfirmBtn" onclick="confirmUnavailability()" style="background:#dc2626;">Set Unavailable Day</button>
    </div>
  </div>
</div>

<div class="modal-overlay" id="slotModal">
  <div class="modal-content">
    <div class="modal-header"><h3 class="modal-title" id="slotModalTitle">Add Consultation Slot</h3><button class="modal-close" id="closeSlotModal">&times;</button></div>
    <div class="modal-body">
      <input type="hidden" id="slotDay">
      <input type="hidden" id="slotEditIdx" value="-1">
      <div class="slot-conflict-warn" id="slotConflictWarn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        <span id="slotConflictText">This time overlaps an existing slot on the same day.</span>
      </div>
      <div class="slot-form-row">
        <div class="slot-form-group">
          <label class="slot-form-label">Start Time</label>
          <div class="time-picker-wrapper" id="startTimePicker">
            <div class="time-segment">
              <div class="time-wheel" id="startHourWheel" data-type="start" data-unit="hour"></div>
            </div>
            <span class="time-separator">:</span>
            <div class="time-segment">
              <div class="time-wheel" id="startMinuteWheel" data-type="start" data-unit="minute"></div>
            </div>
            <div class="time-period">
              <button type="button" class="period-btn active" id="startAM" onclick="setPeriod('start','AM')">AM</button>
              <button type="button" class="period-btn" id="startPM" onclick="setPeriod('start','PM')">PM</button>
            </div>
          </div>
        </div>
        <div class="slot-form-group">
          <label class="slot-form-label">End Time</label>
          <div class="time-picker-wrapper" id="endTimePicker">
            <div class="time-segment">
              <div class="time-wheel" id="endHourWheel" data-type="end" data-unit="hour"></div>
            </div>
            <span class="time-separator">:</span>
            <div class="time-segment">
              <div class="time-wheel" id="endMinuteWheel" data-type="end" data-unit="minute"></div>
            </div>
            <div class="time-period">
              <button type="button" class="period-btn active" id="endAM" onclick="setPeriod('end','AM')">AM</button>
              <button type="button" class="period-btn" id="endPM" onclick="setPeriod('end','PM')">PM</button>
            </div>
