// ── Load blocked dates from backend on page load ──
function loadUnavailDates() {
  fetch('/instructor/unavailability/list')
    .then(r => r.json())
    .then(data => {
      if (!data.success) return;
      unavailDates = {};
      (data.unavailableDates || []).forEach(function(rec) {
        unavailDates[rec.date] = rec;
      });
      renderUnavailList();
      // Re-render week strip so blocked days show the red overlay
      renderWeekStrip();
    })
    .catch(function(err) { console.error('[Unavailability] Load error:', err); });
}

// ── Render the blocked dates list in the card ──
function renderUnavailList() {
  var list  = document.getElementById('unavailList');
  var items = document.getElementById('unavailItems');
  var keys  = Object.keys(unavailDates).sort();
  if (!keys.length) { list.style.display = 'none'; return; }
  list.style.display = 'block';
  items.innerHTML = '';
  keys.forEach(function(key) {
    var rec = unavailDates[key];
    var label = new Date(key + 'T00:00:00').toLocaleDateString('en-PH', { weekday:'short', month:'short', day:'numeric', year:'numeric' });
    var chip = document.createElement('div');
    chip.style.cssText = 'display:inline-flex;align-items:center;gap:.4rem;padding:.35rem .65rem .35rem .75rem;background:#fef2f2;border:1px solid #fecaca;border-radius:20px;font-size:.75rem;color:#dc2626;font-weight:600;';
    chip.innerHTML =
      '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="9" y1="16" x2="15" y2="16"/></svg>' +
      '<span>' + esc(label) + (rec.reason ? ' – ' + esc(rec.reason.substring(0,35) + (rec.reason.length > 35 ? '…' : '')) : '') + '</span>' +
      '<button onclick="removeUnavailDate(\'' + key + '\')" title="Remove block" style="background:none;border:none;cursor:pointer;padding:0;display:flex;color:#dc2626;margin-left:.2rem;">' +
        '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>' +
      '</button>';
    items.appendChild(chip);
  });
}

// ── Check if selected week contains unavailable days and show a banner ──
function checkWeekUnavailBanner() {
  var banner = document.getElementById('unavailBanner');
  var bannerText = document.getElementById('unavailBannerText');
  // Find days in current week view that are blocked
  var blocked = [];
  for (var d = 0; d < 7; d++) {
    var date = new Date(selectedDate);
    var diff = d - date.getDay();
    var candidate = new Date(date);
    candidate.setDate(date.getDate() + diff - date.getDay() + d);
    var key = toDateKeyJS(candidate);
    if (unavailDates[key]) {
      var lbl = candidate.toLocaleDateString('en-PH', { weekday:'short', month:'short', day:'numeric' });
      blocked.push(lbl + (unavailDates[key].reason ? ' (' + unavailDates[key].reason.substring(0,30) + ')' : ''));
    }
  }
  if (blocked.length) {
    bannerText.textContent = 'Unavailable this week: ' + blocked.join('; ');
    banner.style.display = 'flex';
  } else {
    banner.style.display = 'none';
  }
}

function toDateKeyJS(d) {
    if (typeof d === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(d)) {
        return d; 
    }
    var y = d.getFullYear();
    var m = String(d.getMonth() + 1).padStart(2, '0');
    var day = String(d.getDate()).padStart(2, '0');
    return y + '-' + m + '-' + day;
}

// ── Open the modal ──
function openUnavailModal() {
  document.getElementById('unavailDateError').style.display = 'none';
  document.getElementById('unavailAffected').style.display = 'none';
  document.getElementById('unavailSuccessMsg').style.display = 'none';
  document.getElementById('unavailConfirmBtn').disabled = false;
  document.getElementById('unavailConfirmBtn').textContent = 'Block Date & Cancel Appointments';
  // Pre-fill with selected date if available
  if (selectedDate) {
    document.getElementById('unavailDateInput').value = toDateKeyJS(selectedDate);
    previewAffectedBookings();
  } else {
    document.getElementById('unavailDateInput').value = '';
  }
  document.getElementById('unavailReasonInput').value = '';
  document.getElementById('unavailModal').classList.add('show');
}

function closeUnavailModal() {
  document.getElementById('unavailModal').classList.remove('show');
}

// Preview how many appointments will be affected (client-side, using local slots data)
function previewAffectedBookings() {
  var dateVal = document.getElementById('unavailDateInput').value;
  var err = document.getElementById('unavailDateError');
  var affected = document.getElementById('unavailAffected');
  var count = document.getElementById('unavailAffectedCount');
  err.style.display = 'none';

  if (!dateVal) { affected.style.display = 'none'; return; }

  var today0 = new Date(); today0.setHours(0,0,0,0);
  var chosen = new Date(dateVal + 'T00:00:00');
  if (chosen < today0) {
    err.textContent = 'Cannot mark a past date as unavailable.';
    err.style.display = 'block';
    affected.style.display = 'none';
    return;
  }

  // Ask backend how many bookings exist for that date
  fetch('/instructor/unavailability/check/' + dateVal)
    .then(r => r.json())
    .then(data => {
      // We show the affected warning regardless (0 is still valid)
      affected.style.display = 'block';
    })
    .catch(function() { affected.style.display = 'block'; });

  // Show a generic count hint (actual count comes from backend on confirm)
  count.textContent = '?';
  affected.style.display = 'block';
}

document.getElementById('unavailDateInput').addEventListener('change', previewAffectedBookings);

// ── Submit the block ──
function confirmUnavailability() {
  var dateVal   = document.getElementById('unavailDateInput').value;
  var reasonVal = document.getElementById('unavailReasonInput').value.trim();
  var err       = document.getElementById('unavailDateError');
  var btn       = document.getElementById('unavailConfirmBtn');
  var successEl = document.getElementById('unavailSuccessMsg');
  var affectedEl= document.getElementById('unavailAffected');
  var countEl   = document.getElementById('unavailAffectedCount');

  err.style.display = 'none';
  successEl.style.display = 'none';

  if (!dateVal) {
    err.textContent = 'Please select a date.';
    err.style.display = 'block';
    return;
  }

  var today0 = new Date(); today0.setHours(0,0,0,0);
  var chosen = new Date(dateVal + 'T00:00:00');
  if (chosen < today0) {
    err.textContent = 'Cannot mark a past date as unavailable.';
    err.style.display = 'block';
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Processing…';

  fetch('/instructor/unavailability/set', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ date: dateVal, reason: reasonVal || 'Instructor unavailability' })
  })
  .then(r => r.json())
  .then(function(data) {
    if (!data.success) {
      err.textContent = data.error || 'Failed to mark date. Please try again.';
      err.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Block Date & Cancel Appointments';
      return;
    }

    // Update local mirror
    unavailDates[data.dateKey] = { date: data.dateKey, reason: data.reason, cancelledRefs: data.cancelledRefs || [] };
    renderUnavailList();
    renderWeekStrip();
    checkWeekUnavailBanner();

    var dayLabel = new Date(dateVal + 'T00:00:00').toLocaleDateString('en-PH', { weekday:'long', month:'long', day:'numeric', year:'numeric' });
    countEl.textContent = data.cancelledCount;
    affectedEl.style.display = 'block';

    var msg = data.cancelledCount > 0
      ? dayLabel + ' marked unavailable. ' + data.cancelledCount + ' appointment(s) cancelled — students have been notified by email.'
      : dayLabel + ' marked as unavailable. No existing appointments were affected.';
    successEl.textContent = msg;
    successEl.style.display = 'block';

    btn.textContent = 'Done ✓';
    setTimeout(function() { closeUnavailModal(); }, 2000);

    showToast(
      data.cancelledCount > 0 ? 'warning' : 'success',
      'Date Blocked',
      msg
    );
  })
  .catch(function() {
    err.textContent = 'Network error. Please try again.';
    err.style.display = 'block';
    btn.disabled = false;
    btn.textContent = 'Block Date & Cancel Appointments';
  });
}

// ── Remove a block ──
function removeUnavailDate(dateKey) {
  var label = new Date(dateKey + 'T00:00:00').toLocaleDateString('en-PH', { weekday:'long', month:'long', day:'numeric' });
  if (!confirm('Remove the unavailability block for ' + label + '?\n\nStudents will be able to book appointments on this date again.')) return;

  fetch('/instructor/unavailability/' + dateKey, { method: 'DELETE' })
    .then(r => r.json())
    .then(function(data) {
      if (!data.success) { alert('Failed to remove block.'); return; }
      delete unavailDates[dateKey];
      renderUnavailList();
      renderWeekStrip();
      checkWeekUnavailBanner();
      showToast('success', 'Block Removed', label + ' is now available for bookings again.');
    })
    .catch(function() { alert('Network error. Please try again.'); });
}

// Load on page start
loadUnavailDates();
</script>
