        </div>
      </div>
      <div class="slot-form-group">
        <label class="slot-form-label">Maximum Students <span style="font-weight:400;color:var(--gray-400)">(divides the time equally)</span></label>
        <div class="slot-stepper">
          <button type="button" class="stepper-btn" id="stepperMinus" aria-label="Decrease">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
          <input type="number" id="slotMaxCapacity" class="stepper-input" min="1" max="10" value="3" readonly>
          <button type="button" class="stepper-btn" id="stepperPlus" aria-label="Increase">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
        </div>
      </div>
      <!-- Validation feedback -->
      <div id="timeValidationMsg" style="display:none;padding:.6rem .8rem;border-radius:8px;font-size:.78rem;margin-top:.5rem;"></div>
    </div>
    <div class="slot-form-group" id="repeatGroup">
      <label class="slot-form-label" style="display:flex;align-items:center;gap:.5rem;">
        <input type="checkbox" id="repeatWeeklyCheck">
        Repeat weekly
      </label>
      <div id="repeatWeeksWrap" style="display:none;margin-top:.5rem;">
        <label class="slot-form-label" for="repeatWeeksInput">Number of weeks</label>
        <input type="number" id="repeatWeeksInput" class="slot-form-input" min="2" max="52" value="4" style="max-width:100px;">
      </div>
    </div>
    <div class="modal-footer"><button class="btn-modal btn-cancel" id="cancelSlot">Cancel</button><button class="btn-modal btn-confirm" id="confirmSlot">Save Slot</button></div>
  </div>
</div>

<div class="modal-overlay" id="slotViewOverlay" onclick="if(event.target===this){closeSlotView();}">
  <div class="modal-content" style="max-width:440px;">
    <div class="modal-header">
      <h3 class="modal-title" id="slotViewTitle">Slot Breakdown</h3>
      <button class="modal-close" type="button" onclick="closeSlotView();">&times;</button>
    </div>
    <div class="modal-body">
      <div id="slotViewSummary" style="display:flex;gap:.75rem;margin-bottom:1rem;flex-wrap:wrap;"></div>
      <p style="font-size:.72rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:.04em;margin:0 0 .55rem">Divided Sub-slots</p>
      <ul id="slotViewList" style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:.45rem;"></ul>
