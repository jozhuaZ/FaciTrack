<%- include('../../partials/script') %>
<script>
let slots = <%- JSON.stringify(consultationSlots || []) %>;
const DAYS      = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];
const DOW_SHORT = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const MONTHS    = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const today = new Date(); today.setHours(0,0,0,0);
let selectedDate  = new Date(today);
let viewMonthDate = new Date(today.getFullYear(), today.getMonth(), 1);
let slotViewIdx   = -1;
let unavailDates = {}; // key: 'YYYY-MM-DD' → { date, reason, cancelledRefs }

/* -- Helpers -- */
function normalizeDate(d){ const n=new Date(d); n.setHours(0,0,0,0); return n; }
function isPastDate(d){ return normalizeDate(d).getTime() < today.getTime(); }
function esc(v){ return String(v||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
function toMins(str) {
  return parseTimeValue(str);
}

document.getElementById('repeatWeeklyCheck').addEventListener('change', function() {
  document.getElementById('repeatWeeksWrap').style.display = this.checked ? 'block' : 'none';
});

/* -- Custom Time Picker -- */
let timePickerState = {
  start: { hour: 12, minute: 0, period: 'AM' },
  end: { hour: 1, minute: 0, period: 'AM' },
  selectedDay: null,
  selectedDate: null
};

function adjustTime(type, unit, delta) {
  const state = timePickerState[type];
  if (unit === 'hour') {
    state.hour += delta;
    if (state.hour > 12) state.hour = 1;
    if (state.hour < 1) state.hour = 12;
  } else {
    state.minute += delta; // 1-minute increments
    if (state.minute >= 60) state.minute = 0;
    if (state.minute < 0) state.minute = 59;
  }
  updateTimeDisplay(type);

  // Auto-adjust end time to stay 1 hour ahead of start
  if (type === 'start') {
    autoAdjustEndTime();
  }

  validateTimeSelection();
}

let timePickerDragState = null;

function initTimePickerDrag() {
  const wheels = document.querySelectorAll('.time-wheel');
  wheels.forEach(function(el) {
    el.addEventListener('pointerdown', function(event) {
      if (event.button !== 0) return;
      const match = el.id.match(/^(start|end)(Hour|Minute)Wheel$/);
      if (!match) return;
      event.preventDefault();
      timePickerDragState = {
        type: match[1],
        unit: match[2].toLowerCase(),
        startY: event.clientY,
        pointerId: event.pointerId
      };
      el.setPointerCapture(event.pointerId);
    });
    el.addEventListener('wheel', function(event) {
      event.preventDefault();
      const match = el.id.match(/^(start|end)(Hour|Minute)Wheel$/);
      if (!match) return;
      const type = match[1];
      const unit = match[2].toLowerCase();
      const delta = event.deltaY < 0 ? 1 : -1;
      adjustTime(type, unit, delta);
    }, { passive: false });
  });

  document.addEventListener('pointermove', function(event) {
    if (!timePickerDragState || event.pointerId !== timePickerDragState.pointerId) return;
    const deltaY = timePickerDragState.startY - event.clientY;
    const stepSize = 18;
    const stepCount = Math.trunc(deltaY / stepSize);
    if (stepCount !== 0) {
      adjustTime(timePickerDragState.type, timePickerDragState.unit, stepCount);
      timePickerDragState.startY -= stepCount * stepSize;
    }
  });

  document.addEventListener('pointerup', function(event) {
    if (timePickerDragState && event.pointerId === timePickerDragState.pointerId) {
      timePickerDragState = null;
    }
  });
  document.addEventListener('pointercancel', function(event) {
    if (timePickerDragState && event.pointerId === timePickerDragState.pointerId) {
      timePickerDragState = null;
    }
  });
}

function setPeriod(type, period) {
  timePickerState[type].period = period;
  document.getElementById(type+'AM').classList.toggle('active', period === 'AM');
  document.getElementById(type+'PM').classList.toggle('active', period === 'PM');

  // Auto-adjust end time to stay 1 hour ahead of start (only when start changes)
  if (type === 'start') {
    autoAdjustEndTime();
  }

  validateTimeSelection();
}

// Keep end time exactly 1 hour ahead of start time
function autoAdjustEndTime() {
  const s = timePickerState.start;
  // Convert start to 24h minutes
  let startH = s.hour;
  if (s.period === 'PM' && startH !== 12) startH += 12;
  if (s.period === 'AM' && startH === 12) startH = 0;
  let endMins = startH * 60 + s.minute + 60; // +1 hour
  if (endMins >= 24 * 60) endMins -= 24 * 60; // wrap midnight
  // Convert back to 12h
  const endH24 = Math.floor(endMins / 60);
  const endMin = endMins % 60;
  const endPeriod = endH24 >= 12 ? 'PM' : 'AM';
  let endH12 = endH24 % 12;
  if (endH12 === 0) endH12 = 12;
  timePickerState.end = { hour: endH12, minute: endMin, period: endPeriod };
  updateTimeDisplay('end');
  // Update AM/PM buttons directly (avoid calling setPeriod to prevent recursion)
  const amBtn = document.getElementById('endAM');
  const pmBtn = document.getElementById('endPM');
  if (amBtn) amBtn.classList.toggle('active', endPeriod === 'AM');
  if (pmBtn) pmBtn.classList.toggle('active', endPeriod === 'PM');
}

function renderTimeWheel(type, unit) {
  const wheelId = type + (unit === 'hour' ? 'HourWheel' : 'MinuteWheel');
  const el = document.getElementById(wheelId);
  if (!el) return;
  const current = timePickerState[type][unit];
  const values = [];
  if (unit === 'hour') {
    for (let offset = -2; offset <= 2; offset++) {
      let value = current + offset;
      if (value > 12) value -= 12;
      if (value < 1) value += 12;
      values.push(value);
    }
  } else {
    for (let offset = -2; offset <= 2; offset++) {
      let value = current + offset;
      if (value < 0) value += 60;
      if (value >= 60) value -= 60;
      values.push(value);
    }
  }
  el.innerHTML = values.map(function(value, index) {
    return '<div class="wheel-item" data-value="' + value + '">' + String(value).padStart(2, '0') + '</div>';
  }).join('');
}

function updateTimeDisplay(type) {
  renderTimeWheel(type, 'hour');
  renderTimeWheel(type, 'minute');
}

function getTimeInMinutes(type) {
  const state = timePickerState[type];
  let hour = state.hour;
  if (state.period === 'PM' && hour !== 12) hour += 12;
  if (state.period === 'AM' && hour === 12) hour = 0;
  return hour * 60 + state.minute;
}

function formatTimeFromState(type) {
  const state = timePickerState[type];
  return state.hour + ':' + String(state.minute).padStart(2, '0') + ' ' + state.period;
}

function isTimePast(hour, minute, period) {
  if (!timePickerState.selectedDate) return false;
  const now = new Date();
  const selectedDate = new Date(timePickerState.selectedDate);
  
  // Normalize dates to compare only year/month/day (ignore time)
  const selectedDay = normalizeDate(selectedDate).getTime();
  const currentDay = normalizeDate(now).getTime();
  
  // If selected date is in the future, no times are past
  if (selectedDay > currentDay) {
    return false;
  }
  
  // If selected date is in the past, all times are past
  if (selectedDay < currentDay) {
    return true;
  }
  
  // Same day - check actual time with proper 24-hour conversion
  let checkHour = hour;
  if (period === 'PM' && hour !== 12) {
    checkHour = hour + 12; // 1 PM = 13, 2 PM = 14, etc.
  } else if (period === 'AM' && hour === 12) {
    checkHour = 0; // 12 AM = 0 (midnight)
  }
  // If AM and not 12, keep as is (1 AM = 1, 2 AM = 2, etc.)
  
  const checkMinutes = checkHour * 60 + minute;
  const nowMinutes = now.getHours() * 60 + now.getMinutes();
  
  // Time is past if it's less than current time
  return checkMinutes < nowMinutes;
}

function hasConflict(startMins, endMins) {
  if (!timePickerState.selectedDay) return false;
  const editIdx = parseInt(document.getElementById('slotEditIdx').value, 10);
  return findConflict(timePickerState.selectedDay, startMins, endMins, editIdx) >= 0;
}

function validateTimeSelection() {
  const saveBtn = document.getElementById('confirmSlot');
  const minusBtn = document.getElementById('stepperMinus');
  const plusBtn  = document.getElementById('stepperPlus');
  const capInput = document.getElementById('slotMaxCapacity');
  const cap = Math.max(1, parseInt(capInput ? capInput.value : 1, 10) || 1);

  if (minusBtn) minusBtn.disabled = cap <= 1;
  if (plusBtn)  plusBtn.disabled  = cap >= 10;

  if (saveBtn) {
    saveBtn.disabled = false;
    saveBtn.style.opacity = '1';
    saveBtn.style.cursor = 'pointer';
    saveBtn.title = 'Click to save this slot';
  }
}


function initializeTimePicker(day, date, slot) {
  timePickerState.selectedDay = day;
  timePickerState.selectedDate = date;
  
  // Show date context in modal if available
  const modalTitle = document.getElementById('slotModalTitle');
  if (date && modalTitle) {
    const dateStr = MONTHS[date.getMonth()] + ' ' + date.getDate() + ', ' + date.getFullYear();
    const dayStr = DAYS[date.getDay()];
    modalTitle.textContent = (slot ? 'Edit' : 'Add') + ' Slot - ' + dayStr + ' | ' + dateStr;
  }
  
  if (slot) {
    // Editing existing slot - parse times
    const startParts = slot.timeStart.match(/(\d+):(\d+)\s*(AM|PM)/);
    const endParts = slot.timeEnd.match(/(\d+):(\d+)\s*(AM|PM)/);
    if (startParts) {
      timePickerState.start = {
        hour: parseInt(startParts[1], 10),
        minute: parseInt(startParts[2], 10),
        period: startParts[3]
      };
    }
    if (endParts) {
      timePickerState.end = {
        hour: parseInt(endParts[1], 10),
        minute: parseInt(endParts[2], 10),
        period: endParts[3]
      };
    }
  } else {
    // New slot - set default to 12:00 AM
    const now = new Date();
    const selectedDate = new Date(date);
    
    // If same day, start from current time + 1 minute
    if (normalizeDate(selectedDate).getTime() === normalizeDate(now).getTime()) {
      let currentMinutes = now.getHours() * 60 + now.getMinutes();
      
      // Start from next minute
      let nextMinutes = currentMinutes + 1;
      
      // Calculate hour and minute from total minutes
      let startHour24 = Math.floor(nextMinutes / 60);
      let startMinute = nextMinutes % 60;
      
      // Handle day overflow (if rounded to next day)
      if (startHour24 >= 24) {
        startHour24 = 0;
        startMinute = 0;
      }
      
      // Convert to 12-hour format
      const startPeriod = startHour24 >= 12 ? 'PM' : 'AM';
      let startHour12 = startHour24 % 12;
      if (startHour12 === 0) startHour12 = 12;
      
      // End time is 1 hour after start time
      let endMinutes = nextMinutes + 60;
      let endHour24 = Math.floor(endMinutes / 60);
      let endMinute = endMinutes % 60;
      
      if (endHour24 >= 24) {
        endHour24 = 23;
        endMinute = 59;
      }
      
      const endPeriod = endHour24 >= 12 ? 'PM' : 'AM';
      let endHour12 = endHour24 % 12;
      if (endHour12 === 0) endHour12 = 12;

      timePickerState.start = { hour: startHour12, minute: startMinute, period: startPeriod };
      timePickerState.end = { hour: endHour12, minute: endMinute, period: endPeriod };
    } else {
      // Future day - default to 8:00 AM
      timePickerState.start = { hour: 8, minute: 0, period: 'AM' };
      timePickerState.end = { hour: 9, minute: 0, period: 'AM' };
    }
  }
  
  // Update displays
  updateTimeDisplay('start');
  updateTimeDisplay('end');
  setPeriod('start', timePickerState.start.period);
  setPeriod('end', timePickerState.end.period);
  
  // Validate and update the save button state
  validateTimeSelection();
}

function parseTimeValue(str){
  const parts = str.trim().split(' ');
  let [h,m] = parts[0].split(':').map(Number);
  const p = parts[1];
  if (p==='PM' && h!==12) h+=12;
  if (p==='AM' && h===12) h=0;
  return h*60+m;
}
function formatTimeValue(mins){
  let h=Math.floor(mins/60), m=mins%60;
  const p=h>=12?'PM':'AM';
  if(h>12)h-=12; if(h===0)h=12;
  return h+':'+String(m).padStart(2,'0')+' '+p;
}
function formatTime24(t){
  const parts=t.split(':'), h=parseInt(parts[0],10), m=parts[1];
  const p=h>=12?'PM':'AM', h12=h===0?12:h>12?h-12:h;
  return h12+':'+m+' '+p;
}
function toInputTime(str){
  const parts=str.trim().split(' ');
  let [h,m]=parts[0].split(':').map(Number);
  const p=parts[1];
  if(p==='PM'&&h!==12)h+=12; if(p==='AM'&&h===12)h=0;
  return String(h).padStart(2,'0')+':'+String(m).padStart(2,'0');
}
function splitSlotTimes(slot){
  const start=parseTimeValue(slot.timeStart), end=parseTimeValue(slot.timeEnd);
  const cap=Math.max(1,parseInt(slot.maxCapacity,10)||1);
  const piece=Math.floor((end-start)/cap);
  const res=[];
  for(let i=0;i<cap;i++){
    const s=start+i*piece, e=i===cap-1?end:s+piece;
    res.push(formatTimeValue(s)+' \u2013 '+formatTimeValue(e));
  }
  return res;
}

/* -- Overlap detection -- */
function findConflict(day, startMins, endMins, excludeIdx){
  return slots.findIndex(function(s,i){
    if(i===excludeIdx) return false;
    if(s.day!==day) return false;
    const sS=parseTimeValue(s.timeStart), sE=parseTimeValue(s.timeEnd);
    return startMins<sE && endMins>sS;
  });
}

/* -- Toast -- */
function showToast(type,title,message){
  const c=document.getElementById('toastContainer');
  const t=document.createElement('div');
  t.className='toast '+type;
  
  // Add icon based on type
  const icon = type === 'success' 
    ? '<svg class="toast-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>'
    : '<svg class="toast-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>';
  
  t.innerHTML=icon+'<div class="toast-content"><p class="toast-title">'+title+'</p><p class="toast-message">'+message+'</p></div>';
  c.appendChild(t);
  setTimeout(function(){t.style.opacity='0';setTimeout(function(){t.remove();},300);},3500);
}

/* -- Mini calendar -- */
function renderMiniCalendar() {
  const year = viewMonthDate.getFullYear(), month = viewMonthDate.getMonth();
  document.getElementById('miniMonthTitle').textContent = MONTHS[month] + ' ' + year;
  const grid = document.getElementById('miniCalGrid');
  grid.innerHTML = '';
  DOW_SHORT.forEach(function (d) {
    const el = document.createElement('div'); el.className = 'mini-dow'; el.textContent = d[0]; grid.appendChild(el);
  });
  const firstDay = new Date(year, month, 1), offset = firstDay.getDay(), prevLast = new Date(year, month, 0).getDate();
  for (let i = offset - 1; i >= 0; i--) {
    const p = document.createElement('div'); p.className = 'mini-day other'; p.textContent = prevLast - i; grid.appendChild(p);
  }
  const lastDate = new Date(year, month + 1, 0).getDate();
  for (let d = 1; d <= lastDate; d++) {
    const date = new Date(year, month, d), cell = document.createElement('div');
    cell.className = 'mini-day'; cell.textContent = d;
    if (isPastDate(date)) cell.classList.add('past'); else cell.classList.add('bookable');
    if (normalizeDate(date).getTime() === today.getTime()) cell.classList.add('today');
    if (normalizeDate(date).getTime() === normalizeDate(selectedDate).getTime()) cell.classList.add('selected');

    const dateKey = toDateKeyJS(date);
    if (unavailDates && unavailDates[dateKey]) cell.classList.add('blocked');
    else if (slots.some(s => s.date === dateKey)) cell.classList.add('has-slots');

    if (!isPastDate(date)) {
      cell.addEventListener('click', function () { selectedDate = new Date(date); viewMonthDate = new Date(date.getFullYear(), date.getMonth(), 1); renderMiniCalendar(); renderWeekStrip(); });
    }
    grid.appendChild(cell);
  }
  const total = offset + lastDate, rest = (Math.ceil(total / 7) * 7) - total;
  for (let i = 1; i <= rest; i++) {
    const n = document.createElement('div'); n.className = 'mini-day other'; n.textContent = i; grid.appendChild(n);
  }
}
/* -- Week strip -- */
function renderWeekStrip(){
  const strip=document.getElementById('weekStrip'), empty=document.getElementById('weekEmpty');
  strip.innerHTML='';
  const startDate=normalizeDate(selectedDate);
  let hasAvailability=false;

  for(let i=0;i<7;i++){
    const date=new Date(startDate);
    date.setDate(startDate.getDate()+i);
    const dayName=DAYS[date.getDay()];
    const daySlots=slots.filter(function(s){ return s.day===dayName; });
    const card=document.createElement('div');
    card.className='week-day';
    if(isPastDate(date)) card.classList.add('past'); else card.classList.add('bookable');
    if(normalizeDate(date).getTime()===normalizeDate(selectedDate).getTime()) card.classList.add('selected');

    // Check if this day is blocked as unavailable
    var dateKey = toDateKeyJS(date);
    var isBlocked = !!(unavailDates && unavailDates[dateKey]);

    const hasSlots = slots.some(s => s.date === dateKey); 

    // Track if day has slots for availability check
    if(daySlots.length){
      hasAvailability=true;
    }

    if (hasSlots && !isBlocked) card.classList.add('has-slots');

    const slotCount = slots.filter(s => s.date === dateKey).length;
    card.innerHTML =
    '<div class="w-dow">' + DOW_SHORT[date.getDay()].toUpperCase() + '</div>' +
    '<div class="w-date' + (normalizeDate(date).getTime() === today.getTime() ? ' today' : '') + '">' + date.getDate() + '</div>' +
    (isBlocked ?
        '<span class="unavailable-chip">Blocked</span>'
    : hasSlots ?
        '<span class="w-slot-badge">' + slotCount + ' slot' + (slotCount > 1 ? 's' : '') + '</span>' +
        (!isPastDate(date) ?
            '<button class="w-add-btn" type="button" onclick="event.stopPropagation();openAddModal(\'' + dayName + '\',new Date(' + date.getTime() + '))">' +
                '<svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>' +
                ' Add Slot' +
            '</button>'
        : '')
    : (!isPastDate(date) ?
        '<button class="w-add-btn" type="button" onclick="event.stopPropagation();openAddModal(\'' + dayName + '\',new Date(' + date.getTime() + '))">' +
            '<svg width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>' +
            ' Add Slot' +
        '</button>'
    : ''));

    if(!isPastDate(date)){
      let scrollStartX = 0;
      let isScrolling = false;

      card.addEventListener('pointerdown', function(e) {
        scrollStartX = e.clientX;
        isScrolling = false;
      }, { passive: true });

      card.addEventListener('pointermove', function(e) {
        const moveDistance = Math.abs(e.clientX - scrollStartX);
        if (moveDistance > 15) {
          isScrolling = true;
        }
      }, { passive: true });

      card.addEventListener('pointerup', function(e) {
        if (isScrolling) {
          isScrolling = false;
          return;
        }
        // Clicking the card background (not the add button)? show day panel
        if(!e.target.closest('.w-add-btn')){
          selectedDate=new Date(date);
          viewMonthDate=new Date(date.getFullYear(), date.getMonth(), 1);
          renderMiniCalendar(); renderWeekStrip();
          showDayPanel(dayName, date);
        }
      }, { passive: true });
    }
    strip.appendChild(card);
  }
  empty.style.display=hasAvailability?'none':'block';
  // Update unavailability banner for this week
  if (typeof checkWeekUnavailBanner === 'function') checkWeekUnavailBanner();
}

/* -- Day slots panel -- */
let activePanelDay  = null;
let activePanelDate = null;

function showDayPanel(dayName, date){
  activePanelDay  = dayName;
  activePanelDate = date;
  const panel = document.getElementById('daySlotPanel');
  // First show the panel, then refresh content
  panel.classList.add('show');
  refreshDayPanel();
  setTimeout(function(){ panel.scrollIntoView({ behavior:'smooth', block:'nearest' }); }, 60);
}

function refreshDayPanel() {
    if (!activePanelDay) return;
    const panel = document.getElementById('daySlotPanel');
    if (!panel.classList.contains('show')) return;

    const title = document.getElementById('dspTitle');
    const body  = document.getElementById('dspBody');
    const d = activePanelDate;
    const dateKey = toDateKeyJS(d);
    const isBlockedDate = !!(unavailDates && unavailDates[dateKey]);
    const dateLabel = DOW_SHORT[d.getDay()] + ', ' + MONTHS[d.getMonth()] + ' ' + d.getDate() + ', ' + d.getFullYear();

    title.innerHTML = '<span class="dsp-title-dot"></span>' + esc(activePanelDay) +
        ' <span style="font-weight:400;color:var(--gray-500);font-size:.8rem">&mdash; ' + esc(dateLabel) + '</span>';
    body.innerHTML = '';

    if (isBlockedDate) {
        body.innerHTML = '<div class="dsp-blocked-banner"><strong>This day is blocked.</strong> Students cannot book consultations on this date.</div>';
        return;
    }

    const groups = groupSlotsForDate(dateKey);

    if (!groups.length) {
        const empty = document.createElement('div');
        empty.className = 'dsp-empty';
        empty.innerHTML =
            '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#d1d5db" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>' +
            '<span>No slots for ' + esc(activePanelDay) + '.</span>' +
            '<span style="font-size:.75rem">Click <strong>+ Add Slot</strong> on the day card to add one.</span>';
        body.appendChild(empty);
        return;
    }

    groups.forEach(function(group) {
        const bookedCount = group.subSlots.filter(s => s.isBooked).length;
        const closedCount = group.subSlots.filter(s => s.status === 'closed').length;
        const totalCount  = group.subSlots.length;
        const isFull      = bookedCount >= (totalCount - closedCount) && (totalCount - closedCount) > 0;
        const statusKey   = isFull ? 'full' : 'open';
        const statusLabel = isFull ? 'Full' : 'Open';

        const groupEl = document.createElement('div');
        groupEl.className = 'dsp-slot-group';

        // Header — shows parent block time range
        const header = document.createElement('div');
        header.className = 'dsp-slot-group-header';
        header.innerHTML =
        '<span class="dsp-slot-range">' + esc(group.timeStart) + ' &ndash; ' + esc(group.timeEnd) + '</span>' +
        '<div style="display:flex;align-items:center;gap:.5rem">' +
            '<span style="font-size:.72rem;color:#6b7280;">' + bookedCount + '/' + totalCount + ' booked' +
                (closedCount > 0 ? ' · ' + closedCount + ' closed' : '') + '</span>' +
                (statusKey !== 'open' ? '<span class="dsp-slot-badge ' + statusKey + '">' + statusLabel + '</span>' : '') +
                '<button class="dsp-slot-action-btn delete" onclick="deleteSlotGroupByIds([' +
                    group.subSlots.map(s => s.id).join(',') +
                '])" title="Delete">' +
                    '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>' +
                '</button>' +
            '</div>';
        groupEl.appendChild(header);

        // Sub-slot grid
        const grid = document.createElement('div');
        grid.className = 'dsp-subslot-grid';
        group.subSlots.forEach(function(sub, i) {
          const isBooked = sub.isBooked;
          const isClosed = sub.status === 'closed';
          const card = document.createElement('div');
          card.className = 'dsp-subslot-card ' + (isClosed ? 'closed' : (isBooked ? 'booked' : 'available'));
          card.innerHTML =
              '<div class="dsp-subslot-header">' +
                  '<span class="dsp-subslot-num">' + (i + 1) + '</span>' +
                  '<span class="dsp-subslot-time">' + esc(sub.timeStart) + ' &ndash; ' + esc(sub.timeEnd) + '</span>' +
              '</div>' +
              (isClosed ?
                  '<div class="dsp-subslot-student"><span class="dsp-subslot-student-name" style="color:#9ca3af;">Closed</span></div>'
              : isBooked ?
                  '<div class="dsp-subslot-student">' +
                      '<span class="dsp-subslot-student-name">Booked</span>' +
                      '<button class="dsp-subslot-search-btn" onclick="goToAppointments()">View</button>' +
                  '</div>'
              : '');
          grid.appendChild(card);
        });
        groupEl.appendChild(grid);
        body.appendChild(groupEl);
    });
}

function hideDayPanel(){
  document.getElementById('daySlotPanel').classList.remove('show');
  activePanelDay  = null;
  activePanelDate = null;
}

function goToAppointments(){
  window.location.href = '/instructor/appointments';
}

document.getElementById('dspClose').addEventListener('click', hideDayPanel);

function groupSlotsForDate(dateKey) {
    const dateSlots = slots.filter(s => s.date === dateKey);
    
    const groups = [];
    const sorted = [...dateSlots].sort((a, b) => toMins(a.timeStart) - toMins(b.timeStart));

    sorted.forEach(slot => {
        const last = groups[groups.length - 1];
        const lastSubSlotEnd = last ? toMins(last.subSlots[last.subSlots.length - 1].timeEnd) : null;
        const thisSlotStart  = toMins(slot.timeStart);

        if (last && lastSubSlotEnd === thisSlotStart) {
            last.subSlots.push(slot);
            last.timeEnd = slot.timeEnd;
        } else {
            groups.push({
                day:       slot.day,
                date:      slot.date,
                timeStart: slot.timeStart,
                timeEnd:   slot.timeEnd,
                status:    slot.status,
                subSlots:  [slot],
            });
        }
    });

    return groups;
}

async function deleteSlotGroup(dateKey, timeStart, timeEnd) {
    if (!confirm('Delete all slots for ' + timeStart + ' – ' + timeEnd + ' on ' + dateKey + '?')) return;

    const groupSlots = slots.filter(s =>
        s.date === dateKey &&
        toMins(s.timeStart) >= toMins(timeStart) &&
        toMins(s.timeEnd) <= toMins(timeEnd) &&
        !s.isBooked
    );

    if (!groupSlots.length) {
        showToast('error', 'Cannot Delete', 'All slots in this block are booked.');
        return;
    }

    // Delete each sub-slot
    for (const slot of groupSlots) {
        await fetch('/instructor/schedule/' + slot.id, { method: 'DELETE' });
        const idx = slots.findIndex(s => s.id === slot.id);
        if (idx > -1) slots.splice(idx, 1);
    }

    renderWeekStrip();
    refreshDayPanel();
    showToast('success', 'Deleted', 'Slot block removed.');
}

async function deleteSlotGroupByIds(ids) {
    if (!confirm('Delete these ' + ids.length + ' slot(s)?')) return;

    const deletable = ids.filter(id => {
        const s = slots.find(x => x.id === id);
        return s && !s.isBooked;
    });

    if (!deletable.length) {
        showToast('error', 'Cannot Delete', 'All slots in this block are booked.');
        return;
    }

    let deletedCount = 0;
    let closedCount = 0;
    let failedCount = 0;

    for (const slotId of deletable) {
        try {
            const res = await fetch('/instructor/schedule/' + slotId, { method: 'DELETE' });
            const data = await res.json();

            if (!data.success) {
                failedCount++;
                continue;
            }

            if (data.softClosed) {
                closedCount++;
                const s = slots.find(x => x.id === slotId);
                if (s) s.status = 'closed';
            } else {
                deletedCount++;
                const idx = slots.findIndex(s => s.id === slotId);
                if (idx > -1) slots.splice(idx, 1);
            }
        } catch (err) {
            failedCount++;
        }
    }

    renderWeekStrip();
    refreshDayPanel();

    if (failedCount > 0) {
        showToast('error', 'Partial Failure', failedCount + ' slot(s) could not be removed.');
    } else if (closedCount > 0) {
        showToast('success', 'Updated', deletedCount + ' deleted, ' + closedCount + ' closed (had appointment history).');
    } else {
        showToast('success', 'Deleted', deletedCount + ' slot(s) removed.');
    }
}

