      '<p style="font-size:1.1rem;font-weight:800;color:#16a34a;margin:0">'+avail+'</p>'+
      '<p style="font-size:.62rem;color:var(--gray-500);text-transform:uppercase;letter-spacing:.04em;margin:2px 0 0">Available</p>'+
