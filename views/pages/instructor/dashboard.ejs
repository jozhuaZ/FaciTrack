<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/instructor/dashboard.css?v=<%= assetVersion %>">
<style>
/* Status Selector */
.status-selector-wrap{position:relative;}
.status-selector-btn{display:inline-flex;align-items:center;gap:.5rem;padding:.5rem .875rem;background:#fff;border:1.5px solid var(--gray-200);border-radius:var(--radius-md);cursor:pointer;transition:all .2s;font-family:var(--font-body);font-size:.8125rem;color:var(--gray-700);font-weight:600;}
.status-selector-btn:hover{border-color:var(--gray-300);background:var(--gray-50);}
.status-indicator{width:9px;height:9px;border-radius:50%;flex-shrink:0;}
.status-indicator.available{background:#22c55e;box-shadow:0 0 0 2px rgba(34,197,94,.25);}
.status-indicator.dnd{background:#ef4444;box-shadow:0 0 0 2px rgba(239,68,68,.25);}
.status-indicator.meeting{background:#f59e0b;box-shadow:0 0 0 2px rgba(245,158,11,.25);}
.status-indicator.leave{background:#6b7280;box-shadow:0 0 0 2px rgba(107,114,128,.25);}
.status-indicator.travel{background:#8b5cf6;box-shadow:0 0 0 2px rgba(139,92,246,.25);}
.status-dropdown{position:absolute;top:calc(100% + .4rem);right:0;width:270px;background:#fff;border:1px solid var(--gray-200);border-radius:var(--radius-lg);box-shadow:0 10px 30px rgba(0,0,0,.12);opacity:0;visibility:hidden;transform:translateY(-8px);transition:all .2s;z-index:200;}
.status-dropdown.show{opacity:1;visibility:visible;transform:translateY(0);}
/* Scoped to #statusDropdown and explicit on layout properties — dashboard.css
   defines an UNRELATED .status-option (the settings toggle buttons) with
   justify-content:center and a 2px border. Without resetting those here,
   they leak in and center each row's content by its text width, which is
   why shorter labels like "On Leave" visibly drifted right of the others. */
#statusDropdown .status-option{display:flex;align-items:center;justify-content:flex-start;flex:none;gap:.75rem;padding:.75rem 1rem;border:none;border-bottom:1px solid var(--gray-50);border-radius:0;cursor:pointer;transition:background .15s;}
#statusDropdown .status-option:last-child{border-bottom:none;}
#statusDropdown .status-option:hover,#statusDropdown .status-option.active{background:var(--gray-50);}
#statusDropdown .status-option-label{font-size:.8125rem;font-weight:600;color:var(--gray-900);display:block;margin-bottom:.1rem;}
#statusDropdown .status-option-desc{font-size:.71rem;color:var(--gray-500);display:block;}
/* ── Dashboard Layout ── */
.dash-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.375rem;}
.dash-col{display:flex;flex-direction:column;gap:1.375rem;}

/* ── Pending requests ──
   Rows use the .upco-item styling below. The View button matches the one on
   the Appointments page (.apt-lv-btn.view / .day-panel-btn.view). */
.dash-view-btn{display:inline-flex;align-items:center;justify-content:center;gap:.25rem;padding:.375rem .6rem;border-radius:7px;border:1.5px solid #e2e8f0;background:#fff;color:#475569;font-size:.72rem;font-weight:700;font-family:inherit;white-space:nowrap;text-decoration:none;flex-shrink:0;transition:all .14s;}
.dash-view-btn:hover{border-color:#0a3d62;color:#0a3d62;background:#f0f9ff;}

/* ── Upcoming appointments ── */
.upco-filter-tabs{display:flex;gap:0;background:var(--gray-100);padding:.2rem;border-radius:8px;width:fit-content;}
.upco-tab{padding:.3rem .75rem;border:none;border-radius:6px;font-size:.75rem;font-weight:600;color:var(--gray-500);cursor:pointer;transition:all .15s;background:transparent;font-family:var(--font-body);white-space:nowrap;}
.upco-tab:hover{color:var(--gray-800);}
.upco-tab.active{background:#fff;color:var(--primary-blue);box-shadow:0 1px 3px rgba(0,0,0,.1);}
.upco-item{display:flex;align-items:center;gap:.75rem;padding:.7rem 1rem;border-left:3px solid #1e88e5;background:#f8faff;border-radius:0 var(--radius-md) var(--radius-md) 0;transition:all .2s;}
.upco-item.today-apt{border-left-color:#16a34a;background:#f0fdf4;}
.upco-item:hover{box-shadow:0 2px 8px rgba(10,61,98,.08);transform:translateX(2px);}
/* An upcoming row is a link to its popup: no underline, text keeps its colours */
.upco-link{text-decoration:none;color:inherit;cursor:pointer;}
.upco-link:focus-visible{outline:2px solid var(--primary-blue);outline-offset:2px;}
.upco-time{font-size:.7rem;font-weight:700;color:var(--primary-blue);min-width:56px;flex-shrink:0;line-height:1.3;}
.upco-date-sub{font-size:.62rem;font-weight:500;color:var(--gray-400);display:block;margin-top:.05rem;}
.upco-item.today-apt .upco-time{color:#15803d;}
/* Pending requests use the same rows in the pending colour (amber, as the
   Pending badges), today or not. */
.upco-item.pending-apt{border-left-color:#f59e0b;background:#fffbeb;}
.upco-item.pending-apt .upco-time,
.upco-item.pending-apt .upco-date-sub.is-today{color:#b45309;}
.upco-info{flex:1;min-width:0;}
.upco-name{font-size:.8rem;font-weight:700;color:var(--gray-900);margin:0 0 .1rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.upco-topic{font-size:.69rem;color:var(--gray-500);margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.upco-badge{font-size:.65rem;font-weight:700;padding:.22rem .55rem;border-radius:5px;flex-shrink:0;}
.upco-badge.confirmed{background:rgba(22,163,74,.12);color:#15803d;}
.upco-badge.pending{background:rgba(234,88,12,.12);color:#c2410c;}

/* ── Consultation slots with progress bars ── */
.slot-strip{display:flex;flex-direction:column;gap:.5rem;}
.slot-row{display:flex;align-items:center;gap:.75rem;padding:.7rem 1rem;border:1px solid var(--gray-100);border-radius:var(--radius-md);background:#fff;transition:border-color .15s;}
.slot-row:hover{border-color:var(--gray-300);}
/* The day pill, booked label and status badge have fixed widths so every row's
   time and progress bar start and end at the same x, whatever they say. */
.slot-day-pill{font-size:.65rem;font-weight:800;padding:.22rem 0;border-radius:6px;background:rgba(10,61,98,.08);color:var(--primary-blue);letter-spacing:.04em;flex-shrink:0;width:42px;text-align:center;box-sizing:border-box;}
.slot-info{flex:1;min-width:0;}
.slot-time{font-size:.78rem;font-weight:600;color:var(--gray-800);margin:0 0 .3rem;}
.slot-progress-wrap{display:flex;align-items:center;gap:.5rem;}
.slot-progress-bar{flex:1;height:5px;background:var(--gray-100);border-radius:3px;overflow:hidden;}
.slot-progress-fill{height:100%;border-radius:3px;transition:width .4s ease;}
.slot-progress-fill.low{background:#16a34a;}
.slot-progress-fill.mid{background:#f59e0b;}
.slot-progress-fill.high{background:#dc2626;}
.slot-cap-label{font-size:.67rem;color:var(--gray-500);white-space:nowrap;flex-shrink:0;width:62px;text-align:right;font-variant-numeric:tabular-nums;}
.slot-badge{font-size:.65rem;font-weight:700;padding:.22rem 0;border-radius:5px;flex-shrink:0;width:74px;text-align:center;box-sizing:border-box;}
/* Matches the pending/confirmed/declined palette used on the appointments page */
.slot-badge.available{background:rgba(22,163,74,.12);color:#15803d;}
.slot-badge.pending{background:rgba(251,146,60,.12);color:#c2410c;}
.slot-badge.confirmed{background:rgba(37,99,235,.12);color:#1d4ed8;}
.slot-badge.closed{background:rgba(107,114,128,.12);color:#374151;}

/* ── Recent activity ── */
.act-item{display:flex;align-items:flex-start;gap:.65rem;padding:.65rem .25rem;border-bottom:1px solid var(--gray-50);}
.act-item:last-child{border-bottom:none;}
.act-icon{width:30px;height:30px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:.05rem;}
.act-icon.new-request{background:rgba(34,197,94,.12);color:#16a34a;}
.act-icon.cancellation{background:rgba(239,68,68,.12);color:#dc2626;}
.act-icon.reminder{background:rgba(59,130,246,.12);color:#2563eb;}
.act-icon.alert{background:rgba(234,88,12,.12);color:#ea580c;}
.act-icon.unavailability{background:rgba(220,38,38,.08);color:#dc2626;}
.act-icon.makeup{background:rgba(6,95,70,.1);color:#065f46;}
.act-msg{font-size:.78rem;color:var(--gray-800);margin:0 0 .18rem;line-height:1.45;}
.act-time{font-size:.67rem;color:var(--gray-400);}
.act-dot{width:7px;height:7px;border-radius:50%;background:var(--primary-blue);flex-shrink:0;margin-top:.4rem;box-shadow:0 0 5px rgba(10,61,98,.35);}

/* ── Empty states ── */
.empty-dash{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.55rem;padding:2rem 1rem;color:var(--gray-400);text-align:center;}
.empty-dash svg{opacity:.35;}
.empty-dash p{font-size:.8125rem;margin:0;color:var(--gray-500);}
.empty-dash strong{font-size:.9rem;color:var(--gray-700);}

.notif-card{display:flex;gap:.7rem;align-items:flex-start;padding:.7rem .2rem;border-bottom:1px solid var(--gray-50);} .notif-card:last-child{border-bottom:none;} .notif-badge{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:9px;background:var(--gray-100);color:var(--gray-700);flex-shrink:0;} .notif-card.unread{background:rgba(10,61,98,.03);} .notif-title{font-size:.78rem;font-weight:700;color:var(--gray-900);margin:0 0 .18rem;} .notif-message{font-size:.74rem;color:var(--gray-600);margin:0;line-height:1.45;} .notif-meta{font-size:.66rem;color:var(--gray-400);margin-top:.2rem;display:flex;align-items:center;gap:.4rem;flex-wrap:wrap;} .notif-dot{width:7px;height:7px;border-radius:50%;background:#0a3d62;flex-shrink:0;margin-top:.35rem;}

/* ── Auto-refresh indicator ── */
.refresh-indicator{display:inline-flex;align-items:center;gap:.35rem;font-size:.69rem;color:var(--gray-400);margin-left:.5rem;}
.refresh-dot{width:6px;height:6px;border-radius:50%;background:#22c55e;animation:pulse-green 2s ease-in-out infinite;}
@keyframes pulse-green{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.4;transform:scale(.7);}}

@media(max-width:900px){
  .dash-grid{grid-template-columns:1fr;}
  /* One column collapses the two columns into DOM order, which would bury
     Upcoming Appointments below the slot list. Dissolving the columns lets the
     cards be ordered for a phone: what needs answering, then what's coming up,
     then the slots that only need managing occasionally. */
  .dash-col{display:contents;}
  .dash-card-pending {order:1;}
  .dash-card-upcoming{order:2;}
  .dash-card-slots   {order:3;}
}
/* Grid and flex children default to min-width:auto, so one wide row inside a
   card stretched the whole column past the right edge of the screen. */
.dash-grid,.dash-col,.dash-col > *{min-width:0;}
@media(max-width:640px){
  .upco-time{min-width:0;}
  .upco-item{gap:.5rem;padding:.7rem .75rem;}
}
</style>

<div class="instructor-layout">
  <%- include('../../partials/instructor-sidebar', { activePage: 'dashboard' }) %>

  <main class="instructor-main">
    <div class="main-container">
      <%# Today's remaining consultations sit in the banner beside the greeting
          (large screens only), in start order, at most four. Ones that have
          already ended are left out. %>
      <%- include('../../partials/greeting-banner', {
            name: instructor.name,
            today: {
              label: 'Upcoming today',
              empty: 'No more consultations today',
              items: todayAppointments.slice(0, 4).map(a => ({ time: a.time, name: a.studentName, status: a.status })),
              more: Math.max(0, todayAppointments.length - 4),
            },
          }) %>

      <!-- ── Page Header ── -->
      <div class="page-header">
        <div>
          <h1 class="page-title">Dashboard</h1>
          <p class="page-subtitle">
            Welcome back, <strong><%= instructor.name %></strong> · <%= instructor.department %>
          </p>
        </div>
        <div class="header-actions">
          <%# Marking dates unavailable lives on the consultation schedule and
              appointments pages. The modal is still included below because
              choosing On Leave / Official Travel opens it automatically. %>
          <%# data-status values must match the users.availability_status enum %>
          <%
            const _statusLabels = {
              available: 'Available', dnd: 'Do Not Disturb', meeting: 'In Meeting',
              leave: 'On Leave', travel: 'Official Travel'
            };
            const _status = instructor.availabilityStatus || 'available';
          %>
          <div class="status-selector-wrap">
            <button class="status-selector-btn" id="statusSelectorBtn" aria-haspopup="true" aria-expanded="false">
              <span class="status-indicator <%= _status %>" id="statusIndicator"></span>
              <span id="statusText"><%= _statusLabels[_status] %></span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
            </button>
            <div class="status-dropdown" id="statusDropdown" role="menu">
              <div class="status-option<%= _status==='available' ? ' active' : '' %>" data-status="available" role="menuitem"><span class="status-indicator available"></span><div><span class="status-option-label">Available</span><span class="status-option-desc">Ready for consultations</span></div></div>
              <div class="status-option<%= _status==='dnd' ? ' active' : '' %>" data-status="dnd" role="menuitem"><span class="status-indicator dnd"></span><div><span class="status-option-label">Do Not Disturb</span><span class="status-option-desc">Busy, avoid interruptions</span></div></div>
              <div class="status-option<%= _status==='meeting' ? ' active' : '' %>" data-status="meeting" role="menuitem"><span class="status-indicator meeting"></span><div><span class="status-option-label">In Meeting</span><span class="status-option-desc">Currently in a meeting</span></div></div>
              <div class="status-option<%= _status==='leave' ? ' active' : '' %>" data-status="leave" role="menuitem"><span class="status-indicator leave"></span><div><span class="status-option-label">On Leave</span><span class="status-option-desc">Out of office</span></div></div>
              <div class="status-option<%= _status==='travel' ? ' active' : '' %>" data-status="travel" role="menuitem"><span class="status-indicator travel"></span><div><span class="status-option-label">On Official Travel</span><span class="status-option-desc">On official business trip</span></div></div>
            </div>
          </div>
        </div>
      </div>

      <!-- ── Stats Row ── -->
      <% const pendingApts  = appointments.filter(a => a.status === 'pending'); %>
      <% const confirmedApts = appointments.filter(a => a.status === 'confirmed'); %>
      <% const totalSlots   = consultationSlots.length; %>
      <%# consultation_hours.status is 'Pending'|'Available'|'Booked'|'closed' — 'open' never occurs.
          A slot is genuinely open when it isn't booked and hasn't been closed. %>
      <% const openSlots    = consultationSlots.filter(s => s.displayStatus === 'available').length; %>
      <div class="stats-overview">
        <div class="stat-card-large pending">
          <div class="stat-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          </div>
          <div class="stat-card-content">
            <p class="stat-card-label">Pending Requests</p>
            <h2 class="stat-card-value"><%= pendingApts.length %></h2>
            <p class="stat-card-sublabel">Awaiting your response</p>
          </div>
        </div>
        <div class="stat-card-large confirmed">
          <div class="stat-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <div class="stat-card-content">
            <p class="stat-card-label">Confirmed</p>
            <h2 class="stat-card-value"><%= confirmedApts.length %></h2>
            <p class="stat-card-sublabel">Confirmed bookings</p>
          </div>
        </div>
        <div class="stat-card-large workload">
          <div class="stat-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div class="stat-card-content">
            <p class="stat-card-label">Total Bookings</p>
            <h2 class="stat-card-value"><%= appointments.length %></h2>
            <p class="stat-card-sublabel">All appointments</p>
          </div>
        </div>
        <div class="stat-card-large presence">
          <div class="stat-card-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div class="stat-card-content">
            <p class="stat-card-label">Open Slots</p>
            <h2 class="stat-card-value"><%= openSlots %> / <%= totalSlots %></h2>
            <p class="stat-card-sublabel">Available consultation slots</p>
          </div>
        </div>
      </div>

      <!-- ── Main Dashboard Grid ── -->
      <div class="dash-grid">

        <!-- LEFT COLUMN -->
        <div class="dash-col">

          <!-- Pending Requests -->
          <div class="content-card dash-card-pending">
            <div class="card-header">
              <h3 class="card-title">
                Pending Requests
                <% if (pendingApts.length > 0) { %><span class="card-count-badge"><%= pendingApts.length %></span><% } %>
              </h3>
              <a href="/instructor/appointments?status=pending" class="card-link">View all →</a>
            </div>
            <div class="card-body">
              <% if (pendingApts.length === 0) { %>
              <div class="empty-dash">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <strong>All caught up!</strong>
                <p>No pending consultation requests right now.</p>
              </div>
              <% } else { %>
              <%# Same rows as Upcoming Appointments. Approving or declining
                  happens in the appointment's popup, which View opens. %>
              <div style="display:flex;flex-direction:column;gap:.5rem;" id="pendingList">
                <% pendingApts.slice(0, 5).forEach(apt => { %>
                <% const _isToday = apt.date === todayKey; %>
                <div class="upco-item pending-apt">
                  <div class="upco-time">
                    <%= apt.time %>
                    <% if (_isToday) { %>
                    <span class="upco-date-sub is-today">Today</span>
                    <% } else if (apt.date) { %>
                    <span class="upco-date-sub"><%= new Date(apt.date + 'T00:00:00').toLocaleDateString('en-PH',{month:'short',day:'numeric'}) %></span>
                    <% } %>
                  </div>
                  <div class="upco-info">
                    <p class="upco-name"><%= apt.studentName %></p>
                    <p class="upco-topic"><%= apt.topic || '—' %></p>
                  </div>
                  <a class="dash-view-btn" href="/instructor/appointments?openApt=<%= encodeURIComponent(apt.id) %>">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>View
                  </a>
                </div>
                <% }); %>
                <% if (pendingApts.length > 5) { %>
                <a href="/instructor/appointments?status=pending" class="view-more-link">+<%= pendingApts.length - 5 %> more pending requests →</a>
                <% } %>
              </div>
              <% } %>
            </div>
          </div>

          <!-- Consultation Schedule -->
          <div class="content-card dash-card-slots">
            <div class="card-header">
              <h3 class="card-title">Consultation Slots</h3>
              <a href="/instructor/consultation-schedule" class="card-link">Manage →</a>
            </div>
            <div class="card-body">
              <% if (!consultationSlots || consultationSlots.length === 0) { %>
              <div class="empty-dash">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <strong>No slots set up yet</strong>
                <p>Set your consultation availability so students can book appointments.</p>
                <a href="/instructor/consultation-schedule" style="font-size:.8rem;color:var(--primary-blue);font-weight:700;">Set up slots →</a>
              </div>
              <% } else { %>
              <div class="slot-strip">
                <%
                  // Each row is one bookable sub-slot — capacity is always 1,
                  // so the bar is either empty (open) or full (taken).
                  const _statusLabels = { available: 'Available', pending: 'Pending', confirmed: 'Confirmed', closed: 'Closed' };
                %>
                <% consultationSlots.slice(0, 6).forEach(slot => { %>
                <%
                  const _booked = slot.isBooked ? 1 : 0;
                  const _pct    = _booked ? 100 : 0;
                  const _fillClass = slot.displayStatus === 'pending' ? 'mid' : _booked ? 'high' : 'low';
                %>
                <div class="slot-row">
                  <span class="slot-day-pill"><%= slot.day.substring(0,3).toUpperCase() %></span>
                  <div class="slot-info">
                    <p class="slot-time"><%= slot.timeStart %> – <%= slot.timeEnd %></p>
                    <div class="slot-progress-wrap">
                      <div class="slot-progress-bar">
                        <div class="slot-progress-fill <%= _fillClass %>" style="width:<%= _pct %>%"></div>
                      </div>
                      <span class="slot-cap-label"><%= _booked %>/1 booked</span>
                    </div>
                  </div>
                  <span class="slot-badge <%= slot.displayStatus %>"><%= _statusLabels[slot.displayStatus] %></span>
                </div>
                <% }); %>
                <% if (consultationSlots.length > 6) { %>
                <a href="/instructor/consultation-schedule" class="view-more-link">+<%= consultationSlots.length - 6 %> more slots →</a>
                <% } %>
              </div>
              <% } %>
            </div>
          </div>

        </div><!-- /left col -->

        <!-- RIGHT COLUMN -->
        <div class="dash-col">

          <!-- Upcoming Appointments -->
          <div class="content-card dash-card-upcoming">
            <div class="card-header" style="flex-wrap:wrap;gap:.625rem;">
              <h3 class="card-title">Upcoming Appointments</h3>
              <div style="display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;">
                <div class="upco-filter-tabs" id="upcoFilterTabs">
                  <button class="upco-tab active" data-filter="all">All</button>
                  <button class="upco-tab" data-filter="today">Today</button>
                  <button class="upco-tab" data-filter="week">This Week</button>
                </div>
                <a href="/instructor/appointments" class="card-link">View all →</a>
              </div>
            </div>
            <div class="card-body">
              <%# Confirmed only, soonest first, and only what has not ended:
                  the controller filters and sorts by start time. "Today" and "This
                  week" compare date keys in the app's timezone, not new Date(),
                  which runs on UTC on the server. %>
              <% const _allUpcoming = upcomingAppointments; %>
              <% if (_allUpcoming.length === 0) { %>
              <div class="empty-dash">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <strong>No upcoming appointments</strong>
                <p>Confirmed bookings will appear here.</p>
              </div>
              <% } else { %>
              <div style="display:flex;flex-direction:column;gap:.5rem;" id="upcoList">
                <% _allUpcoming.slice(0, 8).forEach(apt => { %>
                <%
                  const _isToday    = apt.date === todayKey;
                  const _isThisWeek = apt.date && apt.date <= weekEndKey;
                  const _dateFilter = _isToday ? 'today week all' : (_isThisWeek ? 'week all' : 'all');
                %>
                <%# The whole row opens this appointment's popup on the
                    Appointments page — the same ?openApt= link notifications use. %>
                <a class="upco-item upco-link <%= _isToday ? 'today-apt' : '' %>" data-filter-groups="<%= _dateFilter %>"
                   href="/instructor/appointments?openApt=<%= encodeURIComponent(apt.id) %>"
                   title="Open this appointment">
                  <div class="upco-time">
                    <%= apt.time %>
                    <% if (!_isToday && apt.date) { %>
                    <span class="upco-date-sub"><%= new Date(apt.date + 'T00:00:00').toLocaleDateString('en-PH',{month:'short',day:'numeric'}) %></span>
                    <% } else if (_isToday) { %>
                    <span class="upco-date-sub" style="color:#15803d;">Today</span>
                    <% } %>
                  </div>
                  <div class="upco-info">
                    <p class="upco-name"><%= apt.studentName %></p>
                    <p class="upco-topic"><%= apt.topic || '—' %></p>
                  </div>
                  <span class="upco-badge confirmed">Confirmed</span>
                </a>
                <% }); %>
                <% if (_allUpcoming.length > 8) { %>
                <a href="/instructor/consultations" class="view-more-link">+<%= _allUpcoming.length - 8 %> more appointments →</a>
                <% } %>
              </div>
              <% } %>
            </div>
          </div>

        </div><!-- /right col -->
      </div><!-- /dash-grid -->

    </div><!-- /main-container -->
  </main>
</div>

<%- include('../../partials/unavailability-modal') %>

<div class="toast-container" id="toastContainer"></div>

<%- include('../../partials/script') %>
<script>
/* ══════════════════════════════════════
   STATUS SELECTOR
══════════════════════════════════════ */
const statusBtn  = document.getElementById('statusSelectorBtn');
const statusDrop = document.getElementById('statusDropdown');
const statusInd  = document.getElementById('statusIndicator');
const statusTxt  = document.getElementById('statusText');
let currentStatus = '<%= _status %>';   // seeded from the database

statusBtn.addEventListener('click', e => {
  e.stopPropagation();
  const isOpen = statusDrop.classList.toggle('show');
  statusBtn.setAttribute('aria-expanded', isOpen);
});
document.addEventListener('click', () => {
  statusDrop.classList.remove('show');
  statusBtn.setAttribute('aria-expanded', 'false');
});
statusDrop.addEventListener('click', e => e.stopPropagation());

// Persist the choice, rolling the UI back if the request fails
function applyStatus(status, label) {
  document.querySelectorAll('#statusDropdown .status-option').forEach(o =>
    o.classList.toggle('active', o.dataset.status === status));
  statusTxt.textContent = label;
  statusInd.className = 'status-indicator ' + status;
  currentStatus = status;
}

// Leave and Official Travel usually span days, but the status by itself only
// hides TODAY's slots — the blocked dates are what give students notice.
const MULTI_DAY = { leave: 'On Leave', travel: 'Official Travel' };

async function saveStatus(status, label, previous, previousLabel) {
  try {
    const res  = await fetch('/instructor/availability-status', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status }),
    });
    const data = await res.json();

    if (!data.success) {
      applyStatus(previous, previousLabel);
      showToast('error', 'Status Not Saved', data.error || 'Please try again.');
      return;
    }
    applyStatus(status, label);
    showToast('success', 'Status Updated', 'Your status is now: ' + label);
  } catch (err) {
    applyStatus(previous, previousLabel);
    showToast('error', 'Status Not Saved', 'Network error. Please try again.');
  }
}

document.querySelectorAll('#statusDropdown .status-option').forEach(opt => {
  opt.addEventListener('click', function () {
    const status = this.dataset.status;
    const label  = this.querySelector('.status-option-label').textContent;

    statusDrop.classList.remove('show');
    statusBtn.setAttribute('aria-expanded', 'false');
    if (status === currentStatus) return;

    const previous      = currentStatus;
    const previousLabel = statusTxt.textContent;

    // Ask for the dates FIRST. Saving the status up front left an instructor
    // marked On Leave with nothing blocked whenever they backed out here.
    if (MULTI_DAY[status]) {
      UnavailModal.open(null, {
        prompt: 'Block the days you will be away, so students cannot book them. ' +
                'Your status is not changed until you finish here.',
        reason: MULTI_DAY[status],
        skipLabel: 'Set status only',
        onBlocked:  () => saveStatus(status, label, previous, previousLabel),
        onSkipped:  () => saveStatus(status, label, previous, previousLabel),
        onDismissed: () => showToast('error', 'Status Unchanged',
          'You are still ' + previousLabel + '. Nothing was blocked.'),
      });
      return;
    }

    applyStatus(status, label);   // optimistic for the instant statuses
    saveStatus(status, label, previous, previousLabel);
  });
});

/* ══════════════════════════════════════
   UPCOMING FILTER TABS (All / Today / This Week)
══════════════════════════════════════ */
document.querySelectorAll('.upco-tab').forEach(tab => {
  tab.addEventListener('click', function () {
    document.querySelectorAll('.upco-tab').forEach(t => t.classList.remove('active'));
    this.classList.add('active');
    const filter = this.dataset.filter;
    document.querySelectorAll('#upcoList .upco-item').forEach(item => {
      const groups = (item.dataset.filterGroups || 'all').split(' ');
      item.style.display = groups.includes(filter) ? '' : 'none';
    });
    // Show empty message if nothing visible
    const visible = document.querySelectorAll('#upcoList .upco-item:not([style*="none"])');
    const emptyMsg = document.getElementById('upcoEmptyFiltered');
    if (emptyMsg) emptyMsg.style.display = visible.length === 0 ? '' : 'none';
  });
});

/* ══════════════════════════════════════
   MARK UNAVAILABLE (opened by On Leave / Official Travel)
══════════════════════════════════════ */

document.addEventListener('keydown', e => {
  if (e.key === 'Escape') UnavailModal.requestClose();
});

// Blocking a date can cancel or move appointments — reload so the lists are accurate
window.onUnavailabilityChanged = function () {
  window.location.reload();
};

/* ══════════════════════════════════════
   LIVE REFRESH — a request arrived or was withdrawn
══════════════════════════════════════ */
// This used to poll /instructor/consultations/data every 45s and reload when
// the pending count differed. That route no longer exists (it became
// /appointments), so the poll got a 404, read it as "0 pending", and reloaded
// the page every 45 seconds whenever any request was waiting.
//
// The notification a booking or cancellation sends already reaches this page
// live (Realtime: a stream, or polling where the host cannot hold one), so the
// dashboard reloads on exactly those events instead.
(function () {
  const REFRESH_ON = ['new-request', 'cancellation'];
  let queued = false;

  // Never pull the page out from under an open dropdown or modal: wait until
  // it has closed, checking every few seconds.
  function busy() {
    return document.querySelector('#statusDropdown.show, .modal-overlay.show, #notifPanel.open');
  }
  function reloadWhenIdle() {
    if (queued) return;
    queued = true;
    (function attempt() {
      if (busy()) { setTimeout(attempt, 3000); return; }
      window.location.reload();
    })();
  }

  function subscribe() {
    if (!window.Realtime) return;
    window.Realtime.on('notification:new', function (notif) {
      if (notif && REFRESH_ON.indexOf(notif.type) !== -1) reloadWhenIdle();
    });
  }
  if (window.Realtime) subscribe();
  else document.addEventListener('DOMContentLoaded', subscribe);
})();

/* ══════════════════════════════════════
   TOAST
══════════════════════════════════════ */
function showToast(type, title, message) {
  const c = document.getElementById('toastContainer');
  if (!c) return;
  const t = document.createElement('div');
  t.className = 'toast ' + type;
  t.innerHTML = '<div class="toast-content"><p class="toast-title">' + escHtml(title) + '</p><p class="toast-message">' + escHtml(message) + '</p></div>';
  c.appendChild(t);
  setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 300); }, 4000);
}
function escHtml(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
</script>
<script src="/js/instructor-unavailability.js"></script>
<%- include('../../partials/footer') %>
