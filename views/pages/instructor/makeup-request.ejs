<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/instructor/dashboard.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/instructor/makeup.css?v=<%= assetVersion %>">

<%
  function fileSize(bytes) {
    if (!bytes) return '';
    return bytes < 1024 * 1024
      ? Math.max(1, Math.round(bytes / 1024)) + ' KB'
      : (bytes / 1024 / 1024).toFixed(1) + ' MB';
  }
%>

<div class="instructor-layout">
  <%- include('../../partials/instructor-sidebar', { activePage: 'makeup', pendingCount: pendingCount }) %>
  <main class="instructor-main">
    <div class="main-container">

      <div class="page-header">
        <div>
          <h1 class="page-title"><%= editing ? 'Edit Make-Up Request' : 'Request a Make-Up Class' %></h1>
          <p class="page-subtitle">
            Pick the classes you missed, let FaciTrack find the slots, and attach your paperwork.
          </p>
        </div>
      </div>

      <% if (flash) { %>
        <div class="mk-flash <%= flash.type %>"><%= flash.message %></div>
      <% } %>

      <form id="makeupForm" method="POST"
            action="<%= editing ? '/instructor/makeup/request/' + editing.id : '/instructor/makeup/request' %>"
            enctype="multipart/form-data" class="mk-grid">

        <!-- ── Which classes are being made up ── -->
        <div class="content-card">
          <div class="card-header"><h3 class="card-title">Classes being made up</h3></div>
          <div class="card-body">
            <% if (!missedClasses.length) { %>
              <p class="mk-empty">
                Your timetable is empty, so there is nothing to pick from.
                Add your load on the <a href="/instructor/workload">Workload</a> page first —
                you can still add a session by hand below.
              </p>
            <% } else { %>
              <p class="settings-description mk-intro">
                Tick each class you missed, then generate a schedule. FaciTrack looks for the
                soonest free room that suits the class and keeps its usual start time where it can.
              </p>
              <div class="mk-class-list">
                <div class="mk-class-header">
                  <span class="mk-class-header-check"></span>
                  <span class="mk-class-header-col">Subject Code</span>
                  <span class="mk-class-header-col">Subject Name</span>
                  <span class="mk-class-header-col mk-class-header-type">Class Type</span>
                </div>
                <% missedClasses.forEach(function (c) { %>
                  <label class="mk-class" for="cls<%= c.id %>">
                    <input type="checkbox" id="cls<%= c.id %>" class="mk-class-check"
                           data-block='<%- JSON.stringify(c) %>'>
                    <span class="mk-class-col mk-class-code"><%= c.subjectCode %></span>
                    <span class="mk-class-col mk-class-name">
                      <span class="mk-class-title"><%= c.subjectName %></span>
                      <span class="mk-class-meta">
                        <%= c.sectionName || 'No section' %> ·
                        <%= c.day %> <%= c.timeLabel %>
                        <% if (c.roomNumber) { %> · <%= c.roomNumber %><% } %>
                      </span>
                    </span>
                    <span class="mk-class-type <%= c.classType.toLowerCase() %>"><%= c.classType %></span>
                  </label>
                <% }); %>
              </div>

              <div class="mk-generate-bar">
                <button type="button" class="btn-save-settings mk-generate" id="mkGenerate" disabled>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                  Find available slots
                </button>
                <span class="mk-generate-hint" id="mkGenerateHint">Tick a class to enable this.</span>
              </div>
            <% } %>
          </div>
        </div>

        <!-- ── When the make-ups will be held ── -->
        <div class="content-card">
          <div class="card-header">
            <h3 class="card-title">Make-up sessions</h3>
            <span class="mk-count" id="mkCount">0</span>
          </div>
          <div class="card-body">
            <p class="settings-description mk-intro">
              Between <strong><%= window.minDate %></strong> and <strong><%= window.maxDate %></strong>
              (<%= window.weeks %> weeks ahead). Clashes are checked as you type, and you can
              override anything the generator picked.
            </p>

            <div id="mkSessions" class="mk-sessions"></div>

            <p class="mk-empty" id="mkNoSessions">
              No sessions yet. Tick a class above, or add one by hand.
            </p>

            <button type="button" class="btn-save-settings mk-add" id="mkAdd">+ Add a session</button>
          </div>
        </div>

        <!-- ── Reason and paperwork ── -->
        <div class="content-card">
          <div class="card-header"><h3 class="card-title">Reason and documents</h3></div>
          <div class="card-body">
            <div class="form-group">
              <label class="modal-label" for="mkReason">Reason for the make-up</label>
              <textarea class="modal-input mk-textarea" id="mkReason" name="reason" rows="3"
                        maxlength="500" placeholder="e.g. Attended the regional faculty seminar"><%= editing ? (editing.reason || '') : '' %></textarea>
            </div>

            <% if (editing && editing.documents.length) { %>
              <label class="modal-label">Already attached</label>
              <ul class="mk-doc-list">
                <% editing.documents.forEach(function (d) { %>
                  <li class="mk-doc">
                    <span class="mk-doc-kind <%= d.kind %>"><%= d.kind === 'polling' ? 'Polling' : 'Support' %></span>
                    <a class="mk-doc-name" href="/instructor/makeup/document/<%= d.id %>"
                       target="_blank" rel="noopener"><%= d.original_name %></a>
                    <span class="mk-doc-size"><%= fileSize(d.size_bytes) %></span>
                    <label class="mk-doc-remove">
                      <input type="checkbox" name="removeDocuments" value="<%= d.id %>">
                      Remove
                    </label>
                  </li>
                <% }); %>
              </ul>
            <% } %>

            <div class="mk-upload-grid">
              <div>
                <label class="modal-label" for="mkDocs">
                  Supporting documents (PDF)
                  <% if (editing) { %><span class="mk-optional">— optional when editing</span><% } %>
                </label>
                <label class="mk-file" id="mkDocsBox">
                  <input type="file" id="mkDocs" name="documents" accept="application/pdf" multiple hidden>
                  <span class="mk-file-text" id="mkDocsText">
                    Click to attach one or more PDFs (max 5, 10 MB each)
                  </span>
                </label>
              </div>

              <div>
                <label class="modal-label" for="mkPolling">
                  Polling document <span class="mk-optional">— PDF or spreadsheet, optional</span>
                </label>
                <label class="mk-file" id="mkPollingBox">
                  <input type="file" id="mkPolling" name="polling"
                         accept=".pdf,.xlsx,.xls,application/pdf,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                         hidden>
                  <span class="mk-file-text" id="mkPollingText">
                    <% if (editing && editing.pollingDocument) { %>
                      Current: <%= editing.pollingDocument.original_name %> — click to replace
                    <% } else { %>
                      Click to attach the student poll
                    <% } %>
                  </span>
                </label>
              </div>
            </div>
          </div>
        </div>

        <div class="mk-actions">
          <a href="/instructor/makeup/requests" class="btn-modal btn-cancel">Cancel</a>
          <button type="submit" class="btn-save-settings" id="mkSubmit">
            <%= editing ? 'Save changes' : 'Submit for dean review' %>
          </button>
        </div>
      </form>
    </div>
  </main>
</div>

<div class="toast-container" id="toastContainer"></div>
<%- include('../../partials/footer') %>
<%- include('../../partials/script') %>
<script>
  window.MK_ROOMS = <%- JSON.stringify(rooms.map(function (r) {
    return { id: r.id, name: r.room_number, type: r.room_type };
  })) %>;
  window.MK_ROOM_TYPES = <%- JSON.stringify(roomTypesForClass) %>;
  window.MK_WINDOW    = <%- JSON.stringify(window) %>;
  window.MK_EDITING   = <%- editing ? JSON.stringify({ id: editing.id, sessions: editing.sessions, hasDocuments: editing.documents.length }) : 'null' %>;
</script>
<script src="/js/instructor-makeup.js?v=<%= assetVersion %>"></script>
