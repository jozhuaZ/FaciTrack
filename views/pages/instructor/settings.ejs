<script src="/js/settings-tracker.js?v=<%= assetVersion %>"></script>
<script src="/js/instructor-settings.js?v=<%= assetVersion %>"></script>
<script src="/js/calendar-feed-link.js?v=<%= assetVersion %>"></script>
