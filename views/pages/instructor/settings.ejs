<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/instructor/dashboard.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/settings-chrome.css?v=<%= assetVersion %>">
<style>
.settings-grid { display: grid; grid-template-columns: 380px 1fr; gap: 1.5rem; align-items: start; }
@media(max-width:1100px){ .settings-grid { grid-template-columns: 1fr; } }

/* Profile card */
.profile-card-top { position:relative; display:flex; flex-direction:column; align-items:center; padding: 2rem 1.5rem 1.5rem; border-bottom: 1px solid var(--gray-100); text-align:center; }
.settings-avatar-wrap { position:relative; width:88px; height:88px; margin-bottom:1rem; }
.settings-avatar-wrap .profile-avatar-mini { width:88px; height:88px; font-size:1.75rem; }
.settings-avatar-wrap .avatar-upload-overlay { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,.45); border-radius:50%; opacity:0; transition:opacity .2s; cursor:pointer; color:#fff; }
.settings-avatar-wrap:hover .avatar-upload-overlay { opacity:1; }
.settings-name { font-size:1.0625rem; font-weight:700; color:var(--gray-900); margin:0 0 .2rem; }
.settings-email { font-size:.8125rem; color:var(--gray-500); margin:0; }

/* Read-only field */
.modal-input[readonly] { background:var(--gray-50); color:var(--gray-500); cursor:not-allowed; }
.field-hint { font-size:.75rem; color:var(--gray-500); margin:.35rem 0 0; line-height:1.5; }

/* Status toggle */
#statusGroup { display:grid; grid-template-columns:1fr 1fr; gap:.75rem; margin-top:.25rem; }
#statusGroup .status-option:first-child { grid-column:1 / -1; }
#statusGroup .status-option {
  display:flex; align-items:center; justify-content:center; gap:.5rem;
  padding:.625rem 1rem; border:2px solid var(--gray-200); border-radius:10px;
  cursor:pointer; font-size:.8125rem; font-weight:600; color:var(--gray-500);
  transition:all .18s; user-select:none; text-align:center;
}
#statusGroup .status-option input { display:none; }
#statusGroup .status-option.active-available { border-color:#16a34a; background:rgba(22,163,74,.07); color:#15803d; }
#statusGroup .status-option.active-alert     { border-color:#dc2626; background:rgba(220,38,38,.07); color:#b91c1c; }
.status-dot { width:9px; height:9px; border-radius:50%; flex-shrink:0; }

/* Five tap targets do not fit a phone — swap the grid for a select */
.status-select-wrap { display:none; }
.status-select {
  width:100%; padding:.7rem .875rem;
  border:1.5px solid var(--gray-300); border-radius:var(--radius-md);
  font-size:.875rem; font-weight:600; font-family:var(--font-body);
  color:var(--gray-800); background:#fff;
}
@media(max-width:640px){
  #statusGroup { display:none; }
  .status-select-wrap { display:block; }
}

/* Away notice shown for travel / leave */
.status-away-note {
  display:none; margin-top:1rem; padding:.8rem .9rem; border-radius:var(--radius-md);
  background:#fffbeb; border:1px solid #fde68a; font-size:.78rem; color:#92400e; line-height:1.6;
}
.status-away-note.show { display:block; }
.status-away-note a { color:#92400e; font-weight:700; }

/* Right column */
.settings-right { display:flex; flex-direction:column; gap:1.5rem; }

/* Weeks stepper */
.weeks-stepper { display:flex; align-items:center; gap:.5rem; }
.weeks-stepper .stepper-btn {
  width:34px; height:34px; display:flex; align-items:center; justify-content:center;
  border:1.5px solid var(--gray-300); background:#fff; border-radius:8px; cursor:pointer; color:var(--gray-700);
}
.weeks-stepper .stepper-btn:hover { border-color:var(--primary-blue); color:var(--primary-blue); }
.weeks-stepper input { width:64px; text-align:center; padding:.5rem; border:1.5px solid var(--gray-300); border-radius:8px; font-size:.875rem; font-weight:700; font-family:var(--font-body); }
.repeat-settings-panel { margin-top:1rem; }
.repeat-settings-panel.hidden { display:none; }
.settings-note {
  margin-top:1rem; padding:.85rem; background:var(--gray-50);
  border:1px solid var(--gray-200); border-radius:var(--radius-md);
  font-size:.78rem; color:var(--gray-600); line-height:1.6;
}

/* Device notifications */
.push-row { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; }
.push-copy { min-width:0; }
.push-title { font-size:.875rem; font-weight:700; color:var(--gray-900); margin:0 0 .2rem; }
.push-desc { font-size:.8rem; color:var(--gray-600); line-height:1.6; margin:0; }
.push-msg { display:none; font-size:.78rem; margin:.7rem 0 0; }
.push-test {
  margin-top:.8rem; background:none; border:none; padding:0; cursor:pointer;
  font-size:.78rem; font-weight:600; color:var(--primary-blue);
  text-decoration:underline; font-family:var(--font-body);
}
/* The toggle stays on the right at every width; only the copy reflows */
.push-row .toggle-switch { flex-shrink:0; }
@media (max-width:520px){
  .push-row { gap:.75rem; }
  .push-desc { font-size:.75rem; }
}

/* ── Google Calendar connection ── */
.gcal-state {
  display:flex; align-items:center; gap:.75rem; flex-wrap:wrap;
  padding:.8rem .9rem; border-radius:var(--radius-md);
  border:1px solid var(--gray-200); background:var(--gray-50);
}
.gcal-state.connected { border-color:#a7f3d0; background:#ecfdf5; }
.gcal-state.broken    { border-color:#fde68a; background:#fffbeb; }
.gcal-dot { width:9px; height:9px; border-radius:50%; background:var(--gray-400); flex-shrink:0; }
.gcal-state.connected .gcal-dot { background:#16a34a; }
.gcal-state.broken .gcal-dot    { background:#d97706; }
.gcal-copy { min-width:0; flex:1; }
.gcal-label { font-size:.8125rem; font-weight:700; color:var(--gray-900); margin:0 0 .15rem; }
.gcal-sub   { font-size:.78rem; color:var(--gray-600); margin:0; overflow-wrap:anywhere; }
.gcal-btn {
  flex-shrink:0; display:inline-flex; align-items:center; gap:.45rem;
  padding:.55rem 1rem; border-radius:var(--radius-md); cursor:pointer;
  font-size:.8125rem; font-weight:600; font-family:var(--font-body);
  border:1.5px solid var(--gray-300); background:#fff; color:var(--gray-700);
  text-decoration:none; transition:all var(--transition-base);
}
.gcal-btn:hover { border-color:var(--primary-blue); color:var(--primary-blue); }
.gcal-btn.danger:hover { border-color:#dc2626; color:#dc2626; }
.gcal-notice { margin:0 0 .9rem; padding:.7rem .85rem; border-radius:var(--radius-md); font-size:.78rem; line-height:1.6; }
.gcal-notice.ok   { background:#ecfdf5; border:1px solid #a7f3d0; color:#065f46; }
.gcal-notice.warn { background:#fffbeb; border:1px solid #fde68a; color:#92400e; }
.gcal-btn.primary { border-color:var(--primary-blue); background:var(--primary-blue); color:#fff; }
.gcal-btn.primary:hover { filter:brightness(1.08); color:#fff; }
.gcal-btn[disabled] { opacity:.6; cursor:default; }

/* The calendar-sync half of the card, shown only once connected */
.gcal-sync { margin-top:1rem; display:flex; flex-direction:column; gap:.9rem; }
.gcal-sync-head { display:flex; align-items:center; gap:.75rem; flex-wrap:wrap; }
.gcal-sync-line { flex:1; min-width:0; margin:0; font-size:.78rem; color:var(--gray-600); line-height:1.6; }
.gcal-field { display:flex; flex-direction:column; gap:.35rem; }
.gcal-field span { font-size:.8125rem; font-weight:600; color:var(--gray-800); }
.gcal-field select {
  padding:.55rem .75rem; border:1.5px solid var(--gray-300); border-radius:var(--radius-md);
  font-size:.8125rem; font-family:var(--font-body); color:var(--gray-800); background:#fff;
}
.gcal-check { display:flex; align-items:flex-start; gap:.5rem; font-size:.8125rem; color:var(--gray-700); line-height:1.5; cursor:pointer; }
.gcal-check input { margin-top:.15rem; flex-shrink:0; }

/* On a phone the button drops below the text rather than squeezing it */
@media(max-width:520px){
  .gcal-state { align-items:flex-start; }
  .gcal-btn { width:100%; justify-content:center; }
  .gcal-sync-head #googleSyncNow { width:100%; }
}

/* Meeting link row */
.link-row { display:flex; gap:.6rem; flex-wrap:wrap; align-items:flex-start; }
.link-row input {
  flex:1; min-width:220px; padding:.625rem .875rem; border:1.5px solid var(--gray-300);
  border-radius:var(--radius-md); font-size:.875rem; font-family:var(--font-body);
}

/* The unsaved pill, save bar and leave dialog live in /css/settings-chrome.css,
   shared with the Dean settings page. */

/* ── Published feed ── */
.feed-row { display:flex; gap:.5rem; align-items:stretch; margin-top:1rem; }
.feed-url { flex:1; min-width:0; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; font-size:.78rem; }
.feed-copy {
  flex-shrink:0; padding:.5rem 1rem; border:1.5px solid var(--gray-300);
  border-radius:var(--radius-md); background:#fff; color:var(--gray-700);
  font-size:.8125rem; font-weight:600; cursor:pointer; font-family:var(--font-body);
  transition:all var(--transition-base);
}
.feed-copy:hover { border-color:var(--primary-blue); color:var(--primary-blue); }
.feed-copy.done { border-color:#16a34a; color:#16a34a; }
.feed-status { font-size:.78rem; margin:.5rem 0 0; color:#166534; }
.feed-status.bad { color:#dc2626; }
.feed-actions { display:flex; gap:.5rem; flex-wrap:wrap; margin-top:.875rem; }
.feed-btn {
  display:inline-flex; align-items:center; gap:.4rem;
  padding:.5rem .875rem; border:1.5px solid var(--gray-200);
  border-radius:var(--radius-md); background:#fff; color:var(--gray-700);
  font-size:.8125rem; font-weight:600; text-decoration:none;
  transition:all var(--transition-base);
}
.feed-btn:hover { border-color:var(--primary-blue); color:var(--primary-blue); background:rgba(10,61,98,.03); }
.feed-rotate {
  margin-top:.5rem; padding:.45rem .875rem; border:1.5px solid #fecaca;
  border-radius:var(--radius-md); background:#fff; color:#dc2626;
  font-size:.78rem; font-weight:600; cursor:pointer; font-family:var(--font-body);
}
.feed-rotate:hover { background:#fef2f2; border-color:#dc2626; }
.feed-rotate-note { font-size:.72rem; color:var(--gray-400); margin:.35rem 0 0; }
@media (max-width:560px) {
  .feed-row { flex-direction:column; }
  .feed-copy, .feed-btn { width:100%; justify-content:center; }
}

/* ── Feed help block, shared by the published-feed card ── */
.cal-help { margin-top:1rem; }
.cal-help summary { font-size:.78rem; font-weight:600; color:var(--primary-blue); cursor:pointer; }
.cal-help-body { margin-top:.6rem; font-size:.78rem; color:var(--gray-600); line-height:1.6; }
.cal-help-body p { margin:0 0 .5rem; }
.cal-help-warn { color:#92400e; background:#fffbeb; border:1px solid #fde68a;
  border-radius:var(--radius-md); padding:.5rem .65rem; }

</style>

<div class="instructor-layout">
  <%- include('../../partials/instructor-sidebar', { activePage: 'settings', pendingCount: pendingCount }) %>
  <main class="instructor-main">
    <div class="main-container">
      <div class="page-header">
        <div>
          <h1 class="page-title">Settings</h1>
          <p class="page-subtitle">Manage your profile, status, and preferences</p>
        </div>
      </div>

      <div class="settings-grid">

        <!-- LEFT COLUMN -->
        <div style="display:flex;flex-direction:column;gap:1.5rem;">

          <!-- Personal information -->
          <div class="content-card settings-card" data-card="profile">
            <div class="profile-card-top">
              <span class="unsaved-pill">Unsaved</span>
              <% const avatarInitials = ((instructor.firstName || ' ')[0] + (instructor.lastName || ' ')[0]).toUpperCase().trim(); %>
              <div class="settings-avatar-wrap">
                <%# data-initials so the host still knows its fallback while a photo covers it %>
                <div class="profile-avatar-mini" id="settingsAvatar" data-initials="<%= avatarInitials %>">
                  <% if (instructor.profilePhoto) { %>
                    <img src="<%= instructor.profilePhoto %>" alt="<%= instructor.name %>" class="avatar-img">
                  <% } else { %>
                    <span class="avatar-initials"><%= avatarInitials %></span>
                  <% } %>
                  <label class="avatar-upload-overlay" title="Change photo">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                    <input type="file" id="settingsAvatarInput" accept="image/*" style="display:none;" data-no-track>
                  </label>
                </div>
                <%# Sibling of the avatar, not a child: .profile-avatar-mini is
                    overflow:hidden to keep the photo circular, which would clip
                    a corner badge. The wrap is the 88px positioned box. %>
                <button type="button" class="btn-avatar-remove" id="settingsAvatarRemove"
                        title="Remove photo" aria-label="Remove photo" data-no-track
                        <% if (!instructor.profilePhoto) { %>style="display:none"<% } %>>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
              </div>
              <p class="settings-name"><%= instructor.name %></p>
              <p class="settings-email"><%= instructor.email %></p>
            </div>
            <div class="card-body">
              <div class="form-group">
                <label class="modal-label" for="inputFirstName">First Name</label>
                <input type="text" class="modal-input" id="inputFirstName" value="<%= instructor.firstName || '' %>">
              </div>
              <div class="form-group">
                <label class="modal-label" for="inputMiddleName">Middle Name <span style="font-weight:400;color:var(--gray-400)">(optional)</span></label>
                <input type="text" class="modal-input" id="inputMiddleName" value="<%= instructor.middleName || '' %>">
              </div>
              <div class="form-group">
                <label class="modal-label" for="inputLastName">Last Name</label>
                <input type="text" class="modal-input" id="inputLastName" value="<%= instructor.lastName || '' %>">
              </div>
              <div class="form-group">
                <label class="modal-label" for="inputEmail">Email Address</label>
                <input type="email" class="modal-input" id="inputEmail" value="<%= instructor.email %>" readonly data-no-track>
                <p class="field-hint">Your institutional email is how you sign in. Contact the administrator to change it.</p>
              </div>
            </div>
          </div>

          <!-- Campus status -->
          <div class="content-card settings-card" data-card="status">
            <div class="card-header">
              <h3 class="card-title">Status</h3>
              <span class="unsaved-pill">Unsaved</span>
            </div>
            <div class="card-body">
              <p class="settings-description" style="margin-bottom:1rem;">Set your current campus status. Students see this before booking, and anything other than Available blocks same-day bookings.</p>
              <div id="statusGroup">
                <label class="status-option">
                  <input type="radio" name="campusStatus" value="available" <%= instructor.availabilityStatus === 'available' ? 'checked' : '' %>>
                  <span class="status-dot" style="background:#16a34a;"></span> Available
                </label>
                <label class="status-option">
                  <input type="radio" name="campusStatus" value="dnd" <%= instructor.availabilityStatus === 'dnd' ? 'checked' : '' %>>
                  <span class="status-dot" style="background:#dc2626;"></span> Do Not Disturb
                </label>
                <label class="status-option">
                  <input type="radio" name="campusStatus" value="meeting" <%= instructor.availabilityStatus === 'meeting' ? 'checked' : '' %>>
                  <span class="status-dot" style="background:#dc2626;"></span> In Meeting
                </label>
                <label class="status-option">
                  <input type="radio" name="campusStatus" value="travel" <%= instructor.availabilityStatus === 'travel' ? 'checked' : '' %>>
                  <span class="status-dot" style="background:#dc2626;"></span> On Official Travel
                </label>
                <label class="status-option">
                  <input type="radio" name="campusStatus" value="leave" <%= instructor.availabilityStatus === 'leave' ? 'checked' : '' %>>
                  <span class="status-dot" style="background:#dc2626;"></span> On Leave
                </label>
              </div>

              <div class="status-select-wrap">
                <label class="modal-label" for="statusSelect">Current status</label>
                <select class="status-select" id="statusSelect" data-no-track>
                  <option value="available">Available</option>
                  <option value="dnd">Do Not Disturb</option>
                  <option value="meeting">On Meeting</option>
                  <option value="travel">On Official Travel</option>
                  <option value="leave">On Leave</option>
                </select>
              </div>

              <div class="status-away-note" id="statusAwayNote">
                Away for more than today? Block those dates on your
                <a href="/instructor/consultation-schedule">Consultation Schedule</a>
                so students are not left booking slots you cannot keep.
              </div>

            </div>
          </div>

        </div>

        <!-- RIGHT COLUMN -->
        <div class="settings-right">

          <!-- Consultation schedule defaults -->
          <div class="content-card settings-card" data-card="schedule">
            <div class="card-header">
              <h3 class="card-title">Consultation Schedule Settings</h3>
              <span class="unsaved-pill">Unsaved</span>
            </div>
            <div class="card-body">
              <p class="settings-description" style="margin-bottom:1rem;">Applied automatically whenever you add a new consultation slot.</p>

              <div class="settings-toggle-list">
                <div class="settings-toggle-row">
                  <div>
                    <p class="toggle-label">Repeat Weekly</p>
                    <p class="toggle-desc">New slots are created on the same weekday for several weeks</p>
                  </div>
                  <label class="toggle-switch">
                    <input type="checkbox" id="toggleRepeatWeekly" <%= settings.repeatWeekly ? 'checked' : '' %>>
                    <span class="toggle-slider"></span>
                  </label>
                </div>
              </div>

              <div id="repeatSettingsPanel" class="repeat-settings-panel <%= settings.repeatWeekly ? '' : 'hidden' %>">
                <label class="modal-label" for="repeatWeeks">Number of weeks</label>
                <div class="weeks-stepper">
                  <button type="button" class="stepper-btn" id="weeksMinus" aria-label="Fewer weeks">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  </button>
                  <input type="number" id="repeatWeeks" min="2" max="52" value="<%= settings.repeatWeeks %>" readonly>
                  <button type="button" class="stepper-btn" id="weeksPlus" aria-label="More weeks">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                  </button>
                </div>
              </div>

              <p class="settings-note" id="repeatSummary"></p>
            </div>
          </div>

          <!-- Online consultation link -->
          <%#
            Google Calendar sits in its own card, deliberately outside
            .settings-card: connecting is a round-trip to Google and
            disconnecting takes effect at once, so neither belongs to the
            unsaved-changes save bar that tracks the other cards.
          %>
          <%
            const gcal = (typeof googleCalendar !== 'undefined' && googleCalendar) || { available: false, connected: false };
            const gNotice = (typeof googleNotice !== 'undefined') ? googleNotice : null;
            const G_NOTICES = {
              connected:       ['ok',   'Google Calendar connected. Your events were imported, and new online consultations now get their own scheduled meeting.'],
              denied:          ['warn', 'Connection cancelled — nothing was changed.'],
              state_mismatch:  ['warn', 'That connection link expired. Start again from this page.'],
              exchange_failed: ['warn', 'Google refused the connection. Try again, or remove FaciTrack at myaccount.google.com/permissions first.'],
              not_configured:  ['warn', 'Google is not set up on this server yet. Ask your administrator.'],
              unknown:         ['warn', 'Something went wrong connecting Google Calendar.'],
            };
            const gShown = G_NOTICES[gNotice] || null;
          %>
          <div class="content-card" data-card-static="google">
            <div class="card-header">
              <h3 class="card-title">Google Calendar</h3>
            </div>
            <div class="card-body">
              <% if (gShown) { %>
                <p class="gcal-notice <%= gShown[0] %>"><%= gShown[1] %></p>
              <% } %>

              <p class="settings-description" style="margin-bottom:.9rem;">
                One connection does two things: every online consultation gets its own
                scheduled Google Meet on your calendar with the student invited, and
                your own events are read back so students cannot book over them.
                FaciTrack only ever adds its own consultations — it never edits or
                deletes anything else on your calendar.
              </p>

              <% if (!gcal.available) { %>
                <div class="gcal-state">
                  <span class="gcal-dot"></span>
                  <div class="gcal-copy">
                    <p class="gcal-label">Not available on this server</p>
                    <p class="gcal-sub">Google credentials have not been configured yet.</p>
                  </div>
                </div>
              <% } else if (gcal.connected) { %>
                <div class="gcal-state connected">
                  <span class="gcal-dot"></span>
                  <div class="gcal-copy">
                    <p class="gcal-label">Connected</p>
                    <p class="gcal-sub"><%= gcal.email || 'Your Google account' %></p>
                  </div>
                  <button type="button" class="gcal-btn danger" id="googleDisconnect">Disconnect</button>
                </div>

                <%
                  const gsync = gcal.sync || null;
                  const gsyncWhen = gsync && gsync.last_synced_at
                    ? new Date(gsync.last_synced_at).toLocaleString('en-PH', {
                        month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit',
                        timeZone: 'Asia/Manila',
                      })
                    : null;
                %>
                <div class="gcal-sync" data-connection="<%= gsync ? gsync.id : '' %>">
                  <div class="gcal-sync-head">
                    <p class="gcal-sync-line">
                      <% if (gsync && gsync.last_status === 'error') { %>
                        Last sync failed — <%= gsync.last_error || 'try again.' %>
                      <% } else if (gsyncWhen) { %>
                        <%= gsync.event_count %> event<%= gsync.event_count === 1 ? '' : 's' %> imported ·
                        last checked <%= gsyncWhen %>
                      <% } else { %>
                        Not synced yet.
                      <% } %>
                    </p>
                    <button type="button" class="gcal-btn" id="googleSyncNow">Sync now</button>
                  </div>

                  <label class="gcal-field">
                    <span>Do your calendar events block appointments?</span>
                    <select id="googleBlockRule">
                      <option value="ask"    <%= gsync && gsync.blocking_rule === 'ask'    ? 'selected' : '' %>>Ask me for each event</option>
                      <option value="always" <%= gsync && gsync.blocking_rule === 'always' ? 'selected' : '' %>>Yes — block the time they cover</option>
                      <option value="never"  <%= gsync && gsync.blocking_rule === 'never'  ? 'selected' : '' %>>No — just show them on my calendar</option>
                    </select>
                  </label>

                  <label class="gcal-check">
                    <input type="checkbox" id="googleImportTitles" <%= !gsync || gsync.import_titles ? 'checked' : '' %>>
                    Import event titles. Untick to store busy times only.
                  </label>
                </div>

                <p class="field-hint">
                  Disconnecting leaves meetings that are already scheduled alone —
                  students keep the links they were given. Imported events are removed,
                  since FaciTrack could no longer keep them up to date.
                </p>
              <% } else { %>
                <div class="gcal-state <%= gcal.error ? 'broken' : '' %>">
                  <span class="gcal-dot"></span>
                  <div class="gcal-copy">
                    <p class="gcal-label"><%= gcal.error ? 'Reconnection needed' : 'Not connected' %></p>
                    <p class="gcal-sub"><%= gcal.error || 'Online consultations will use your personal link below.' %></p>
                  </div>
                  <a class="gcal-btn primary" href="/instructor/google/connect">
                    <%= gcal.error ? 'Reconnect' : 'Connect Google Calendar' %>
                  </a>
                </div>
              <% } %>
            </div>
          </div>

          <div class="content-card settings-card" data-card="link">
            <div class="card-header">
              <h3 class="card-title">Personal Meeting Room</h3>
              <span class="unsaved-pill">Unsaved</span>
            </div>
            <div class="card-body">
              <p class="settings-description" style="margin-bottom:.9rem;">
                One standing link, reused for every online consultation. It is what
                students get when Google Calendar is not connected, and the fallback
                if a scheduled meeting cannot be created.
              </p>
              <div class="link-row">
                <input type="url" id="meetingLinkInput"
                       placeholder="https://meet.google.com/abc-defg-hij"
                       value="<%= instructor.defaultMeetingLink || '' %>">
              </div>
              <p class="field-hint">
                With Google Calendar connected you can leave this empty — each
                consultation gets its own meeting instead.
              </p>
            </div>
          </div>

          <!-- Notification preferences -->
          <div class="content-card settings-card" data-card="notifications">
            <div class="card-header">
              <h3 class="card-title">Notification Preferences</h3>
              <span class="unsaved-pill">Unsaved</span>
            </div>
            <div class="card-body">
              <p class="settings-description" style="margin-bottom:1rem;">
                Choose which updates reach you by email and on your devices.
                Your in-app notification bell always shows everything.
              </p>
              <div class="settings-toggle-list">
                <div class="settings-toggle-row">
                  <div>
                    <p class="toggle-label">New Appointment Requests</p>
                    <p class="toggle-desc">When a student books a consultation</p>
                  </div>
                  <label class="toggle-switch">
                    <input type="checkbox" id="notifyNewRequests" <%= settings.notifyNewRequests ? 'checked' : '' %>>
                    <span class="toggle-slider"></span>
                  </label>
                </div>
                <div class="settings-toggle-row">
                  <div>
                    <p class="toggle-label">Appointment Cancellations</p>
                    <p class="toggle-desc">When a student cancels a booking</p>
                  </div>
                  <label class="toggle-switch">
                    <input type="checkbox" id="notifyCancellations" <%= settings.notifyCancellations ? 'checked' : '' %>>
                    <span class="toggle-slider"></span>
                  </label>
                </div>
                <div class="settings-toggle-row">
                  <div>
                    <p class="toggle-label">Consultation Reminders</p>
                    <p class="toggle-desc">Shortly before a scheduled consultation starts</p>
                  </div>
                  <label class="toggle-switch">
                    <input type="checkbox" id="notifyReminders" <%= settings.notifyReminders ? 'checked' : '' %>>
                    <span class="toggle-slider"></span>
                  </label>
                </div>
                <div class="settings-toggle-row">
                  <div>
                    <p class="toggle-label">Presence Alerts</p>
                    <p class="toggle-desc">When presence is not detected during your consultation hours</p>
                  </div>
                  <label class="toggle-switch">
                    <input type="checkbox" id="notifyBleAbsence" <%= settings.notifyBleAbsence ? 'checked' : '' %>>
                    <span class="toggle-slider"></span>
                  </label>
                </div>
                <div class="settings-toggle-row">
                  <div>
                    <p class="toggle-label">Dean's Office Announcements</p>
                    <p class="toggle-desc">Department-wide notices from the dean</p>
                  </div>
                  <label class="toggle-switch">
                    <input type="checkbox" id="notifyAnnouncements" <%= settings.notifyAnnouncements ? 'checked' : '' %>>
                    <span class="toggle-slider"></span>
                  </label>
                </div>
              </div>
            </div>
          </div>

          <!-- Device notifications: applied immediately, so not change-tracked -->
          <div class="content-card">
            <div class="card-header">
              <h3 class="card-title">Device Notifications</h3>
            </div>
            <div class="card-body">
              <div class="push-row">
                <div class="push-copy">
                  <p class="push-title">Notify me on this device</p>
                  <p class="push-desc">
                    Get new requests and appointment updates as notifications on this device,
                    even when FaciTrack is closed. Turn this on for each device you use.
                  </p>
                </div>
                <label class="toggle-switch">
                  <input type="checkbox" id="pushToggle" disabled data-no-track>
                  <span class="toggle-slider"></span>
                </label>
              </div>
              <p id="pushMsg" class="push-msg"></p>
              <button type="button" id="pushTestBtn" class="push-test" style="display:none;">Send a test notification</button>
            </div>
          </div>

          <!-- The other direction: FaciTrack's own schedule, published outward.
               Not change-tracked — there is nothing to save, only a link to copy. -->
          <div class="content-card" data-feed-card="/instructor">
            <div class="card-header">
              <h3 class="card-title">Publish My Consultations</h3>
            </div>
            <div class="card-body">
              <p class="settings-description">
                Subscribe Google Calendar or Apple Calendar to this link and your consultations
                appear there automatically — with the student, topic, room or meeting link, and
                the full duration. It updates itself as bookings are approved, rescheduled or
                cancelled.
              </p>

              <div class="feed-row">
                <input type="text" class="modal-input feed-url" id="feedUrl" readonly data-no-track
                       value="Generating…" aria-label="Calendar subscription link">
                <button type="button" class="feed-copy" id="feedCopy">Copy</button>
              </div>
              <p class="feed-status" id="feedStatus" hidden></p>

              <div class="feed-actions">
                <a class="feed-btn" id="feedGoogle" href="#" target="_blank" rel="noopener">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  Add to Google Calendar
                </a>
                <a class="feed-btn" id="feedApple" href="#">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  Add to Apple Calendar
                </a>
              </div>

              <details class="cal-help">
                <summary>How often does it update, and who can see it?</summary>
                <div class="cal-help-body">
                  <p><strong>Refresh rate</strong> — a subscribed calendar is pulled on the
                  client's own schedule. Apple lets you choose, down to every 5 minutes. Google
                  decides for itself and is often several hours behind. For anything urgent,
                  rely on the email and device notifications, which are immediate.</p>
                  <p><strong>Read-only</strong> — editing the event in Google or Apple changes
                  nothing in FaciTrack. Bookings are still managed here.</p>
                  <p class="cal-help-warn">
                    This link is a password. Anyone who has it can read your consultation
                    schedule, including student names and topics. If you ever paste it somewhere
                    public, regenerate it below.
                  </p>
                  <button type="button" class="feed-rotate" id="feedRotate">Regenerate link</button>
                  <p class="feed-rotate-note">Existing subscriptions stop updating and must be re-added.</p>
                </div>
              </details>
            </div>
          </div>

          <!-- Security: not change-tracked, the fields are cleared after saving -->
          <div class="content-card">
            <div class="card-header">
              <h3 class="card-title">Security</h3>
            </div>
            <div class="card-body">
              <div class="form-group">
                <label class="modal-label" for="inputCurrentPw">Current Password</label>
                <input type="password" class="modal-input" id="inputCurrentPw" autocomplete="current-password" data-no-track>
              </div>
              <div class="form-group">
                <label class="modal-label" for="inputNewPw">New Password</label>
                <input type="password" class="modal-input" id="inputNewPw" autocomplete="new-password" data-no-track>
              </div>
              <div class="form-group">
                <label class="modal-label" for="inputConfirmPw">Confirm New Password</label>
                <input type="password" class="modal-input" id="inputConfirmPw" autocomplete="new-password" data-no-track>
              </div>
              <button class="btn-save-settings" id="btnChangePassword">Update Password</button>
            </div>
          </div>

        </div>
      </div>

      <!-- Unsaved-changes bar -->
      <div class="dirty-bar" id="dirtyBar">
        <div class="dirty-bar-inner">
          <div>
            <p class="dirty-bar-text" id="dirtyBarText">You have unsaved changes.</p>
            <p class="dirty-bar-sub">They will be lost if you leave this page.</p>
          </div>
          <div class="dirty-bar-actions">
            <button type="button" class="btn-discard" id="btnDiscardAll">Discard</button>
            <button type="button" class="btn-save-all" id="btnSaveAll">Save all changes</button>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<!-- Leave confirmation, for in-app navigation -->
<div class="modal-overlay" id="leaveOverlay">
  <div class="modal-content" style="max-width:420px;">
    <div class="modal-header">
      <h3 class="modal-title">Unsaved changes</h3>
    </div>
    <div class="modal-body">
      <p style="font-size:.875rem;color:var(--gray-600);line-height:1.65;margin:0;" id="leaveBody">
        You have unsaved changes on this page. What would you like to do?
      </p>
      <div class="leave-modal-actions">
        <button type="button" class="btn-modal btn-cancel" id="leaveStay">Stay on page</button>
        <button type="button" class="btn-modal btn-cancel" id="leaveDiscard">Leave without saving</button>
        <button type="button" class="btn-modal btn-primary" id="leaveSave">Save &amp; leave</button>
      </div>
    </div>
  </div>
</div>

<div class="toast-container" id="toastContainer"></div>
<%- include('../../partials/footer') %>
<%- include('../../partials/script') %>
<%- include('../../partials/unavailability-modal') %>
