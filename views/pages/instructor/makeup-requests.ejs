<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/instructor/dashboard.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/instructor/makeup.css?v=<%= assetVersion %>">

<%
  function fmtDate(value) {
    return new Date(String(value).slice(0, 10) + 'T00:00:00')
      .toLocaleDateString('en-PH', { month: 'long', day: 'numeric', year: 'numeric' });
  }

  // Everything the search box should be able to match, built once per card
  function haystack(r) {
    return [
      r.status, r.reason || '', r.decline_reason || '', r.dean_statement || '',
      fmtDate(r.submitted_at),
      r.sessions.map(function (s) {
        return [s.subject_code, s.subject_name, s.section_name, s.class_type,
                s.room_number || 'online', fmtDate(s.class_date), s.timeLabel].join(' ');
      }).join(' ')
    ].join(' ').toLowerCase();
  }
%>

<div class="instructor-layout">
  <%- include('../../partials/instructor-sidebar', { activePage: 'makeup', pendingCount: pendingCount }) %>
  <main class="instructor-main">
    <div class="main-container">

      <div class="page-header">
        <div>
          <h1 class="page-title">Make-Up Class Requests</h1>
          <p class="page-subtitle">Your submissions and where each one stands with the dean.</p>
        </div>
        <div class="header-actions">
          <a href="/instructor/makeup/request" class="btn-save-settings" style="text-decoration:none;">
            New request
          </a>
        </div>
      </div>

      <% if (flash) { %>
        <div class="mk-flash <%= flash.type %>"><%= flash.message %></div>
      <% } %>

      <% if (!requests.length) { %>
        <div class="content-card">
          <div class="card-body">
            <p class="mk-empty">
              You have not filed any make-up class requests yet.
              <a href="/instructor/makeup/request">Start one</a>.
            </p>
          </div>
        </div>
      <% } else { %>

        <div class="mk-filter-bar">
          <div class="mk-search-wrap">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path>
            </svg>
            <input type="search" id="mkSearch" class="mk-search-input"
                   placeholder="Search subject, section, room or date" aria-label="Search requests">
            <button type="button" id="mkSearchClear" class="mk-search-clear" hidden aria-label="Clear search">&times;</button>
          </div>

          <select class="mk-filter-select" id="mkStatusFilter" aria-label="Filter by status">
            <option value="all">All Statuses</option>
            <option value="pending">Pending</option>
            <option value="approved">Approved</option>
            <option value="declined">Declined</option>
            <% if (counts.withdrawn) { %>
              <option value="withdrawn">Withdrawn</option>
            <% } %>
          </select>

          <select class="mk-filter-select" id="mkTypeFilter" aria-label="Filter by class type">
            <option value="all">All Class Types</option>
            <option value="lecture">Lecture</option>
            <option value="laboratory">Laboratory</option>
            <option value="online">Online</option>
          </select>
        </div>

        <p class="mk-empty" id="mkFilterEmpty" hidden></p>

        <% requests.forEach(function (r) { %>
          <%
            // Collect unique class types across all sessions for this request
            var classTypes = r.sessions.map(function(s){ return (s.class_type || '').toLowerCase(); })
                              .filter(function(t,i,a){ return t && a.indexOf(t)===i; });
          %>
          <div class="mk-req" id="req-<%= r.id %>"
               data-status="<%= r.status %>"
               data-class-type="<%= classTypes.join(' ') %>"
               data-search="<%= haystack(r) %>">
            <div class="mk-req-head">
              <div>
                <p class="mk-req-who">
                  <%= r.sessions.map(function (s) { return s.subject_code; }).join(', ') || 'Make-up request' %>
                </p>
                <p class="mk-req-when">
                  <%= r.sessions.length %> session<%= r.sessions.length === 1 ? '' : 's' %> ·
                  submitted <%= fmtDate(r.submitted_at) %>
                  <% if (r.decided_by_first) { %>
                    · decided by <%= r.decided_by_first %> <%= r.decided_by_last %>
                  <% } %>
                </p>
              </div>
              <span class="mk-status <%= r.status %>"><%= r.status %></span>
            </div>

            <div class="mk-req-body">
              <% r.sessions.forEach(function (s) { %>
                <div class="mk-session-line">
                  <strong><%= s.subject_code %></strong>
                  <span><%= s.section_name %></span>
                  <% if (s.class_type) { %><span class="mk-chip"><%= s.class_type %></span><% } %>
                  <span><%= fmtDate(s.class_date) %> · <%= s.timeLabel %></span>
                  <% if (s.delivery_mode === 'online') { %>
                    <span class="mk-venue online">Online</span>
                  <% } else { %>
                    <span class="mk-venue room"><%= s.room_number || 'Room TBA' %></span>
                  <% } %>
                </div>
              <% }); %>

              <% if (r.reason) { %>
                <p class="mk-note reason"><strong>Reason:</strong> <%= r.reason %></p>
              <% } %>
              <% if (r.status === 'declined' && r.decline_reason) { %>
                <p class="mk-note decline"><strong>Declined:</strong> <%= r.decline_reason %></p>
              <% } %>
              <% if (r.status === 'approved' && r.dean_statement) { %>
                <p class="mk-note dean"><strong>Dean:</strong> <%= r.dean_statement %></p>
              <% } %>
              <% if (!r.pollingDocument) { %>
                <p class="mk-note warn">No polling document attached.</p>
              <% } %>
            </div>

            <div class="mk-req-actions">
              <% r.documents.forEach(function (d) { %>
                <a class="mk-btn doc" href="/instructor/makeup/document/<%= d.id %>"
                   target="_blank" rel="noopener">
                  <%= d.kind === 'polling' ? 'Polling sheet' : d.original_name %>
                </a>
              <% }); %>
              <% if (r.status === 'pending') { %>
                <a class="mk-btn edit" href="/instructor/makeup/request/<%= r.id %>/edit">Edit</a>
                <button type="button" class="mk-btn withdraw" data-withdraw="<%= r.id %>">Withdraw</button>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </main>
</div>

<div class="toast-container" id="toastContainer"></div>
<%- include('../../partials/footer') %>
<%- include('../../partials/script') %>
<script src="/js/makeup-list.js?v=<%= assetVersion %>"></script>
<script>
(function () {
  document.querySelectorAll('[data-withdraw]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (!confirm('Withdraw this request? The dean will be told it is no longer waiting.')) return;
      btn.disabled = true;
      fetch('/instructor/makeup/' + btn.dataset.withdraw + '/withdraw', { method: 'POST' })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (!data.success) { btn.disabled = false; alert(data.error || 'Could not withdraw.'); return; }
          window.location.reload();
        })
        .catch(function () { btn.disabled = false; alert('Network error. Please try again.'); });
    });
  });
}());
</script>
