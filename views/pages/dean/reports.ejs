<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/instructor/dashboard.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/report-table.css?v=<%= assetVersion %>">
<style>
/* Only the per-table minimum widths are page-specific; the toolbar, table
   shell, pills and notice all come from /css/report-table.css */
@media (max-width:768px){
  #facultyRosterTable { min-width:760px; }
  #makeupTable        { min-width:860px; }
  #presenceTable      { min-width:520px; }
}
</style>

<div class="instructor-layout">
  <%- include('../../partials/dean-sidebar', { activePage: 'reports' }) %>
  <main class="instructor-main">
    <div class="main-container">

      <%
        const instructorNames = [...new Set(makeupRequests.map(r => r.instructorName))].sort();
        const presenceNames   = [...new Set(presenceLogs.map(l => l.facultyName))].sort();
        const pendingCount    = makeupRequests.filter(r => r.status === 'pending').length;
        const approvedCount   = makeupRequests.filter(r => r.status === 'approved').length;
        const declinedCount   = makeupRequests.filter(r => r.status === 'declined').length;
      %>

      <div class="page-header">
        <div>
          <h1 class="page-title">Reports</h1>
          <p class="page-subtitle"><%= dean.department %> — faculty, make-up requests and presence history</p>
        </div>
      </div>

      <!-- Stats -->
      <div class="stats-overview">
        <div class="stat-card-large workload">
          <div class="stat-card-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
          <div class="stat-card-content">
            <p class="stat-card-label">Faculty</p>
            <h2 class="stat-card-value"><%= faculty.length %></h2>
            <p class="stat-card-sublabel">In <%= dean.department %></p>
          </div>
        </div>
        <div class="stat-card-large pending">
          <div class="stat-card-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div>
          <div class="stat-card-content">
            <p class="stat-card-label">Pending Make-Ups</p>
            <h2 class="stat-card-value"><%= pendingCount %></h2>
            <p class="stat-card-sublabel">Awaiting your decision</p>
          </div>
        </div>
        <div class="stat-card-large confirmed">
          <div class="stat-card-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
          <div class="stat-card-content">
            <p class="stat-card-label">Approved</p>
            <h2 class="stat-card-value"><%= approvedCount %></h2>
            <p class="stat-card-sublabel">Make-up classes cleared</p>
          </div>
        </div>
        <div class="stat-card-large presence">
          <div class="stat-card-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg></div>
          <div class="stat-card-content">
            <p class="stat-card-label">Declined</p>
            <h2 class="stat-card-value"><%= declinedCount %></h2>
            <p class="stat-card-sublabel">Returned to the instructor</p>
          </div>
        </div>
      </div>

      <%# One report at a time. All three are still rendered — each is already
          paginated at 10 rows by report-table.js — but stacking them made the
          third one a long scroll away. The counts sit on the buttons so the
          data can be found without opening each in turn. %>
      <div class="report-picker" role="tablist" aria-label="Choose a report">
        <button type="button" class="report-pick active" data-show="faculty" role="tab" aria-selected="true">
          Faculty Roster <span class="report-pick-count"><%= faculty.length %></span>
        </button>
        <button type="button" class="report-pick" data-show="makeup" role="tab" aria-selected="false">
          Make-Up Requests <span class="report-pick-count"><%= makeupRequests.length %></span>
        </button>
        <button type="button" class="report-pick" data-show="presence" role="tab" aria-selected="false">
          Presence History <span class="report-pick-count"><%= presenceLogs.length %></span>
        </button>
        <%# The one report that can demand action, so its count is coloured when
            anything is overdue rather than sitting in the same grey as the rest. %>
        <button type="button" class="report-pick<%= unansweredStaleCount ? ' alert' : '' %>"
                data-show="unanswered" role="tab" aria-selected="false">
          Unanswered Requests
          <span class="report-pick-count<%= unansweredStaleCount ? ' alert' : '' %>"><%= unansweredRequests.length %></span>
        </button>
      </div>

      <% if (unansweredStaleCount) { %>
      <div class="report-alert" role="status">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>
          <strong><%= unansweredStaleCount %></strong>
          consultation request<%= unansweredStaleCount === 1 ? ' has' : 's have' %>
          been waiting more than <%= unansweredStaleHours %> hours for an instructor to respond.
        </span>
        <button type="button" class="report-alert-go" data-show="unanswered">View</button>
      </div>
      <% } %>

      <!-- ── Faculty Roster ── -->
      <div class="content-card report-table" data-table="faculty" data-subtitle="<%= dean.department %>">
        <div class="card-header">
          <h3 class="card-title">Faculty Roster</h3>
          <span class="result-count" data-role="count">—</span>
        </div>
        <div class="table-toolbar">
          <div class="toolbar-group">
            <span class="toolbar-label">Search</span>
            <input type="search" class="table-search" data-role="search" placeholder="Name, position or office…">
          </div>
          <div class="toolbar-group">
            <span class="toolbar-label">Availability</span>
            <select class="table-select" data-role="filter" data-field="availability">
              <option value="all">All</option>
              <option value="available">Available</option>
              <option value="dnd">Do Not Disturb</option>
              <option value="meeting">In a Meeting</option>
              <option value="travel">Official Travel</option>
              <option value="leave">On Leave</option>
            </select>
          </div>
          <div class="toolbar-group">
            <span class="toolbar-label">Presence</span>
            <select class="table-select" data-role="filter" data-field="bleStatus">
              <option value="all">All</option>
              <option value="in-room">In Room</option>
              <option value="out-of-room">Out of Room</option>
              <option value="unknown">Awaiting Data</option>
            </select>
          </div>
          <div class="toolbar-spacer"></div>
          <button class="btn-header-action" data-role="export">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export
          </button>
        </div>
        <div class="card-body" style="padding:0">
          <div class="table-scroll">
            <table class="data-table" id="facultyRosterTable">
              <thead>
                <tr>
                  <th>Faculty</th>
                  <th>Position</th>
                  <th>Office / Room</th>
                  <th>Availability</th>
                  <th>Presence</th>
                  <th style="text-align:center">Hours (Month)</th>
                  <th style="text-align:center">Consultations</th>
                  <th style="text-align:center">Avg. Duration</th>
                </tr>
              </thead>
              <tbody data-role="body"></tbody>
            </table>
          </div>
          <div class="no-results" data-role="empty" style="display:none">
            <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <p><%= faculty.length ? 'No instructor matches your search.' : 'No instructors are assigned to this department yet.' %></p>
          </div>
          <div class="pagination-bar">
            <span class="page-info" data-role="pageinfo">—</span>
            <div class="pagination-controls">
              <button class="btn-page" data-role="prev" disabled>Prev</button>
              <button class="btn-page" data-role="next" disabled>Next</button>
            </div>
          </div>
        </div>
      </div>

      <!-- ── Make-Up Class Requests ── -->
      <div class="content-card report-table" data-table="makeup" data-subtitle="<%= dean.department %>">
        <div class="card-header">
          <h3 class="card-title">Make-Up Class Requests</h3>
          <span class="result-count" data-role="count">—</span>
        </div>
        <div class="table-toolbar">
          <div class="toolbar-group">
            <span class="toolbar-label">Search</span>
            <input type="search" class="table-search" data-role="search" placeholder="Instructor, subject or section…">
          </div>
          <div class="toolbar-group">
            <span class="toolbar-label">Status</span>
            <select class="table-select" data-role="filter" data-field="status">
              <option value="all">All</option>
              <option value="pending">Pending</option>
              <option value="approved">Approved</option>
              <option value="declined">Declined</option>
            </select>
          </div>
          <div class="toolbar-group">
            <span class="toolbar-label">Instructor</span>
            <select class="table-select" data-role="filter" data-field="instructorName">
              <option value="all">All Instructors</option>
              <% instructorNames.forEach(name => { %>
              <option value="<%= name %>"><%= name %></option>
              <% }); %>
            </select>
          </div>
          <div class="toolbar-spacer"></div>
          <button class="btn-header-action" data-role="export">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export
          </button>
        </div>
        <div class="card-body" style="padding:0">
          <div class="table-scroll">
            <table class="data-table" id="makeupTable">
              <thead>
                <tr>
                  <th>Instructor</th>
                  <th>Subject</th>
                  <th>Section</th>
                  <th style="text-align:center">Sessions</th>
                  <th>First Class</th>
                  <th>Room</th>
                  <th>Status</th>
                  <th>Decided By</th>
                  <th>Submitted</th>
                </tr>
              </thead>
              <tbody data-role="body"></tbody>
            </table>
          </div>
          <div class="no-results" data-role="empty" style="display:none">
            <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <p><%= makeupRequests.length ? 'No request matches your search.' : 'No make-up class requests have been submitted in this department yet.' %></p>
          </div>
          <div class="pagination-bar">
            <span class="page-info" data-role="pageinfo">—</span>
            <div class="pagination-controls">
              <button class="btn-page" data-role="prev" disabled>Prev</button>
              <button class="btn-page" data-role="next" disabled>Next</button>
            </div>
          </div>
        </div>
      </div>

      <!-- ── Faculty Presence History ── -->
      <div class="content-card report-table" data-table="presence" data-subtitle="<%= dean.department %>">
        <div class="card-header">
          <h3 class="card-title">Faculty Presence History</h3>
          <span class="result-count" data-role="count">—</span>
        </div>
        <div class="table-toolbar">
          <div class="toolbar-group">
            <span class="toolbar-label">Search</span>
            <input type="search" class="table-search" data-role="search" placeholder="Faculty or room…">
          </div>
          <div class="toolbar-group">
            <span class="toolbar-label">Event</span>
            <select class="table-select" data-role="filter" data-field="status">
              <option value="all">All Events</option>
              <option value="entered">Entered</option>
              <option value="exited">Exited</option>
            </select>
          </div>
          <div class="toolbar-group">
            <span class="toolbar-label">Faculty</span>
            <select class="table-select" data-role="filter" data-field="facultyName">
              <option value="all">All Faculty</option>
              <% presenceNames.forEach(name => { %>
              <option value="<%= name %>"><%= name %></option>
              <% }); %>
            </select>
          </div>
          <div class="toolbar-spacer"></div>
          <button class="btn-header-action" data-role="export" <%= presenceLogs.length ? '' : 'disabled' %>>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export
          </button>
        </div>
        <div class="card-body" style="padding:0">
          <div class="table-scroll">
            <table class="data-table" id="presenceTable">
              <thead>
                <tr>
                  <th>Event</th>
                  <th>Faculty</th>
                  <th>Room</th>
                  <th>Detected</th>
                </tr>
              </thead>
              <tbody data-role="body"></tbody>
            </table>
          </div>
          <div class="no-results" data-role="empty" style="display:none">
            <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
            <p><%= presenceLogs.length ? 'No detection matches your search.' : 'No presence data has been recorded yet. This table fills once the BLE scanners are installed.' %></p>
          </div>
          <div class="pagination-bar">
            <span class="page-info" data-role="pageinfo">—</span>
            <div class="pagination-controls">
              <button class="btn-page" data-role="prev" disabled>Prev</button>
              <button class="btn-page" data-role="next" disabled>Next</button>
            </div>
          </div>
        </div>
      </div>

      <!-- ── Unanswered Requests ── -->
      <div class="content-card report-table" data-table="unanswered" data-subtitle="<%= dean.department %>" hidden>
        <div class="card-header">
          <h3 class="card-title">Unanswered Consultation Requests</h3>
          <span class="result-count" data-role="count">—</span>
        </div>
        <div class="table-toolbar">
          <div class="toolbar-group">
            <span class="toolbar-label">Search</span>
            <input type="search" class="table-search" data-role="search" placeholder="Instructor, student or topic…">
          </div>
          <div class="toolbar-group">
            <span class="toolbar-label">Waiting</span>
            <select class="table-select" data-role="filter" data-field="stale">
              <option value="all">All requests</option>
              <option value="true">Overdue only</option>
              <option value="false">Within the window</option>
            </select>
          </div>
          <div class="toolbar-spacer"></div>
          <button class="btn-header-action" data-role="export" <%= unansweredRequests.length ? '' : 'disabled' %>>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Export
          </button>
        </div>
        <div class="card-body" style="padding:0">
          <div class="table-scroll">
            <table class="data-table" id="unansweredTable">
              <thead>
                <tr>
                  <th>Waiting</th>
                  <th>Instructor</th>
                  <th>Student</th>
                  <th>Topic</th>
                  <th>Consultation</th>
                  <th>Requested</th>
                </tr>
              </thead>
              <tbody data-role="body"></tbody>
            </table>
          </div>
          <div class="no-results" data-role="empty" style="display:none">
            <svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="20 6 9 17 4 12"/></svg>
            <p><%= unansweredRequests.length ? 'No request matches your search.' : 'Every consultation request has been answered.' %></p>
          </div>
          <div class="pagination-bar">
            <span class="page-info" data-role="pageinfo">—</span>
            <div class="pagination-controls">
              <button class="btn-page" data-role="prev" disabled>Prev</button>
              <button class="btn-page" data-role="next" disabled>Next</button>
            </div>
          </div>
        </div>
      </div>

    </div>
  </main>
</div>

<div class="toast-container" id="toastContainer"></div>
<%- include('../../partials/footer') %>
<%- include('../../partials/script') %>
<script>
  window.DEAN_REPORTS = {
    faculty: <%- JSON.stringify(faculty) %>,
    makeupRequests: <%- JSON.stringify(makeupRequests) %>,
    presenceLogs: <%- JSON.stringify(presenceLogs) %>,
    unansweredRequests: <%- JSON.stringify(unansweredRequests) %>,
  };
</script>
<script src="/js/report-table.js?v=<%= assetVersion %>"></script>
<script src="/js/presence-live.js?v=<%= assetVersion %>"></script>
<script src="/js/dean-reports.js?v=<%= assetVersion %>"></script>
