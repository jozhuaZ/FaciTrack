<div class="toast-container" id="toastContainer"></div>
<%- include('../../partials/footer') %>
<%- include('../../partials/script') %>

<script>
// ===== Tab Switching =====
function switchReport(name, btn) {
    document.querySelectorAll('.report-section').forEach(function(s) { s.classList.remove('active'); });
    document.querySelectorAll('.report-tab').forEach(function(t) { t.classList.remove('active'); });
    var section = document.getElementById('section-' + name);
    if (section) section.classList.add('active');
    if (btn) btn.classList.add('active');
}

// ===== Data =====
var ALL_APPOINTMENTS = <%- JSON.stringify(typeof allAppointments !== 'undefined' ? allAppointments : []) %>;
var ALL_FACULTY      = <%- JSON.stringify(typeof faculty !== 'undefined' ? faculty : []) %>;
var PAGE = 20;

// ===== Helpers =====
function esc(s) {
    return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function emptyRow(cols, msg) {
    return '<tr><td colspan="' + cols + '">'
        + '<div class="empty-state">'
        + '<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>'
        + '<p>' + esc(msg) + '</p>'
        + '</div></td></tr>';
}

function badgeHtml(status) {
    var map = { pending:'pending', confirmed:'confirmed', declined:'declined', rescheduled:'workload', completed:'presence', cancelled:'declined' };
    return '<span class="table-badge ' + (map[status] || 'pending') + '">' + esc(status) + '</span>';
}

function renderPagination(idPrev, idNext, idInfo, idBar, page, total) {
    var pages = Math.max(1, Math.ceil(total / PAGE));
    var bar = document.getElementById(idBar);
    var info = document.getElementById(idInfo);
    var prev = document.getElementById(idPrev);
    var next = document.getElementById(idNext);
    if (!bar) return;
    if (total === 0) { bar.style.display = 'none'; return; }
    bar.style.display = 'flex';
    var start = (page - 1) * PAGE + 1;
    var end = Math.min(page * PAGE, total);
    if (info) info.textContent = 'Showing ' + start + '-' + end + ' of ' + total;
    if (prev) prev.disabled = (page <= 1);
    if (next) next.disabled = (page >= pages);
}

// ===== Appointments =====
var aptPage = 1, aptPeriod = 'all', aptStatus = 'all', aptSearch = '';

function filterApt() {
    var rows = ALL_APPOINTMENTS.slice();
    if (aptStatus !== 'all') rows = rows.filter(function(a) { return a.status === aptStatus; });
    if (aptSearch) {
        var q = aptSearch.toLowerCase();
        rows = rows.filter(function(a) {
            return (a.studentName || '').toLowerCase().indexOf(q) >= 0
                || (a.instructorName || '').toLowerCase().indexOf(q) >= 0
                || (a.topic || '').toLowerCase().indexOf(q) >= 0;
        });
    }
    return rows;
}

function renderAptTable() {
    var tbody = document.getElementById('aptReportBody');
    if (!tbody) return;
    var rows = filterApt();
    if (rows.length === 0) {
        tbody.innerHTML = emptyRow(6, 'No Appointment records found');
        renderPagination('aptReportPrev', 'aptReportNext', 'aptReportPageInfo', 'aptReportPagBar', aptPage, 0);
        return;
    }
    var pages = Math.max(1, Math.ceil(rows.length / PAGE));
    if (aptPage > pages) aptPage = pages;
    var start = (aptPage - 1) * PAGE;
    tbody.innerHTML = rows.slice(start, start + PAGE).map(function(a) {
        return '<tr>'
            + '<td><div style="display:flex;align-items:center;gap:.5rem">'
            + '<div class="apt-avatar-xs" style="width:32px;height:32px;font-size:.625rem;flex-shrink:0">' + esc((a.studentName||'?').split(' ').map(function(n){return n[0]||'';}).join('').slice(0,2).toUpperCase()) + '</div>'
            + '<span style="font-weight:600;font-size:.875rem">' + esc(a.studentName) + '</span></div></td>'
            + '<td style="font-size:.875rem">' + esc(a.instructorName) + '</td>'
            + '<td style="font-size:.875rem;white-space:nowrap">' + esc(a.date) + '</td>'
            + '<td style="font-size:.875rem;white-space:nowrap">' + esc(a.time) + '</td>'
            + '<td style="font-size:.875rem;max-width:200px;white-space:normal">' + esc(a.topic) + '</td>'
            + '<td>' + badgeHtml(a.status) + '</td>'
            + '</tr>';
    }).join('');
    renderPagination('aptReportPrev', 'aptReportNext', 'aptReportPageInfo', 'aptReportPagBar', aptPage, rows.length);
}

document.getElementById('aptReportPrev').addEventListener('click', function() { if (aptPage > 1) { aptPage--; renderAptTable(); } });
document.getElementById('aptReportNext').addEventListener('click', function() { if (aptPage < Math.ceil(filterApt().length / PAGE)) { aptPage++; renderAptTable(); } });

// ===== Student Appointment Logs =====
var salPage = 1, salStatus = 'all', salSearch = '';

function filterSal() {
    var rows = ALL_APPOINTMENTS.slice();
    if (salStatus !== 'all') rows = rows.filter(function(a) { return a.status === salStatus; });
    if (salSearch) {
        var q = salSearch.toLowerCase();
        rows = rows.filter(function(a) {
            return (a.studentName || '').toLowerCase().indexOf(q) >= 0
                || (a.topic || '').toLowerCase().indexOf(q) >= 0;
        });
    }
    return rows;
}

function renderSalTable() {
    var tbody = document.getElementById('salReportBody');
    if (!tbody) return;
    var rows = filterSal();
    if (rows.length === 0) {
        tbody.innerHTML = emptyRow(7, 'No Student Appointment Log records found');
        renderPagination('salReportPrev', 'salReportNext', 'salReportPageInfo', 'salReportPagBar', salPage, 0);
        return;
    }
    var pages = Math.max(1, Math.ceil(rows.length / PAGE));
    if (salPage > pages) salPage = pages;
    var start = (salPage - 1) * PAGE;
    tbody.innerHTML = rows.slice(start, start + PAGE).map(function(a) {
        return '<tr>'
            + '<td><div style="display:flex;align-items:center;gap:.5rem">'
            + '<div class="apt-avatar-xs" style="width:32px;height:32px;font-size:.625rem;flex-shrink:0">' + esc((a.studentName||'?').split(' ').map(function(n){return n[0]||'';}).join('').slice(0,2).toUpperCase()) + '</div>'
            + '<span style="font-weight:600;font-size:.875rem">' + esc(a.studentName) + '</span></div></td>'
            + '<td style="font-size:.875rem">' + esc(a.instructorName) + '</td>'
            + '<td style="font-size:.875rem;white-space:nowrap">' + esc(a.date) + '</td>'
            + '<td style="font-size:.875rem;white-space:nowrap">' + esc(a.time) + '</td>'
            + '<td style="font-size:.875rem;max-width:200px;white-space:normal">' + esc(a.topic) + '</td>'
            + '<td>' + badgeHtml(a.status) + '</td>'
            + '<td style="font-size:.875rem">' + esc(a.mode || '—') + '</td>'
            + '</tr>';
    }).join('');
    renderPagination('salReportPrev', 'salReportNext', 'salReportPageInfo', 'salReportPagBar', salPage, rows.length);
}

document.getElementById('salReportPrev').addEventListener('click', function() { if (salPage > 1) { salPage--; renderSalTable(); } });
document.getElementById('salReportNext').addEventListener('click', function() { if (salPage < Math.ceil(filterSal().length / PAGE)) { salPage++; renderSalTable(); } });

// ===== Faculty Workload =====
var fcwPage = 1, fcwSearch = '', fcwStatus = 'all';

function buildFcwRows() {
    // Group appointments by instructor
    var map = {};
    ALL_APPOINTMENTS.forEach(function(a) {
        var name = a.instructorName || 'Unknown';
        if (!map[name]) map[name] = { name: name, position: a.instructorPosition || '—', department: a.department || '—', total: 0, confirmed: 0, pending: 0, declined: 0 };
        map[name].total++;
        if (a.status === 'confirmed') map[name].confirmed++;
        else if (a.status === 'pending') map[name].pending++;
        else if (a.status === 'declined') map[name].declined++;
    });
    // Also include faculty with no appointments
    ALL_FACULTY.forEach(function(f) {
        var name = f.instructorName || f.name || 'Unknown';
        if (!map[name]) map[name] = { name: name, position: f.position || '—', department: f.department_name || f.department || '—', total: 0, confirmed: 0, pending: 0, declined: 0 };
        else {
            if (!map[name].position || map[name].position === '—') map[name].position = f.position || '—';
            if (!map[name].department || map[name].department === '—') map[name].department = f.department_name || f.department || '—';
        }
    });
    return Object.values(map);
}

function filterFcw() {
    var rows = buildFcwRows();
    if (fcwStatus === 'confirmed') rows = rows.filter(function(r) { return r.confirmed > 0; });
    if (fcwStatus === 'pending')   rows = rows.filter(function(r) { return r.pending > 0; });
    if (fcwSearch) {
        var q = fcwSearch.toLowerCase();
        rows = rows.filter(function(r) { return r.name.toLowerCase().indexOf(q) >= 0; });
    }
    return rows;
}

function renderFcwTable() {
    var tbody = document.getElementById('fcwReportBody');
    if (!tbody) return;
    var rows = filterFcw();
    if (rows.length === 0) {
        tbody.innerHTML = emptyRow(7, 'No Faculty Workload records found');
        renderPagination('fcwReportPrev', 'fcwReportNext', 'fcwReportPageInfo', 'fcwReportPagBar', fcwPage, 0);
        return;
    }
    var pages = Math.max(1, Math.ceil(rows.length / PAGE));
    if (fcwPage > pages) fcwPage = pages;
    var start = (fcwPage - 1) * PAGE;
    tbody.innerHTML = rows.slice(start, start + PAGE).map(function(r) {
        return '<tr>'
            + '<td style="font-weight:600;font-size:.875rem">' + esc(r.name) + '</td>'
            + '<td style="font-size:.875rem">' + esc(r.position) + '</td>'
            + '<td style="font-size:.875rem">' + esc(r.department) + '</td>'
            + '<td style="text-align:center;font-weight:600">' + r.total + '</td>'
            + '<td style="text-align:center"><span class="table-badge confirmed">' + r.confirmed + '</span></td>'
            + '<td style="text-align:center"><span class="table-badge pending">' + r.pending + '</span></td>'
            + '<td style="text-align:center"><span class="table-badge declined">' + r.declined + '</span></td>'
            + '</tr>';
    }).join('');
    renderPagination('fcwReportPrev', 'fcwReportNext', 'fcwReportPageInfo', 'fcwReportPagBar', fcwPage, rows.length);
}

document.getElementById('fcwReportPrev').addEventListener('click', function() { if (fcwPage > 1) { fcwPage--; renderFcwTable(); } });
document.getElementById('fcwReportNext').addEventListener('click', function() { if (fcwPage < Math.ceil(filterFcw().length / PAGE)) { fcwPage++; renderFcwTable(); } });

// ===== Filter-bar events =====
document.addEventListener('fbChange', function(e) {
    if (!e.detail) return;
    var id = e.detail.filterId, key = e.detail.section, val = e.detail.value;
    if (id === 'apt') {
        if (key === 'status') { aptStatus = val; aptPage = 1; renderAptTable(); }
        if (key === 'period') { aptPeriod = val; aptPage = 1; renderAptTable(); }
    }
    if (id === 'sal') {
        if (key === 'status') { salStatus = val; salPage = 1; renderSalTable(); }
        if (key === 'period') { salPeriod = val; salPage = 1; renderSalTable(); }
    }
    if (id === 'fcw') {
        if (key === 'status') { fcwStatus = val; fcwPage = 1; renderFcwTable(); }
    }
});
document.addEventListener('fbSearch', function(e) {
    if (!e.detail) return;
    if (e.detail.filterId === 'apt') { aptSearch = e.detail.value; aptPage = 1; renderAptTable(); }
    if (e.detail.filterId === 'sal') { salSearch = e.detail.value; salPage = 1; renderSalTable(); }
    if (e.detail.filterId === 'fcw') { fcwSearch = e.detail.value; fcwPage = 1; renderFcwTable(); }
});

// ===== Initial Render =====
renderAptTable();
renderSalTable();
renderFcwTable();

// ===== Print Helper =====
function preparePrintReport(btn) {
    var preview = btn.closest('.report-preview');
    if (!preview) return;
    preview.querySelectorAll('.report-header-block').forEach(function(hdr) {
        var existing = hdr.querySelector('.print-header-inner');
        if (existing) existing.remove();
        var titleEl    = hdr.querySelector('.report-title-block');
        var subtitleEl = hdr.querySelector('.report-subtitle');
        var imgEl      = hdr.querySelector('img');
        var title    = titleEl    ? titleEl.textContent.trim() : '';
        var subtitle = subtitleEl ? subtitleEl.textContent.trim() : '';
        var imgSrc   = imgEl      ? imgEl.src : '/images/CSPC-logo.png';
        var inner = document.createElement('div');
        inner.className = 'print-header-inner';
        inner.innerHTML =
            '<img src="' + imgSrc + '" alt="CSPC Logo">'
            + '<div class="print-header-text">'
            + '<span class="ph-republic">Republic of the Philippines</span>'
            + '<span class="ph-institution">Camarines Sur Polytechnic Colleges</span>'
            + '<span class="ph-address">Nabua, Camarines Sur</span>'
            + '<span class="ph-title">' + title + '</span>'
            + '<span class="ph-subtitle">' + subtitle + '</span>'
            + '</div>';
        hdr.appendChild(inner);
    });
    document.body.classList.add('print-mode');
    preview.classList.add('print-only');
    setTimeout(function() {
        window.print();
        setTimeout(function() {
            preview.classList.remove('print-only');
            document.body.classList.remove('print-mode');
            preview.querySelectorAll('.print-header-inner').forEach(function(el) { el.remove(); });
        }, 500);
    }, 50);
}
</script>
