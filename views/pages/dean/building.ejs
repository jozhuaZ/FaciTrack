<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/instructor/dashboard.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/ccs-building-style.css?v=<%= assetVersion %>">

<style>
.building-3d-page { padding: 2rem; }
@media (max-width:768px){ .building-3d-page{ padding:1rem; } }
</style>

<div class="instructor-layout">
  <%- include('../../partials/dean-sidebar', { activePage: 'building' }) %>

  <main class="instructor-main">
    <div class="main-container building-3d-page">

      <div style="margin-bottom:1.25rem">
        <h1 class="page-title">3D Building Viewer</h1>
        <p class="page-subtitle">CSPC Academic Building IV</p>
      </div>

      <div class="content-card" style="padding:1.25rem 1.25rem 1rem">

        <!-- 3D Canvas -->
        <div id="ccs-canvas-wrap">

          <!-- Loading overlay -->
          <div id="ccs-loading">
            <div class="ccs-spinner"></div>
            <p class="ccs-loading-text">Loading building…</p>
          </div>

          <!-- Toolbar: search + view buttons + reset -->
          <div id="ccs-toolbar">
            <div class="ccs-search-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:14px;height:14px;flex-shrink:0">
                <circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="22" y2="22"/>
              </svg>
              <input id="ccs-search-input" type="text" placeholder="Search room (e.g. Mac Lab)" autocomplete="off" spellcheck="false"/>
            </div>
            <button class="ccs-floor-btn" id="ccs-btn-front">Front View</button>
            <button class="ccs-floor-btn" id="ccs-btn-top">Top View</button>
            <button class="ccs-floor-btn" id="ccs-btn-left">Left-Side View</button>
            <button class="ccs-floor-btn" id="ccs-btn-right">Right-Side View</button>
            <button id="ccs-btn-reset-overlay">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:13px;height:13px">
                <polyline points="1 4 1 10 7 10"/>
                <path d="M3.51 15a9 9 0 1 0 .49-4.9"/>
              </svg>
              Reset View
            </button>
          </div>

          <!-- Zoom buttons -->
          <div id="ccs-zoom-cluster">
            <button class="ccs-zoom-btn" id="ccs-btn-zoom-in">+</button>
            <button class="ccs-zoom-btn" id="ccs-btn-zoom-out">−</button>
          </div>

          <!-- Hints bar -->
          <div id="ccs-hints">
            <span><span class="ccs-hint-key">Drag</span> rotate</span>
            <span class="ccs-hint-sep">·</span>
            <span><span class="ccs-hint-key">Scroll</span> zoom</span>
            <span class="ccs-hint-sep">·</span>
            <span><span class="ccs-hint-key">Right-drag</span> pan</span>
            <span class="ccs-hint-sep">·</span>
            <span><span class="ccs-hint-key">Hover room</span> info</span>
          </div>

          <!-- Room info panel (2nd + 3rd floor rooms) -->
          <div id="ccs-room-panel" class="rp-hidden">
            <div class="rp-header">
              <span class="rp-badge" id="rp-id">—</span>
              <button class="rp-close" id="room-panel-close" aria-label="Close">&#x2715;</button>
            </div>
            <div class="rp-body">
              <div class="rp-field">
                <span class="rp-label">Room</span>
                <span class="rp-value" id="rp-name">—</span>
              </div>
              <div class="rp-divider"></div>
              <div class="rp-field">
                <span class="rp-label">Floor</span>
                <span class="rp-value" id="rp-floor">—</span>
              </div>
              <div class="rp-divider"></div>
              <div class="rp-field">
                <span class="rp-label">College</span>
                <span class="rp-value">College of Computer Studies</span>
              </div>
            </div>
          </div>

        </div><!-- /#ccs-canvas-wrap -->

      </div><!-- /.content-card -->

      <!-- Room register table -->
      <div class="content-card" style="margin-top:1.5rem">
        <div class="card-header">
          <h3 class="card-title">Rooms in <%= dean.department %></h3>
          <span style="font-size:.78rem;color:var(--gray-500);font-weight:600"><%= rooms.length %> room<%= rooms.length===1?'':'s' %></span>
        </div>
        <div class="card-body" style="padding:0">
          <% if(!rooms.length){ %>
          <div style="display:flex;flex-direction:column;align-items:center;gap:.5rem;padding:2.5rem 1rem;text-align:center">
            <p style="font-size:.8125rem;color:var(--gray-500);margin:0">No rooms registered yet.</p>
          </div>
          <% } else { %>
          <div style="overflow-x:auto">
            <table class="data-table">
              <thead><tr><th>Room</th><th>Type</th><th>Capacity</th><th>Faculty</th><th>Scanner</th><th>Status</th></tr></thead>
              <tbody>
                <% rooms.forEach(r=>{ %>
                <tr>
                  <td style="font-weight:600;font-size:.875rem;color:var(--gray-900)"><%= r.room_number %></td>
                  <td style="font-size:.8125rem;color:var(--gray-600)"><%= r.room_type %></td>
                  <td style="font-size:.8125rem"><%= r.capacity||'—' %></td>
                  <td style="font-size:.8125rem"><%= r.assigned_faculty_name||'—' %></td>
                  <td><span class="table-badge <%= r.is_ble_scanner_installed?'confirmed':'' %>"><%= r.is_ble_scanner_installed?'Installed':'Not installed' %></span></td>
                  <td><span class="table-badge <%= r.status==='Active'?'confirmed':'declined' %>"><%= r.status %></span></td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>
      </div>

    </div>
  </main>
</div>

<%- include('../../partials/footer') %>
<%- include('../../partials/script') %>

<!-- Three.js r128 -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>

<!-- Building modules -->
<script src="/js/ccs-building-scene.js?v=<%= assetVersion %>"></script>
<script src="/js/ccs-building-camera.js?v=<%= assetVersion %>"></script>
<script src="/js/ccs-building-loader.js?v=<%= assetVersion %>"></script>
<script src="/js/ccs-building-interactions.js?v=<%= assetVersion %>"></script>

<script>
(function(){
  'use strict';

  function hide(){
    var el = document.getElementById('ccs-loading');
    if (!el) return;
    // Force hide immediately — no transition delay
    el.style.transition = 'none';
    el.style.opacity    = '0';
    el.style.display    = 'none';
    el.style.visibility = 'hidden';
    el.style.pointerEvents = 'none';
  }

  // Boot — wrapped in try/catch so errors don't silently prevent loading
  try { ccsBoot(); } catch(e) { console.error('ccsBoot failed:', e); }
  try { ccsCameraInit(); } catch(e) { console.error('ccsCameraInit failed:', e); }

  var _b = null, _pulse = 0;

  function loop() {
    requestAnimationFrame(loop);
    try {
      _pulse += ccsClock.getDelta();
      if (typeof ccsCameraUpdateTransition === 'function') ccsCameraUpdateTransition();
      if (ccsControls) ccsControls.update();
      if (ccsRenderer && ccsScene && ccsCamera) ccsRenderer.render(ccsScene, ccsCamera);
    } catch(e) { /* keep running */ }
  }
  loop();

  // Load building
  ccsBuildingCreate().then(function(b){
    _b = b;
    try { ccsInteractionsInit(b); } catch(e) { console.warn('[interactions]', e); }
    hide();
  }).catch(function(e){
    console.error('[build]', e);
    hide();
  });

  // Hard hide after 3 seconds — show whatever is rendered
  setTimeout(hide, 3000);

  // Zoom buttons
  document.getElementById('ccs-btn-zoom-in').addEventListener('click',function(){
    var d=new THREE.Vector3().subVectors(ccsControls.target,ccsCamera.position).normalize();
    ccsCamera.position.addScaledVector(d,5);
    ccsControls.update();
  });
  document.getElementById('ccs-btn-zoom-out').addEventListener('click',function(){
    var d=new THREE.Vector3().subVectors(ccsControls.target,ccsCamera.position).normalize();
    ccsCamera.position.addScaledVector(d,-5);
    ccsControls.update();
  });

})();
</script>
