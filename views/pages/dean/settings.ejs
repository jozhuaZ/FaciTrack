<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/instructor/dashboard.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/settings-chrome.css?v=<%= assetVersion %>">
<style>
.settings-grid { display:grid; grid-template-columns:360px 1fr; gap:1.5rem; align-items:start; }
@media(max-width:1100px){ .settings-grid { grid-template-columns:1fr; } }
.profile-card-top { position:relative; display:flex; flex-direction:column; align-items:center; padding:2rem 1.5rem 1.5rem; border-bottom:1px solid var(--gray-100); text-align:center; }
.settings-avatar-wrap { position:relative; width:88px; height:88px; margin-bottom:1rem; }
.settings-avatar-wrap .profile-avatar-mini { width:88px; height:88px; font-size:1.75rem; }
.settings-avatar-wrap .avatar-upload-overlay { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,.45); border-radius:50%; opacity:0; transition:opacity .2s; cursor:pointer; color:#fff; }
.settings-avatar-wrap:hover .avatar-upload-overlay { opacity:1; }
.settings-name  { font-size:1.0625rem; font-weight:700; color:var(--gray-900); margin:0 0 .2rem; }
.settings-email { font-size:.8125rem; color:var(--gray-500); margin:0 0 .25rem; }
.settings-dept  { font-size:.75rem; color:var(--primary-blue); font-weight:600; margin:0; }
.settings-right { display:flex; flex-direction:column; gap:1.5rem; }
.settings-toggle-row { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:.875rem; border:1px solid var(--gray-200); border-radius:var(--radius-md); background:#fff; transition:border-color .2s,background .2s; }
.settings-toggle-row:hover { border-color:var(--primary-blue); background:rgba(10,61,98,.02); }
.settings-toggle-list { display:flex; flex-direction:column; gap:.625rem; }
.toggle-label { font-size:.875rem; font-weight:600; color:var(--gray-900); margin:0 0 .125rem; }
.toggle-desc  { font-size:.75rem; color:var(--gray-500); margin:0; line-height:1.4; }
.toggle-switch { position:relative; width:44px; height:24px; flex-shrink:0; }
.toggle-switch input { opacity:0; width:0; height:0; position:absolute; }
.toggle-slider { position:absolute; cursor:pointer; inset:0; background:var(--gray-300); border-radius:24px; transition:.3s; }
.toggle-slider:before { content:''; position:absolute; width:18px; height:18px; left:3px; bottom:3px; background:#fff; border-radius:50%; transition:.3s; box-shadow:0 1px 4px rgba(0,0,0,.2); }
input:checked + .toggle-slider { background:var(--primary-blue); }
input:checked + .toggle-slider:before { transform:translateX(20px); }
.field-note { font-size:.7rem; color:var(--gray-400); margin:.3rem 0 0; line-height:1.4; }
.modal-input[readonly] { background:var(--gray-50); color:var(--gray-500); cursor:not-allowed; }
</style>

<div class="instructor-layout">
  <%- include('../../partials/dean-sidebar', { activePage: 'settings' }) %>
  <main class="instructor-main">
    <div class="main-container">

      <div class="page-header">
        <div>
          <h1 class="page-title">Settings</h1>
          <p class="page-subtitle">Manage your profile and notification preferences</p>
        </div>
      </div>

      <div class="settings-grid">

        <!-- LEFT: Profile and security -->
        <div style="display:flex;flex-direction:column;gap:1.5rem;">

          <div class="content-card settings-card" data-card="profile">
            <div class="profile-card-top">
              <span class="unsaved-pill">Unsaved</span>
              <% const avatarInitials = dean.name.split(' ').map(n=>n[0]).join(''); %>
              <div class="settings-avatar-wrap">
                <%# data-initials so the host still knows its fallback while a photo covers it %>
                <div class="profile-avatar-mini" id="settingsAvatar" data-initials="<%= avatarInitials %>">
                  <% if (dean.profilePhoto) { %>
                    <img src="<%= dean.profilePhoto %>" alt="<%= dean.name %>" class="avatar-img">
                  <% } else { %>
                    <span class="avatar-initials"><%= avatarInitials %></span>
                  <% } %>
                  <label class="avatar-upload-overlay" title="Change photo">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                    <input type="file" id="settingsAvatarInput" accept="image/*" style="display:none;" data-no-track>
                  </label>
                </div>
                <%# Sibling of the avatar, not a child: .profile-avatar-mini is
                    overflow:hidden to keep the photo circular, which would clip
                    a corner badge. The wrap is the 88px positioned box. %>
                <button type="button" class="btn-avatar-remove" id="settingsAvatarRemove"
                        title="Remove photo" aria-label="Remove photo" data-no-track
                        <% if (!dean.profilePhoto) { %>style="display:none"<% } %>>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
              </div>
              <p class="settings-name"><%= dean.name %></p>
              <p class="settings-email"><%= dean.email %></p>
              <p class="settings-dept"><%= dean.department %></p>
            </div>
            <div class="card-body">
              <%# Split into the three columns the server actually stores, rather
                  than one field that would have to be guessed apart on save %>
              <div class="form-group">
                <label class="modal-label">First Name</label>
                <input type="text" class="modal-input" id="inputFirstName" value="<%= dean.firstName %>">
              </div>
              <div class="form-group">
                <label class="modal-label">Middle Name <span style="font-weight:400;color:var(--gray-400)">(optional)</span></label>
                <input type="text" class="modal-input" id="inputMiddleName" value="<%= dean.middleName %>">
              </div>
              <div class="form-group">
                <label class="modal-label">Last Name</label>
                <input type="text" class="modal-input" id="inputLastName" value="<%= dean.lastName %>">
              </div>
              <div class="form-group">
                <label class="modal-label">Email Address</label>
                <input type="email" class="modal-input" id="inputEmail" value="<%= dean.email %>" readonly data-no-track>
                <p class="field-note">Your email is your sign-in identity. An administrator changes it for you.</p>
              </div>
            </div>
          </div>

          <%# Security stays outside the tracker: a password is confirmed and
              submitted on its own, never swept up in a bulk save %>
          <div class="content-card">
            <div class="card-header"><h3 class="card-title">Security</h3></div>
            <div class="card-body">
              <div class="form-group">
                <label class="modal-label">Current Password</label>
                <input type="password" class="modal-input" id="inputCurrentPw" autocomplete="current-password" data-no-track>
              </div>
              <div class="form-group">
                <label class="modal-label">New Password</label>
                <input type="password" class="modal-input" id="inputNewPw" autocomplete="new-password" data-no-track>
              </div>
              <div class="form-group">
                <label class="modal-label">Confirm New Password</label>
                <input type="password" class="modal-input" id="inputConfirmPw" autocomplete="new-password" data-no-track>
              </div>
              <button class="btn-save-settings" id="btnChangePassword">Update Password</button>
            </div>
          </div>

        </div>

        <!-- RIGHT: Preferences -->
        <div class="settings-right">

          <div class="content-card settings-card" data-card="notifications">
            <div class="card-header">
              <h3 class="card-title">Notification Preferences</h3>
              <span class="unsaved-pill">Unsaved</span>
            </div>
            <div class="card-body">
              <div class="settings-toggle-list">
                <div class="settings-toggle-row">
                  <div>
                    <p class="toggle-label">Make-Up Request Alerts</p>
                    <p class="toggle-desc">Email and device alerts when an instructor submits a make-up class request</p>
                  </div>
                  <label class="toggle-switch">
                    <input type="checkbox" id="prefMakeup" <%= prefs.notifyNewRequests ? 'checked' : '' %>>
                    <span class="toggle-slider"></span>
                  </label>
                </div>
                <div class="settings-toggle-row">
                  <div>
                    <p class="toggle-label">System Announcements</p>
                    <p class="toggle-desc">Maintenance windows and system-wide notices</p>
                  </div>
                  <label class="toggle-switch">
                    <input type="checkbox" id="prefAnnouncements" <%= prefs.notifyAnnouncements ? 'checked' : '' %>>
                    <span class="toggle-slider"></span>
                  </label>
                </div>
              </div>
              <p class="field-note">These control email and device notifications only. The in-app bell always shows everything, so nothing needing your decision can be muted out of sight.</p>
            </div>
          </div>

          <div class="content-card settings-card" data-card="report">
            <div class="card-header">
              <h3 class="card-title">Report Settings</h3>
              <span class="unsaved-pill">Unsaved</span>
            </div>
            <div class="card-body">
              <div class="form-group">
                <label class="modal-label">Default Report Period</label>
                <select class="modal-input" id="defaultPeriod">
                  <option value="week">This Week</option>
                  <option value="month" selected>This Month</option>
                  <option value="all">All Time</option>
                </select>
              </div>
              <div class="form-group">
                <label class="modal-label">Report Header — College Name</label>
                <input type="text" class="modal-input" id="reportCollege" value="<%= dean.department %>">
              </div>
              <div class="form-group">
                <label class="modal-label">Dean's Name (for report signature)</label>
                <input type="text" class="modal-input" id="reportDeanName" value="<%= dean.name %>">
              </div>
              <p class="field-note">Saved in this browser and applied to reports you export from this device.</p>
            </div>
          </div>

        </div>
      </div>

      <!-- Unsaved-changes bar -->
      <div class="dirty-bar" id="dirtyBar">
        <div class="dirty-bar-inner">
          <div>
            <p class="dirty-bar-text" id="dirtyBarText">You have unsaved changes.</p>
            <p class="dirty-bar-sub">They will be lost if you leave this page.</p>
          </div>
          <div class="dirty-bar-actions">
            <button type="button" class="btn-discard" id="btnDiscardAll">Discard</button>
            <button type="button" class="btn-save-all" id="btnSaveAll">Save all changes</button>
          </div>
        </div>
      </div>

    </div>
  </main>
</div>

<!-- Leave confirmation, for in-app navigation -->
<div class="modal-overlay" id="leaveOverlay">
  <div class="modal-content" style="max-width:420px;">
    <div class="modal-header">
      <h3 class="modal-title">Unsaved changes</h3>
    </div>
    <div class="modal-body">
      <p style="font-size:.875rem;color:var(--gray-600);line-height:1.65;margin:0;" id="leaveBody">
        You have unsaved changes on this page. What would you like to do?
      </p>
      <div class="leave-modal-actions">
        <button type="button" class="btn-modal btn-cancel" id="leaveStay">Stay on page</button>
        <button type="button" class="btn-modal btn-cancel" id="leaveDiscard">Leave without saving</button>
        <button type="button" class="btn-modal btn-primary" id="leaveSave">Save &amp; leave</button>
      </div>
    </div>
  </div>
</div>

<div class="toast-container" id="toastContainer"></div>
<%- include('../../partials/footer') %>
<%- include('../../partials/script') %>
<script>
  // Preferences this page does not surface. They are round-tripped so saving
  // the notifications card cannot silently clear settings it never showed.
  window.DEAN_CARRIED_PREFS = <%- JSON.stringify({
      notifyCancellations: prefs.notifyCancellations,
      notifyReminders: prefs.notifyReminders,
      notifyBleAbsence: prefs.notifyBleAbsence,
  }) %>;
</script>
<script src="/js/settings-tracker.js?v=<%= assetVersion %>"></script>
<script src="/js/dean-settings.js?v=<%= assetVersion %>"></script>
