<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/instructor/dashboard.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/instructor/makeup.css?v=<%= assetVersion %>">

<%
  function fmtDate(value) {
    return new Date(String(value).slice(0, 10) + 'T00:00:00')
      .toLocaleDateString('en-PH', { month: 'long', day: 'numeric', year: 'numeric' });
  }

  // Everything the search box should be able to match, built once per card
  function haystack(r) {
    return [
      r.first_name, r.last_name, r.position || '', r.status,
      r.reason || '', r.decline_reason || '', r.dean_statement || '',
      fmtDate(r.submitted_at),
      r.sessions.map(function (s) {
        return [s.subject_code, s.subject_name, s.section_name, s.class_type,
                s.room_number || 'online', fmtDate(s.class_date), s.timeLabel].join(' ');
      }).join(' ')
    ].join(' ').toLowerCase();
  }

  const allRequests = pending.concat(approved, declined);
%>

<div class="instructor-layout">
  <%- include('../../partials/dean-sidebar', { activePage: 'makeup', pendingMakeupCount: pendingMakeupCount }) %>
  <main class="instructor-main">
    <div class="main-container">

      <div class="page-header">
        <div>
          <h1 class="page-title">Make-Up Class Requests</h1>
          <p class="page-subtitle">Requests from instructors in your department, awaiting your decision.</p>
        </div>
        <% if (pending.length) { %>
          <div class="header-actions">
            <button type="button" class="btn-save-settings" id="mkApproveAll">
              Approve all (<%= pending.length %>)
            </button>
          </div>
        <% } %>
      </div>

      <% if (flash) { %>
        <div class="mk-flash <%= flash.type %>"><%= flash.message %></div>
      <% } %>

      <div class="mk-filter-bar">
        <div class="mk-search-wrap">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path>
          </svg>
          <input type="search" id="mkSearch" class="mk-search-input"
                 placeholder="Search instructor, subject, room or date" aria-label="Search requests">
          <button type="button" id="mkSearchClear" class="mk-search-clear" hidden aria-label="Clear search">&times;</button>
        </div>

        <select class="mk-filter-select" id="mkStatusFilter" aria-label="Filter by status">
          <option value="all">All Statuses</option>
          <option value="pending">Pending</option>
          <option value="approved">Approved</option>
          <option value="declined">Declined</option>
        </select>

        <select class="mk-filter-select" id="mkTypeFilter" aria-label="Filter by class type">
          <option value="all">All Class Types</option>
          <option value="lecture">Lecture</option>
          <option value="laboratory">Laboratory</option>
          <option value="online">Online</option>
        </select>
      </div>

      <p class="mk-empty" id="mkFilterEmpty" hidden></p>

      <% allRequests.forEach(function (r) { %>
        <%
          var classTypes = r.sessions.map(function(s){ return (s.class_type || '').toLowerCase(); })
                            .filter(function(t,i,a){ return t && a.indexOf(t)===i; });
        %>
        <div class="mk-req" id="req-<%= r.id %>"
             data-status="<%= r.status %>"
             data-class-type="<%= classTypes.join(' ') %>"
             data-search="<%= haystack(r) %>">
          <div class="mk-req-head">
            <div>
              <p class="mk-req-who"><%= r.first_name %> <%= r.last_name %><% if (r.position) { %> · <%= r.position %><% } %></p>
              <p class="mk-req-when">
                <%= r.sessions.length %> session<%= r.sessions.length === 1 ? '' : 's' %> ·
                submitted <%= fmtDate(r.submitted_at) %>
              </p>
            </div>
            <span class="mk-status <%= r.status %>"><%= r.status %></span>
          </div>

          <div class="mk-req-body">
            <% r.sessions.forEach(function (s) { %>
              <div class="mk-session-line">
                <strong><%= s.subject_code %></strong>
                <span><%= s.section_name %></span>
                <% if (s.class_type) { %><span class="mk-chip"><%= s.class_type %></span><% } %>
                <span><%= fmtDate(s.class_date) %> · <%= s.timeLabel %></span>
                <% if (s.delivery_mode === 'online') { %>
                  <span class="mk-venue online">Online</span>
                <% } else { %>
                  <span class="mk-venue room"><%= s.room_number || 'Room TBA' %></span>
                <% } %>
              </div>
            <% }); %>

            <% if (r.reason) { %>
              <p class="mk-note reason"><strong>Reason:</strong> <%= r.reason %></p>
            <% } %>
            <% if (!r.supportDocuments.length) { %>
              <p class="mk-note decline"><strong>Missing:</strong> no supporting document attached.</p>
            <% } %>
            <% if (!r.pollingDocument) { %>
              <p class="mk-note warn">No polling document attached.</p>
            <% } %>
            <% if (r.status === 'declined' && r.decline_reason) { %>
              <p class="mk-note decline"><strong>You declined:</strong> <%= r.decline_reason %></p>
            <% } %>
            <% if (r.status === 'approved' && r.dean_statement) { %>
              <p class="mk-note dean"><strong>Your note:</strong> <%= r.dean_statement %></p>
            <% } %>
          </div>

          <div class="mk-req-actions">
            <% if (!r.documents.length) { %>
              <span class="mk-btn doc is-muted">No documents</span>
            <% } %>
            <% r.documents.forEach(function (d) { %>
              <a class="mk-btn doc" href="/dean/makeup/document/<%= d.id %>" target="_blank" rel="noopener">
                <%= d.kind === 'polling' ? 'Polling sheet' : d.original_name %>
              </a>
            <% }); %>
            <% if (r.status === 'pending') { %>
              <button type="button" class="mk-btn approve" data-approve="<%= r.id %>">Approve</button>
              <button type="button" class="mk-btn decline" data-decline="<%= r.id %>">Decline</button>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  </main>
</div>

<!-- Decision modal, used for both outcomes.
     Both modals here handle their own backdrop taps — a finished bulk run has
     to refresh the page — so they opt out of the global handler in main.js. -->
<div class="modal-overlay" id="mkDecideModal" data-backdrop-close="manual">
  <div class="modal-content" style="max-width:460px;">
    <div class="modal-header">
      <h3 class="modal-title" id="mkDecideTitle">Approve request</h3>
      <button class="modal-close" type="button" id="mkDecideClose">&times;</button>
    </div>
    <div class="modal-body">
      <p style="font-size:.85rem;color:var(--gray-600);line-height:1.6;margin:0 0 1rem;" id="mkDecideBody"></p>
      <label class="modal-label" for="mkDecideText" id="mkDecideLabel">Note to the instructor</label>
      <textarea class="modal-input" id="mkDecideText" rows="3" maxlength="500" style="resize:vertical;"></textarea>
      <p class="mk-note decline" id="mkDecideError" style="display:none;"></p>
    </div>
    <div class="modal-footer">
      <button class="btn-modal btn-cancel" type="button" id="mkDecideCancel">Cancel</button>
      <button class="btn-modal" type="button" id="mkDecideConfirm">Confirm</button>
    </div>
  </div>
</div>

<!-- Bulk approval: validates each request again on the way through -->
<div class="modal-overlay" id="mkBulkModal" data-backdrop-close="manual">
  <div class="modal-content" style="max-width:520px;">
    <div class="modal-header">
      <h3 class="modal-title" id="mkBulkTitle">Approve all pending requests</h3>
      <button class="modal-close" type="button" id="mkBulkClose">&times;</button>
    </div>
    <div class="modal-body">
      <div id="mkBulkForm">
        <p style="font-size:.85rem;color:var(--gray-600);line-height:1.6;margin:0 0 1rem;">
          Each of the <strong><%= pending.length %></strong> pending request<%= pending.length === 1 ? '' : 's' %>
          is checked again before it is approved: the supporting document must be attached, and
          the room and time must still be free. Anything that fails is left pending and listed here.
        </p>
        <label class="modal-label" for="mkBulkNote">Note to every instructor (optional)</label>
        <textarea class="modal-input" id="mkBulkNote" rows="2" maxlength="500" style="resize:vertical;"></textarea>
      </div>
      <div id="mkBulkResult" hidden></div>
    </div>
    <div class="modal-footer">
      <button class="btn-modal btn-cancel" type="button" id="mkBulkCancel">Cancel</button>
      <button class="btn-modal btn-confirm-green" type="button" id="mkBulkConfirm">Approve all</button>
    </div>
  </div>
</div>

<div class="toast-container" id="toastContainer"></div>
<%- include('../../partials/footer') %>
<%- include('../../partials/script') %>
<script src="/js/makeup-list.js?v=<%= assetVersion %>"></script>
<script>
(function () {
  // ── Single decision ──
  var modal   = document.getElementById('mkDecideModal');
  var title   = document.getElementById('mkDecideTitle');
  var body    = document.getElementById('mkDecideBody');
  var label   = document.getElementById('mkDecideLabel');
  var text    = document.getElementById('mkDecideText');
  var errBox  = document.getElementById('mkDecideError');
  var confirm = document.getElementById('mkDecideConfirm');
  var current = null;   // { id, approve }

  function open(id, approve) {
    current = { id: id, approve: approve };
    title.textContent = approve ? 'Approve request' : 'Decline request';
    body.textContent = approve
      ? 'The sessions are re-checked for clashes before this is recorded. The instructor is notified.'
      : 'The instructor is notified along with your reason.';
    label.textContent = approve ? 'Note to the instructor (optional)' : 'Reason for declining (required)';
    confirm.textContent = approve ? 'Approve' : 'Decline';
    confirm.className = 'btn-modal ' + (approve ? 'btn-confirm-green' : 'btn-confirm');
    text.value = '';
    errBox.style.display = 'none';
    modal.classList.add('show');
    text.focus();
  }

  function close() { modal.classList.remove('show'); current = null; }

  document.querySelectorAll('[data-approve]').forEach(function (b) {
    b.addEventListener('click', function () { open(b.dataset.approve, true); });
  });
  document.querySelectorAll('[data-decline]').forEach(function (b) {
    b.addEventListener('click', function () { open(b.dataset.decline, false); });
  });

  document.getElementById('mkDecideClose').addEventListener('click', close);
  document.getElementById('mkDecideCancel').addEventListener('click', close);
  modal.addEventListener('click', function (e) { if (e.target === modal) close(); });

  confirm.addEventListener('click', function () {
    if (!current) return;
    var value = text.value.trim();
    if (!current.approve && !value) {
      errBox.textContent = 'A reason is required when declining.';
      errBox.style.display = 'block';
      return;
    }

    confirm.disabled = true;
    var url = '/dean/makeup/' + current.id + (current.approve ? '/approve' : '/decline');
    var payload = current.approve
      ? { confirmed: true, statement: value }
      : { reason: value };

    fetch(url, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        confirm.disabled = false;
        if (!data.success) {
          errBox.textContent = data.error || 'Could not record the decision.';
          errBox.style.display = 'block';
          return;
        }
        window.location.reload();
      })
      .catch(function () {
        confirm.disabled = false;
        errBox.textContent = 'Network error. Please try again.';
        errBox.style.display = 'block';
      });
  });

  // ── Approve all ──
  var bulkBtn = document.getElementById('mkApproveAll');
  if (!bulkBtn) return;

  var bulkModal   = document.getElementById('mkBulkModal');
  var bulkForm    = document.getElementById('mkBulkForm');
  var bulkResult  = document.getElementById('mkBulkResult');
  var bulkNote    = document.getElementById('mkBulkNote');
  var bulkConfirm = document.getElementById('mkBulkConfirm');
  var bulkCancel  = document.getElementById('mkBulkCancel');
  var ran = false;

  function closeBulk() {
    bulkModal.classList.remove('show');
    // A run always changes the queue, so the page has to catch up
    if (ran) window.location.reload();
  }

  bulkBtn.addEventListener('click', function () {
    ran = false;
    bulkForm.hidden = false;
    bulkResult.hidden = true;
    bulkResult.innerHTML = '';
    bulkNote.value = '';
    bulkConfirm.hidden = false;
    bulkConfirm.disabled = false;
    bulkConfirm.textContent = 'Approve all';
    bulkCancel.textContent = 'Cancel';
    bulkModal.classList.add('show');
  });

  document.getElementById('mkBulkClose').addEventListener('click', closeBulk);
  bulkCancel.addEventListener('click', closeBulk);
  bulkModal.addEventListener('click', function (e) { if (e.target === bulkModal) closeBulk(); });

  bulkConfirm.addEventListener('click', function () {
    bulkConfirm.disabled = true;
    bulkConfirm.textContent = 'Checking…';

    fetch('/dean/makeup/approve-all', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ statement: bulkNote.value.trim() }),
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.success) {
          bulkConfirm.disabled = false;
          bulkConfirm.textContent = 'Approve all';
          showResult('<p class="mk-note decline">' + escapeHtml(data.error || 'Could not approve the queue.') + '</p>');
          return;
        }
        ran = data.approved > 0;
        showResult(summary(data));
        bulkConfirm.hidden = true;
        bulkCancel.textContent = 'Close';
      })
      .catch(function () {
        bulkConfirm.disabled = false;
        bulkConfirm.textContent = 'Approve all';
        showResult('<p class="mk-note decline">Network error. Please try again.</p>');
      });
  });

  function showResult(html) {
    bulkForm.hidden = true;
    bulkResult.hidden = false;
    bulkResult.innerHTML = html;
  }

  function summary(data) {
    var html = '<p class="mk-note dean"><strong>' + data.approved + ' of ' + data.total +
               '</strong> request' + (data.total === 1 ? '' : 's') + ' approved.</p>';
    if (data.skipped.length) {
      html += '<p class="mk-bulk-heading">Left pending — fix these and try again:</p><ul class="mk-bulk-list">';
      data.skipped.forEach(function (s) {
        html += '<li><strong>' + escapeHtml(s.instructor) + '</strong> — ' + escapeHtml(s.reason) + '</li>';
      });
      html += '</ul>';
    }
    return html;
  }

  function escapeHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
    });
  }
}());
</script>
