<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/instructor/dashboard.css?v=<%= assetVersion %>">
<style>
/* ── View toggle ── */
.view-toggle{display:flex;gap:.375rem;background:var(--gray-100);border-radius:var(--radius-md);padding:3px}
.view-btn{padding:.375rem .875rem;border:none;border-radius:calc(var(--radius-md) - 2px);font-size:.8125rem;font-weight:600;cursor:pointer;font-family:var(--font-body);color:var(--gray-600);background:transparent;transition:all .18s;display:flex;align-items:center;gap:.375rem}
.view-btn.active{background:#fff;color:var(--primary-blue);box-shadow:0 1px 4px rgba(0,0,0,.1)}
/* ── Card grid ── */
.mon-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1rem}
.fac-card{background:#fff;border:1.5px solid var(--gray-200);border-radius:14px;padding:1.1rem 1.25rem;display:flex;align-items:center;gap:.875rem;box-shadow:0 2px 8px rgba(0,0,0,.04);transition:all .2s;cursor:pointer}
.fac-card:hover{box-shadow:0 6px 20px rgba(0,0,0,.1);transform:translateY(-2px)}
.fac-card.in-room{border-color:rgba(34,197,94,.35);background:linear-gradient(135deg,#fff,rgba(34,197,94,.03))}
.fac-card.out-of-room{opacity:.78}
.fac-avatar{width:44px;height:44px;border-radius:50%;background:var(--teal-gradient);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.9rem;flex-shrink:0}
.fac-card.out-of-room .fac-avatar{background:var(--gray-300)}
.fac-info{flex:1;min-width:0}
.fac-name{font-size:.9rem;font-weight:700;color:var(--gray-900);margin:0 0 .1rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fac-pos{font-size:.75rem;color:var(--gray-500);margin:0 0 .3rem}
.fac-room{display:flex;align-items:center;gap:.3rem;font-size:.78rem;color:var(--primary-blue);font-weight:600}
.fac-card.out-of-room .fac-room{color:var(--gray-500)}
.fac-time{font-size:.7rem;color:var(--gray-400);margin-top:.2rem}
.status-pill{display:inline-flex;align-items:center;gap:.3rem;padding:.22rem .65rem;border-radius:999px;font-size:.65rem;font-weight:700;flex-shrink:0}
.status-pill.in{background:rgba(34,197,94,.12);color:#15803d}
.status-pill.out{background:rgba(107,114,128,.12);color:#374151}
.status-pill .dot{width:6px;height:6px;border-radius:50%}
.status-pill.in .dot{background:#16a34a;animation:blink 1.5s infinite}
.status-pill.out .dot{background:#9ca3af}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
/* ── Section divider ── */
.sec-div{display:flex;align-items:center;gap:.5rem;font-size:.72rem;font-weight:700;color:var(--gray-500);text-transform:uppercase;letter-spacing:.06em;margin:.25rem 0 .625rem}
.sec-div::after{content:'';flex:1;height:1px;background:var(--gray-200)}
.sec-count{background:var(--gray-100);color:var(--gray-600);border-radius:999px;padding:1px 8px;font-size:.65rem}
/* ══════════════════════════════════════════
   FULL-SCREEN FACULTY MONITORING BOARD
   White bg · Blue=IN · Gray=OUT · TV style
   ══════════════════════════════════════════ */
.preview-overlay{display:none;position:fixed;inset:0;background:#f0f4f8;z-index:2000;flex-direction:column}
.preview-overlay.open{display:flex}
.preview-box{display:flex;flex-direction:column;width:100%;height:100%;overflow:hidden;background:#f0f4f8}

/* ── Top header bar ──
   Overlays the board rather than taking a row from it, and fades out with the
   close button when the mouse goes still — on a wall display the faces are the
   point, not the chrome. */
.fs-header{
  position:absolute;top:0;left:0;right:0;z-index:2050;
  display:flex;align-items:center;justify-content:space-between;
  padding:.55rem 1.25rem;background:rgba(255,255,255,.96);
  backdrop-filter:blur(6px);
  border-bottom:1px solid #e2e8f0;flex-shrink:0;
  transition:opacity .4s ease,transform .4s ease;
}
/* Deliberately no faded state: the title, the room and the clock are content,
   not chrome, and a board that hides them once nobody touches the mouse is
   answering a question nobody asked. Only .fs-close-btn fades. */
.fs-header-left{display:flex;align-items:center;gap:.625rem;min-width:0}
.fs-board-title{font-size:1.05rem;font-weight:800;color:#1e293b;margin:0;letter-spacing:.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fs-board-sub{font-size:.72rem;font-weight:600;color:#64748b;margin:0}
.fs-legend{display:flex;align-items:center;gap:.875rem}
.fs-legend-item{display:flex;align-items:center;gap:.35rem;font-size:.78rem;font-weight:600;color:#475569;white-space:nowrap}
.fs-legend-dot{width:10px;height:10px;border-radius:50%}
.fs-legend-dot.in{background:#2563eb}
.fs-legend-dot.out{background:#ef4444}
/* Clock */
.fs-clock-wrap{text-align:right}
.fs-clock{font-size:1.5rem;font-weight:800;color:#1e293b;font-variant-numeric:tabular-nums;line-height:1;letter-spacing:.02em}
.fs-ampm{font-size:.8rem;font-weight:700;color:#64748b;margin-left:.25rem}

/* ── Floating close ── */
.fs-close-btn{
  position:fixed;top:.75rem;right:.75rem;z-index:2100;
  width:34px;height:34px;border:1px solid #e2e8f0;border-radius:50%;
  background:#fff;color:#64748b;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 2px 8px rgba(0,0,0,.12);
  transition:opacity .4s ease,background .15s;opacity:1;
}
.fs-close-btn:hover{background:#f1f5f9;color:#1e293b}
.fs-close-btn.faded{opacity:0;pointer-events:none}

/* ── Scrollable body ── */
/* Top padding clears the overlaid header. When the header fades the board
   claims the space back, in step with the header's own transition. */
.fs-body{
  flex:1;overflow-y:auto;padding:3.75rem 1.25rem 1rem;background:#f0f4f8;
  transition:padding-top .4s ease;
}

.fs-body::-webkit-scrollbar{width:5px}
.fs-body::-webkit-scrollbar-thumb{background:#cbd5e1;border-radius:3px}

/* ── Faculty card grid — 8 per row ── */
.fs-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:1rem}

/* ── Individual card ── */
.fs-card{
  width:100%;flex-shrink:0;border-radius:14px;overflow:hidden;
  display:flex;flex-direction:column;align-items:center;
  padding:.9rem .75rem .75rem;gap:.35rem;
  border:1px solid transparent;
  transition:transform .15s,box-shadow .15s;cursor:default;
}
.fs-card:hover{transform:translateY(-2px);box-shadow:0 6px 18px rgba(0,0,0,.12)}

/* IN = blue card */
.fs-card.in{
  background:#2563eb;border-color:#1d4ed8;
  box-shadow:0 2px 8px rgba(37,99,235,.3);
}
/* OUT = white card */
.fs-card.out{
  background:#fff;border-color:#e2e8f0;
  box-shadow:0 1px 4px rgba(0,0,0,.06);
}

/* ── Photo circle ── */
.fs-photo{
  width:min(100px, 70%);height:0;padding-bottom:min(100px, 70%);
  border-radius:50%;overflow:hidden;position:relative;
  background:#dbeafe;border:3px solid rgba(255,255,255,.6);
  flex-shrink:0;
}
.fs-card.out .fs-photo{background:#f1f5f9;border-color:#e2e8f0}
.fs-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.fs-photo svg{position:absolute;inset:0;margin:auto;width:50%;height:50%}
.fs-initials{
  position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  font-size:2rem;font-weight:800;letter-spacing:.02em;color:#1e40af;
}
.fs-card.out .fs-initials{color:#64748b}
.fs-card.in  .fs-photo svg{color:rgba(255,255,255,.7)}
.fs-card.out .fs-photo svg{color:#94a3b8}

/* ── Name, position, room, time ── */
/* Never truncated: a monitoring board that abbreviates the one thing it exists
   to show is worse than a board that wraps onto a second line. */
.fs-name{
  font-size:.92rem;font-weight:700;text-align:center;
  width:100%;line-height:1.25;margin:0;
  overflow-wrap:anywhere;hyphens:none;
}
.fs-card.in  .fs-name{color:#fff}
.fs-card.out .fs-name{color:#1e293b}

.fs-pos{
  font-size:.78rem;font-weight:500;text-align:center;margin:0;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;width:100%;
}
/* .92 rather than .75: at this size a three-quarter white is grey mush on blue. */
.fs-card.in  .fs-pos{color:rgba(255,255,255,.92)}
.fs-card.out .fs-pos{color:#475569}

/* Where somebody is, as a chip. Bigger, solid colour, and visually separate
   from the position line so the two stop reading as one paragraph. */
.fs-room{
  font-size:.82rem;font-weight:700;text-align:center;margin:.1rem 0 0;
  max-width:100%;overflow-wrap:anywhere;line-height:1.35;
  padding:.16rem .5rem;border-radius:999px;
}
.fs-card.in  .fs-room{color:#fff;background:rgba(255,255,255,.22)}
.fs-card.out .fs-room{color:#1d4ed8;background:#e8f0fe}
.fs-card.unknown .fs-room{color:#64748b;background:#f1f5f9}

.fs-time{
  font-size:.78rem;font-weight:600;text-align:center;margin:0;
}
.fs-card.in  .fs-time{color:rgba(255,255,255,.95)}
.fs-card.out .fs-time{color:#94a3b8}

/* ── Section label ── */
.fs-section-label{
  font-size:.7rem;font-weight:700;text-transform:uppercase;
  letter-spacing:.07em;color:#64748b;
  display:flex;align-items:center;gap:.4rem;
  margin:0 0 .5rem;
}
.fs-section-label .sdot{width:8px;height:8px;border-radius:50%}
.fs-section-label .sdot.in{background:#2563eb}
.fs-section-label .sdot.out{background:#94a3b8}

/* ── Bottom bar: In Travel + In Leave side by side ── */
.fs-bottom-bar{
  flex-shrink:0;display:flex;border-top:1px solid #e2e8f0;background:#fff;
  min-height:80px;
}
.fs-bottom-panel{
  flex:1;display:flex;flex-direction:column;
  padding:.5rem 1.25rem .6rem;
}
.fs-bottom-panel:first-child{border-right:1px solid #e2e8f0}
.fs-bottom-panel-hdr{
  display:flex;align-items:center;gap:.5rem;
  font-size:.78rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;
  margin-bottom:.4rem;
}
.fs-bottom-panel-hdr.travel{color:#ea580c}
.fs-bottom-panel-hdr.leave {color:#dc2626}
.fs-bottom-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}
.fs-bottom-dot.travel{background:#ea580c}
.fs-bottom-dot.leave {background:#dc2626}
.fs-bottom-empty{font-size:.8rem;color:#94a3b8;margin:0}
.fs-bottom-grid{display:flex;flex-wrap:wrap;gap:.5rem}
/* mini card inside bottom panels */
.fs-mini-card{
  display:flex;align-items:center;gap:.5rem;
  background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;
  padding:.35rem .6rem;
}
.fs-mini-card.travel{border-left:3px solid #ea580c}
.fs-mini-card.leave {border-left:3px solid #dc2626}
.fs-mini-photo{
  width:32px;height:32px;border-radius:50%;overflow:hidden;
  background:#f1f5f9;border:2px solid #e2e8f0;
  display:flex;align-items:center;justify-content:center;flex-shrink:0;
}
.fs-mini-photo svg{width:55%;height:55%;color:#94a3b8}
.fs-mini-photo img{width:100%;height:100%;object-fit:cover}
.fs-mini-initials{
  font-size:.8rem;font-weight:800;color:#475569;letter-spacing:.02em;
}
.fs-mini-name{font-size:.8rem;font-weight:700;color:#1e293b;margin:0;white-space:nowrap}
.fs-mini-sub {font-size:.7rem;color:#475569;margin:0;white-space:nowrap}

/* Shown once a panel holds more than it can display at a glance. Sized like a
   mini card so the row keeps its rhythm rather than ending on a stray button. */
.fs-mini-more{
  display:flex;align-items:center;gap:.35rem;
  background:#fff;border:1px dashed #cbd5e1;border-radius:8px;
  padding:.35rem .7rem;cursor:pointer;
  font-family:var(--font-body);font-size:.78rem;font-weight:700;color:#475569;
}
.fs-mini-more:hover{border-color:#94a3b8;color:#1e293b;background:#f8fafc}
.fs-mini-more:focus-visible{outline:2px solid #2563eb;outline-offset:2px}

.fs-no-results{text-align:center;padding:2rem;color:#94a3b8;font-size:.875rem}
/* ── Modal ── */
.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:3000;align-items:center;justify-content:center;padding:1rem}
.modal-overlay.open{display:flex}
.modal-box{background:#fff;border-radius:16px;width:100%;max-width:520px;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.25)}
.modal-header{padding:1.25rem 1.5rem;border-bottom:1px solid var(--gray-100);display:flex;align-items:center;justify-content:space-between}
.modal-title{font-size:1rem;font-weight:700;color:var(--gray-900);margin:0}
.modal-close-btn{width:32px;height:32px;border:none;background:var(--gray-100);border-radius:8px;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--gray-500);transition:all .15s}
.modal-close-btn:hover{background:var(--gray-200);color:var(--gray-800)}
.modal-body{padding:1.25rem 1.5rem}
.modal-footer{padding:1rem 1.5rem;border-top:1px solid var(--gray-100);display:flex;gap:.625rem;justify-content:flex-end}
.modal-form-grid{display:grid;grid-template-columns:1fr 1fr;gap:.875rem}
.modal-form-grid .full{grid-column:1/-1}
.modal-label{font-size:.75rem;font-weight:600;color:var(--gray-700);display:block;margin-bottom:.3rem}
.modal-input,.modal-select{width:100%;padding:.5rem .75rem;border:1.5px solid var(--gray-200);border-radius:var(--radius-md);font-size:.875rem;font-family:var(--font-body);color:var(--gray-900);background:#fff;outline:none;transition:border-color .15s;box-sizing:border-box}
.modal-input:focus,.modal-select:focus{border-color:var(--primary-blue)}
.btn-modal-primary{padding:.5rem 1.25rem;background:var(--teal-gradient);color:#fff;border:none;border-radius:var(--radius-md);font-size:.875rem;font-weight:600;font-family:var(--font-body);cursor:pointer;transition:all .15s}
.btn-modal-primary:hover{opacity:.9}
.btn-modal-cancel{padding:.5rem 1.25rem;background:#fff;color:var(--gray-700);border:1.5px solid var(--gray-200);border-radius:var(--radius-md);font-size:.875rem;font-weight:600;font-family:var(--font-body);cursor:pointer;transition:all .15s}
.btn-modal-cancel:hover{border-color:var(--gray-400)}
.btn-modal-danger{padding:.5rem 1.25rem;background:#dc2626;color:#fff;border:none;border-radius:var(--radius-md);font-size:.875rem;font-weight:600;font-family:var(--font-body);cursor:pointer;transition:all .15s}
.btn-modal-danger:hover{background:#b91c1c}
/* ── Detail modal ── */
.detail-header{display:flex;align-items:center;gap:1rem;padding:1.5rem;border-bottom:1px solid var(--gray-100)}
.detail-avatar{width:60px;height:60px;border-radius:50%;background:var(--teal-gradient);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1.25rem;flex-shrink:0}
.detail-name{font-size:1.0625rem;font-weight:700;color:var(--gray-900);margin:0 0 .2rem}
.detail-pos{font-size:.8125rem;color:var(--gray-500);margin:0}
.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:.875rem;padding:1.25rem 1.5rem}
.detail-item label{font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--gray-400);display:block;margin-bottom:.2rem}
.detail-item p{font-size:.875rem;color:var(--gray-900);font-weight:600;margin:0}
.detail-item.full{grid-column:1/-1}
/* ── Table action buttons ── */
.tbl-btn{padding:.3rem .625rem;border:1.5px solid var(--gray-200);border-radius:6px;background:#fff;font-size:.72rem;font-weight:600;cursor:pointer;font-family:var(--font-body);color:var(--gray-600);transition:all .15s;display:inline-flex;align-items:center;gap:.3rem}
.tbl-btn:hover{border-color:var(--primary-blue);color:var(--primary-blue)}
.tbl-btn.danger:hover{border-color:#dc2626;color:#dc2626}
/* ── Presence with no data behind it ── */
.fac-card.unknown{border-style:dashed;border-color:var(--gray-300);background:var(--gray-50)}
.fac-card.unknown .fac-avatar{background:var(--gray-300)}
.fac-card.unknown .fac-room{color:var(--gray-500)}
.status-pill.unknown{background:var(--gray-100);color:var(--gray-500)}
.status-pill.unknown .dot{background:#cbd5e1}
.presence-notice{display:flex;align-items:flex-start;gap:.75rem;padding:.875rem 1.125rem;background:#eff6ff;border:1px solid #bfdbfe;border-radius:var(--radius-md);margin-bottom:1.25rem}
.presence-notice svg{color:#2563eb;flex-shrink:0;margin-top:1px}
.presence-notice p{font-size:.8125rem;color:#1e40af;margin:0;line-height:1.5}
.stat-card-value.muted{color:var(--gray-300)}
.dean-empty{display:flex;flex-direction:column;align-items:center;gap:.5rem;padding:2rem 1rem;text-align:center}
.dean-empty svg{color:var(--gray-300)}
.dean-empty p{font-size:.8125rem;color:var(--gray-500);margin:0;max-width:36ch;line-height:1.5}
/* Self-reported availability, which is real today */
.avail-pill{display:inline-flex;align-items:center;gap:.3rem;padding:.2rem .6rem;border-radius:999px;font-size:.68rem;font-weight:700;white-space:nowrap}
.avail-pill.available{background:rgba(34,197,94,.12);color:#15803d}
.avail-pill.dnd{background:rgba(220,38,38,.12);color:#b91c1c}
.avail-pill.travel{background:rgba(234,88,12,.12);color:#c2410c}
.avail-pill.leave{background:rgba(220,38,38,.1);color:#dc2626}
.avail-pill.meeting{background:rgba(124,58,237,.12);color:#6d28d9}
.avail-pill.none{background:var(--gray-100);color:var(--gray-500)}
/* ── Rooms view ── */
.room-type-bar{display:flex;align-items:center;gap:.75rem;flex-wrap:wrap;margin-bottom:1.25rem}
.room-type-label{font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--gray-400)}
.room-type-btns{display:flex;gap:.375rem;flex-wrap:wrap}
.room-type-btn{display:inline-flex;align-items:center;gap:.4rem;padding:.4rem .875rem;border:1.5px solid var(--gray-200);border-radius:999px;background:#fff;font-size:.78rem;font-weight:600;color:var(--gray-600);cursor:pointer;transition:all .18s;font-family:var(--font-body)}
.room-type-btn:hover{border-color:var(--primary-blue);color:var(--primary-blue)}
.room-type-btn.active{background:var(--primary-blue);border-color:var(--primary-blue);color:#fff}
.room-type-count{background:var(--gray-100);color:var(--gray-600);border-radius:999px;padding:0 .4rem;font-size:.68rem;font-weight:700;min-width:18px;text-align:center}
.room-type-btn.active .room-type-count{background:rgba(255,255,255,.22);color:#fff}

.room-card{background:#fff;border:1.5px solid var(--gray-200);border-radius:14px;padding:1.1rem 1.25rem;display:flex;flex-direction:column;gap:.75rem;box-shadow:0 2px 8px rgba(0,0,0,.04);transition:all .2s;cursor:pointer}
.room-card:hover{box-shadow:0 6px 20px rgba(0,0,0,.1);transform:translateY(-2px)}
.room-card:focus-visible{outline:2px solid var(--primary-blue);outline-offset:2px}
/* Picked as the room the full-screen board will monitor */
.room-card.selected{border-color:var(--primary-blue);box-shadow:0 0 0 3px rgba(30,136,229,.18),0 6px 20px rgba(10,61,98,.12)}
.room-select-hint{display:flex;align-items:center;gap:.3rem;font-size:.68rem;font-weight:700;color:var(--gray-400);text-transform:uppercase;letter-spacing:.04em}
.room-card.selected .room-select-hint{color:var(--primary-blue)}
.room-select-banner{display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap;padding:.7rem 1rem;background:rgba(10,61,98,.05);border:1px solid rgba(10,61,98,.18);border-radius:var(--radius-md);margin-bottom:1rem}
.room-select-banner p{margin:0;font-size:.8125rem;color:var(--primary-blue);font-weight:600}
.room-select-banner button{padding:.35rem .75rem;border:1.5px solid var(--gray-300);border-radius:var(--radius-md);background:#fff;font-size:.75rem;font-weight:600;color:var(--gray-600);cursor:pointer;font-family:var(--font-body)}
.room-select-banner button:hover{border-color:var(--primary-blue);color:var(--primary-blue)}
.room-card.occupied{border-color:rgba(37,99,235,.35);background:linear-gradient(135deg,#fff,rgba(37,99,235,.03))}
.room-card.inactive{opacity:.65;border-style:dashed}
.room-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:.75rem}
.room-number{font-size:.95rem;font-weight:700;color:var(--gray-900);margin:0 0 .15rem}
.room-meta{font-size:.75rem;color:var(--gray-500);margin:0}
.room-type-pill{display:inline-flex;align-items:center;padding:.2rem .6rem;border-radius:999px;font-size:.65rem;font-weight:700;white-space:nowrap;background:var(--gray-100);color:var(--gray-600)}
.room-type-pill.lecture{background:rgba(37,99,235,.1);color:#1d4ed8}
.room-type-pill.laboratory{background:rgba(124,58,237,.12);color:#6d28d9}
.room-type-pill.lounge{background:rgba(234,88,12,.12);color:#c2410c}
.room-type-pill.office{background:rgba(15,118,110,.12);color:#0f766e}
.room-type-pill.consultation{background:rgba(34,197,94,.12);color:#15803d}
.room-occupants{display:flex;flex-direction:column;gap:.4rem;padding-top:.65rem;border-top:1px solid var(--gray-100)}
.room-occ-label{font-size:.65rem;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--gray-400);margin:0}
.room-occ{display:flex;align-items:center;gap:.5rem}
.room-occ-avatar{width:26px;height:26px;border-radius:50%;background:var(--teal-gradient);color:#fff;display:flex;align-items:center;justify-content:center;font-size:.6rem;font-weight:700;flex-shrink:0}
.room-occ-name{font-size:.8rem;font-weight:600;color:var(--gray-900);margin:0}
.room-occ-sub{font-size:.68rem;color:var(--gray-500);margin:0}
.room-occ-empty{font-size:.76rem;color:var(--gray-400);margin:0;font-style:italic}
.room-foot{display:flex;align-items:center;justify-content:space-between;gap:.5rem;font-size:.7rem;color:var(--gray-500)}
.room-ble{display:inline-flex;align-items:center;gap:.3rem;font-weight:700}
.room-ble.on{color:#15803d}
.room-ble.off{color:var(--gray-400)}
.room-ble-dot{width:6px;height:6px;border-radius:50%;background:currentColor;flex-shrink:0}

.fs-card.unknown{background:#fff;border-color:#e2e8f0;border-style:dashed;box-shadow:none}
.fs-card.unknown .fs-name{color:#64748b}
.fs-card.unknown .fs-pos,.fs-card.unknown .fs-room,.fs-card.unknown .fs-time{color:#94a3b8}
/* ── Mobile ── */
@media (max-width:900px){
  .fs-grid{grid-template-columns:repeat(4,1fr)}
  .fs-board-title{font-size:1.25rem}
  .fs-clock{font-size:2rem}
  .fs-ampm{font-size:1rem}
  .fs-legend-item{font-size:.875rem}
}
@media (max-width:580px){
  .page-header .header-actions{width:100%;flex-wrap:wrap;gap:.5rem}
  .view-toggle{flex:1}
  .view-btn{flex:1;justify-content:center}
  .mon-grid{grid-template-columns:1fr}
  .fs-grid{grid-template-columns:repeat(2,1fr)}
  .fs-header{flex-direction:column;align-items:flex-start;gap:.5rem;padding:.75rem 1rem}
  .fs-bottom-bar{flex-direction:column}
  .fs-bottom-panel:first-child{border-right:none;border-bottom:1px solid #e2e8f0}
  .detail-grid{grid-template-columns:1fr}
  .presence-notice{padding:.75rem .875rem}
  .presence-notice p{font-size:.75rem}
  /* The directory table scrolls rather than squashing the page */
  #tableView .card-body{overflow-x:auto}
  #facultyTable{min-width:640px}
  .room-type-bar{flex-direction:column;align-items:stretch;gap:.5rem}
  .room-type-btns{gap:.3rem}
  .room-type-btn{flex:1;justify-content:center;padding:.4rem .5rem;font-size:.72rem}
}
</style>

<div class="instructor-layout">
  <%- include('../../partials/dean-sidebar', { activePage: 'faculty' }) %>
  <main class="instructor-main">
    <div class="main-container">

      <%
        const inRoomFac  = faculty.filter(f => f.bleStatus === 'in-room');
        const outRoomFac = faculty.filter(f => f.bleStatus === 'out-of-room');
        const noDataFac  = faculty.filter(f => f.bleStatus === 'unknown');
        const initials   = n => n.split(' ').map(p => p[0]).join('').slice(0, 2).toUpperCase();
      %>

      <div class="page-header">
        <div>
          <h1 class="page-title">Faculty</h1>
          <p class="page-subtitle"><%= dean.department %> — <%= faculty.length %> instructor<%= faculty.length === 1 ? '' : 's' %></p>
        </div>
        <div class="header-actions">
          <div class="view-toggle" id="viewToggle">
            <button class="view-btn active" data-view="cards" id="btnCards">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              Cards
            </button>
            <button class="view-btn" data-view="table" id="btnTable">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
              Table
            </button>
            <button class="view-btn" data-view="rooms" id="btnRooms">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              Rooms
            </button>
          </div>
          <input type="search" id="facSearch" placeholder="Search faculty..." style="padding:.45rem .875rem;border:1.5px solid var(--gray-200);border-radius:var(--radius-md);font-size:.8125rem;font-family:var(--font-body);background:#fff;color:var(--gray-800);outline:none;min-width:0">
          <select id="filterStatus" style="padding:.45rem .875rem;border:1.5px solid var(--gray-200);border-radius:var(--radius-md);font-size:.8125rem;font-family:var(--font-body);background:#fff;color:var(--gray-800);outline:none;cursor:pointer">
            <option value="all">All Faculty</option>
            <option value="in-room">In Room Only</option>
            <option value="out-of-room">Out of Room Only</option>
            <option value="unknown">Awaiting Data</option>
          </select>
          <button class="btn-header-action primary" id="btnFullPreview">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"/></svg>
            Full Screen
          </button>
        </div>
      </div>

      <% if (presenceUnavailable && faculty.length) { %>
      <div class="presence-notice">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
        <p><strong>Presence monitoring is not active yet.</strong> No BLE scanner has reported on these instructors, so nobody is listed as in or out of their room. The availability shown below is what each instructor set themselves, and it is live.</p>
      </div>
      <% } %>

      <!-- Stats -->
      <div class="stats-overview">
        <div class="stat-card-large confirmed">
          <div class="stat-card-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
          <div class="stat-card-content">
            <p class="stat-card-label">Currently In Room</p>
            <h2 class="stat-card-value <%= presenceUnavailable ? 'muted' : '' %>" id="statIn"><%= presenceUnavailable ? '—' : inRoomFac.length %></h2>
            <p class="stat-card-sublabel"><%= presenceUnavailable ? 'Awaiting BLE data' : `of ${faculty.length} total faculty` %></p>
          </div>
        </div>
        <div class="stat-card-large presence">
          <div class="stat-card-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
          <div class="stat-card-content">
            <p class="stat-card-label">Out of Room</p>
            <h2 class="stat-card-value <%= presenceUnavailable ? 'muted' : '' %>" id="statOut"><%= presenceUnavailable ? '—' : outRoomFac.length %></h2>
            <p class="stat-card-sublabel"><%= presenceUnavailable ? 'Awaiting BLE data' : 'Not detected' %></p>
          </div>
        </div>
        <div class="stat-card-large pending">
          <div class="stat-card-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></div>
          <div class="stat-card-content">
            <p class="stat-card-label">Available Now</p>
            <h2 class="stat-card-value"><%= faculty.filter(f => f.availability === 'available').length %></h2>
            <p class="stat-card-sublabel">Self-reported status</p>
          </div>
        </div>
        <div class="stat-card-large workload">
          <div class="stat-card-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg></div>
          <div class="stat-card-content">
            <p class="stat-card-label">Total Faculty</p>
            <h2 class="stat-card-value"><%= faculty.length %></h2>
            <p class="stat-card-sublabel">In <%= dean.department %></p>
          </div>
        </div>
      </div>

      <% if (!faculty.length) { %>
      <div id="cardView">
        <div class="content-card">
          <div class="card-body">
            <div class="dean-empty">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg>
              <p>No instructors are assigned to <%= dean.department %> yet. An administrator adds faculty accounts under Admin &rsaquo; Users.</p>
            </div>
          </div>
        </div>
      </div>
      <% } else { %>

      <!-- ── CARD VIEW ── -->
      <div id="cardView">
        <div id="inRoomSection">
          <div class="sec-div">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
            Currently In Room
            <span class="sec-count" id="inRoomCount"><%= inRoomFac.length %></span>
          </div>
          <div class="mon-grid" id="inRoomGrid"></div>
        </div>

        <div id="outRoomSection" style="margin-top:.5rem">
          <div class="sec-div">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2.5"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Out of Room
            <span class="sec-count" id="outRoomCount"><%= outRoomFac.length %></span>
          </div>
          <div class="mon-grid" id="outRoomGrid"></div>
        </div>

        <div id="noDataSection" style="margin-top:.5rem">
          <div class="sec-div">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
            Awaiting Presence Data
            <span class="sec-count" id="noDataCount"><%= noDataFac.length %></span>
          </div>
          <div class="mon-grid" id="noDataGrid"></div>
        </div>

        <p class="fs-no-results" id="cardNoResults" style="display:none">No instructor matches your search.</p>
      </div>

      <!-- ── TABLE VIEW ── -->
      <div id="tableView" style="display:none">
        <div class="content-card">
          <div class="card-header">
            <h3 class="card-title">Faculty Directory</h3>
          </div>
          <div class="card-body" style="padding:0">
            <table class="data-table" id="facultyTable">
              <thead>
                <tr>
                  <th>Faculty</th>
                  <th>Position</th>
                  <th>Office / Room</th>
                  <th>Availability</th>
                  <th>Presence</th>
                  <th>Consultations (Month)</th>
                  <th></th>
                </tr>
              </thead>
              <tbody id="facultyTbody"></tbody>
            </table>
          </div>
        </div>
      </div>
      <% } %>

      <!-- ── ROOMS VIEW ── -->
      <%# Who is in which room. The occupant list is driven by faculty_presence,
          so today every room reads "no one detected" and fills in by itself once
          the BLE scanners are installed. %>
      <div id="roomsView" style="display:none">
        <div class="room-type-bar" id="roomTypeBar">
          <span class="room-type-label">Room type</span>
          <div class="room-type-btns">
            <% const ROOM_TYPES = ['Lecture', 'Laboratory', 'Faculty Lounge', 'Faculty Office', 'Consultation Room']; %>
            <button type="button" class="room-type-btn active" data-room-type="all">
              All <span class="room-type-count"><%= rooms.length %></span>
            </button>
            <% ROOM_TYPES.forEach(type => { %>
            <button type="button" class="room-type-btn" data-room-type="<%= type %>">
              <%= type %> <span class="room-type-count"><%= rooms.filter(r => r.room_type === type).length %></span>
            </button>
            <% }); %>
          </div>
        </div>

        <% if (presenceUnavailable && rooms.length) { %>
        <div class="presence-notice">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
          <p><strong>Occupancy is waiting on the BLE scanners.</strong> Each room below shows who is assigned to it; the "currently inside" list fills in on its own once presence monitoring is live.</p>
        </div>
        <% } %>

        <div class="room-select-banner" id="roomSelectBanner" hidden>
          <p id="roomSelectText"></p>
          <button type="button" id="roomSelectClear">Monitor all rooms</button>
        </div>

        <div class="mon-grid" id="roomGrid"></div>
        <p class="fs-no-results" id="roomNoResults" style="display:none">No room of this type in <%= dean.department %>.</p>

        <% if (!rooms.length) { %>
        <div class="content-card">
          <div class="card-body">
            <div class="dean-empty">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              <p>No rooms are registered for <%= dean.department %> yet. An administrator adds them under Admin &rsaquo; Rooms.</p>
            </div>
          </div>
        </div>
        <% } %>
      </div>

    </div>
  </main>
</div>

<!-- ══════════════════════════════════════════
     FULL-SCREEN FACULTY MONITORING BOARD
     ══════════════════════════════════════════ -->
<div class="preview-overlay" id="previewOverlay">
