<script src="/js/presence-live.js?v=<%= assetVersion %>"></script>
<script>
(function(){
  'use strict';

  // Server-rendered roster. Read-only: adding and removing faculty is an
  // administrator action under Admin > Users, not something this page fakes.
  var facultyData = <%- JSON.stringify(faculty) %>;
  var roomData = <%- JSON.stringify(rooms) %>;

  var AVAIL_LABELS = {
    available:'Available', dnd:'Do Not Disturb', travel:'Official Travel',
    leave:'On Leave', meeting:'In a Meeting'
  };

  function esc(s){
    return String(s == null ? '' : s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }
  function initials(name){
    return String(name || '').split(' ').map(function(n){ return n[0]; }).join('').slice(0,2).toUpperCase();
  }
  function availPill(f){
    var key = f.availability || 'none';
    return '<span class="avail-pill ' + esc(key) + '">' + esc(f.availabilityLabel || 'Not set') + '</span>';
  }

  window.closeModal = function(id){ document.getElementById(id).classList.remove('open'); };
  function openModal(id){ document.getElementById(id).classList.add('open'); }

  // ── Filtering ──
  function currentList(){
    var status = document.getElementById('filterStatus').value;
    var q = (document.getElementById('facSearch').value || '').toLowerCase().trim();
    return facultyData.filter(function(f){
      if (status !== 'all' && f.bleStatus !== status) return false;
      if (q && f.name.toLowerCase().indexOf(q) === -1 && String(f.position).toLowerCase().indexOf(q) === -1) return false;
      return true;
    });
  }

  var SECTIONS = [
    { status:'in-room',     section:'inRoomSection', grid:'inRoomGrid', count:'inRoomCount', pill:'in',      label:'In Room', time:'Detected ' },
    { status:'out-of-room', section:'outRoomSection',grid:'outRoomGrid',count:'outRoomCount',pill:'out',     label:'Out',     time:'Last seen ' },
    { status:'unknown',     section:'noDataSection', grid:'noDataGrid', count:'noDataCount', pill:'unknown', label:'No data', time:'' }
  ];

  function render(){
    // The card and table sections only exist when the department has faculty
    if (!document.getElementById('facultyTbody')) return;
    var list = currentList();

    SECTIONS.forEach(function(sec){
      var group = list.filter(function(f){ return f.bleStatus === sec.status; });
      document.getElementById(sec.count).textContent = group.length;
      // A section with nothing in it is noise, so it comes out of the flow
      document.getElementById(sec.section).style.display = group.length ? '' : 'none';
      renderCards(sec, group);
    });

    document.getElementById('cardNoResults').style.display = list.length ? 'none' : 'block';
    renderTable(list);
  }

  function renderCards(sec, list){
    var grid = document.getElementById(sec.grid);
    grid.innerHTML = '';
    list.forEach(function(f){
      var card = document.createElement('div');
      card.className = 'fac-card ' + sec.status;
      card.dataset.status = sec.status;
      card.dataset.id = f.id;
      card.innerHTML =
        '<div class="fac-avatar">' + initials(f.name) + '</div>' +
        '<div class="fac-info">' +
          '<p class="fac-name">' + esc(f.name) + '</p>' +
          '<p class="fac-pos">' + esc(f.position) + '</p>' +
          '<div class="fac-room"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>' + esc(f.officeRoom) + '</div>' +
          '<p class="fac-time">' + (f.bleLastDetected ? esc(sec.time + f.bleLastDetected) : availPill(f)) + '</p>' +
        '</div>' +
        '<span class="status-pill ' + sec.pill + '"><span class="dot"></span>' + sec.label + '</span>';
      card.addEventListener('click', function(){ openDetail(f); });
      grid.appendChild(card);
    });
  }

  function renderTable(list){
    var tbody = document.getElementById('facultyTbody');
    if (!tbody) return;
    tbody.innerHTML = '';
    list.forEach(function(f){
      var tr = document.createElement('tr');
      tr.dataset.status = f.bleStatus;
      tr.dataset.id = f.id;
      var badge = f.bleStatus === 'in-room'  ? '<span class="table-badge confirmed">In Room</span>'
                : f.bleStatus === 'out-of-room' ? '<span class="table-badge declined">Out of Room</span>'
                : '<span class="table-badge">No data</span>';
      tr.innerHTML =
        '<td><div style="display:flex;align-items:center;gap:.75rem"><div class="apt-avatar-xs">' + initials(f.name) + '</div><p style="font-weight:600;font-size:.875rem;color:var(--gray-900);margin:0">' + esc(f.name) + '</p></div></td>' +
        '<td style="font-size:.8125rem;color:var(--gray-600)">' + esc(f.position) + '</td>' +
        '<td style="font-size:.8125rem">' + esc(f.officeRoom) + '</td>' +
        '<td>' + availPill(f) + '</td>' +
        '<td>' + badge + '</td>' +
        '<td style="font-size:.875rem;font-weight:600;color:var(--gray-900)">' + f.consultationsThisMonth + '</td>' +
        '<td><button class="tbl-btn" data-view-id="' + esc(f.id) + '"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg> View</button></td>';
      tbody.appendChild(tr);
    });

    tbody.querySelectorAll('[data-view-id]').forEach(function(btn){
      btn.addEventListener('click', function(){
        var f = facultyData.find(function(x){ return x.id === btn.dataset.viewId; });
        if (f) openDetail(f);
      });
    });
  }

  // ── Detail modal ──
  window.openDetail = function(f){
    var modal = document.getElementById('detailModal');
    if (modal) modal.dataset.facultyId = f.id;
    document.getElementById('detailAvatar').textContent  = initials(f.name);
    document.getElementById('detailName').textContent    = f.name;
    document.getElementById('detailPos').textContent     = f.position;
    document.getElementById('detailDept').textContent    = f.department || '—';
    document.getElementById('detailRoom').textContent    = f.officeRoom;
    // Where they are now, which is not their office and can change while this
    // panel is open. Only claimed when a scanner actually reports them inside.
    document.getElementById('detailDetectedRoom').textContent =
      f.bleStatus === 'in-room' ? (f.detectedRoom || 'In a room') : '—';
    document.getElementById('detailAvail').innerHTML     = availPill(f);
    document.getElementById('detailLastSeen').textContent = f.bleLastDetected || 'Never detected';
    document.getElementById('detailHours').textContent   = f.hoursThisMonth + 'h';
    document.getElementById('detailConsult').textContent = f.consultationsThisMonth;
    document.getElementById('detailAvg').textContent     = f.avgDuration || '—';
    document.getElementById('detailBle').innerHTML =
      f.bleStatus === 'in-room'     ? '<span class="table-badge confirmed">In Room</span>' :
      f.bleStatus === 'out-of-room' ? '<span class="table-badge declined">Out of Room</span>' :
                                      '<span class="table-badge">Awaiting BLE data</span>';
    openModal('detailModal');
  };

  // ── Rooms view ──────────────────────────────────────────────────────────
  // Type -> the pill's modifier class
  var ROOM_TYPE_CLASS = {
    'Lecture': 'lecture',
    'Laboratory': 'laboratory',
    'Faculty Lounge': 'lounge',
    'Faculty Office': 'office',
    'Consultation Room': 'consultation',
  };
  var roomTypeFilter = 'all';

  /**
   * Instructors BLE currently reports inside a room. Empty until the scanners
   * are installed — the room card says so rather than implying the room is empty.
   */
  function occupantsOf(room) {
    return facultyData.filter(function(f){
      return f.bleStatus === 'in-room' && String(f.detectedRoomId) === String(room.id);
    });
  }

  /** Faculty whose base office this room is — known without any BLE at all. */
  function assignedTo(room) {
    return facultyData.filter(function(f){ return String(f.baseRoomId) === String(room.id); });
  }

  function renderRooms(){
    var grid = document.getElementById('roomGrid');
    if (!grid) return;
    var q = (document.getElementById('facSearch').value || '').toLowerCase().trim();

    var list = roomData.filter(function(r){
      if (roomTypeFilter !== 'all' && r.room_type !== roomTypeFilter) return false;
      if (!q) return true;
      // Searching for a person should surface the room they are in
      var people = occupantsOf(r).concat(assignedTo(r))
        .map(function(f){ return f.name.toLowerCase(); }).join(' ');
      return (r.room_number || '').toLowerCase().indexOf(q) !== -1 ||
             (r.room_type || '').toLowerCase().indexOf(q) !== -1 ||
             people.indexOf(q) !== -1;
    });

    grid.innerHTML = '';
    document.getElementById('roomNoResults').style.display = list.length ? 'none' : 'block';

    list.forEach(function(r){
      var inside = occupantsOf(r);
      var assigned = assignedTo(r);

      var card = document.createElement('div');
      card.className = 'room-card' +
        (inside.length ? ' occupied' : '') +
        (r.status === 'Inactive' ? ' inactive' : '');

      var occupantHtml;
      if (inside.length) {
        occupantHtml = inside.map(function(f){
          return '<div class="room-occ">' +
              '<div class="room-occ-avatar">' + initials(f.name) + '</div>' +
              '<div><p class="room-occ-name">' + esc(f.name) + '</p>' +
              '<p class="room-occ-sub">' + esc(f.bleLastDetected || 'just now') + '</p></div>' +
            '</div>';
        }).join('');
      } else if (assigned.length) {
        occupantHtml = '<p class="room-occ-empty">No one detected — assigned to ' +
          assigned.map(function(f){ return esc(f.name); }).join(', ') + '</p>';
      } else {
        occupantHtml = '<p class="room-occ-empty">No one detected</p>';
      }

      card.innerHTML =
        '<div class="room-card-head">' +
          '<div>' +
            '<p class="room-number">' + esc(r.room_number) + '</p>' +
            '<p class="room-meta">' + (r.capacity ? 'Capacity ' + esc(r.capacity) : 'Capacity not set') + '</p>' +
          '</div>' +
          '<span class="room-type-pill ' + (ROOM_TYPE_CLASS[r.room_type] || '') + '">' + esc(r.room_type) + '</span>' +
        '</div>' +
        '<div class="room-occupants">' +
          '<p class="room-occ-label">Currently inside' + (inside.length ? ' (' + inside.length + ')' : '') + '</p>' +
          occupantHtml +
        '</div>' +
        '<div class="room-foot">' +
          '<span class="room-ble ' + (r.is_ble_scanner_installed ? 'on' : 'off') + '">' +
            '<span class="room-ble-dot"></span>' +
            (r.is_ble_scanner_installed ? 'BLE scanner installed' : 'No scanner') +
          '</span>' +
          '<span class="room-select-hint">' +
            (String(selectedRoomId) === String(r.id) ? 'Monitoring' : 'Monitor') +
          '</span>' +
        '</div>';

      if (String(selectedRoomId) === String(r.id)) card.classList.add('selected');

      // A second click picks the room the full-screen board will follow;
      // clicking the selected one again goes back to the whole department.
      card.tabIndex = 0;
      card.addEventListener('click', function(){ toggleRoom(r.id); });
      card.addEventListener('keydown', function(e){
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggleRoom(r.id); }
      });

      grid.appendChild(card);
    });
  }

  /** Which room the full-screen board is pinned to, or null for everyone. */
  var selectedRoomId = null;

  function selectedRoom(){
    return roomData.find(function(r){ return String(r.id) === String(selectedRoomId); }) || null;
  }

  function toggleRoom(id){
    selectedRoomId = String(selectedRoomId) === String(id) ? null : id;
    renderRooms();
    syncRoomBanner();
    renderBoard();
  }

  function syncRoomBanner(){
    var banner = document.getElementById('roomSelectBanner');
    if (!banner) return;
    var room = selectedRoom();
    banner.hidden = !room;
    if (room) {
      document.getElementById('roomSelectText').textContent =
        'Full screen will monitor ' + room.room_number + ' — only instructors detected inside are shown.';
    }
  }

  document.querySelectorAll('.room-type-btn').forEach(function(btn){
    btn.addEventListener('click', function(){
      document.querySelectorAll('.room-type-btn').forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      roomTypeFilter = btn.dataset.roomType;
      renderRooms();
    });
  });

  // ── View toggle ──
  // Cards stays the default, so nothing changes for anyone not looking for rooms
  function showView(name){
    var views = { cards: 'cardView', table: 'tableView', rooms: 'roomsView' };
    var buttons = { cards: 'btnCards', table: 'btnTable', rooms: 'btnRooms' };
    Object.keys(views).forEach(function(key){
      var el = document.getElementById(views[key]);
      if (el) el.style.display = key === name ? '' : 'none';
      document.getElementById(buttons[key]).classList.toggle('active', key === name);
    });
    // The status filter has no meaning over rooms
    document.getElementById('filterStatus').style.display = name === 'rooms' ? 'none' : '';
    document.getElementById('facSearch').placeholder =
      name === 'rooms' ? 'Search rooms or faculty...' : 'Search faculty...';
    if (name === 'rooms') renderRooms();
  }

  document.getElementById('btnCards').addEventListener('click', function(){ showView('cards'); });
  document.getElementById('btnTable').addEventListener('click', function(){ showView('table'); });
  document.getElementById('btnRooms').addEventListener('click', function(){ showView('rooms'); });

  document.getElementById('filterStatus').addEventListener('change', render);
  document.getElementById('facSearch').addEventListener('input', function(){
    render();
    renderRooms();
  });

  // ── Full screen board ──
  var fadeTimer = null;
  var closeBtn = document.getElementById('previewClose');
  var clockInterval = null;

  /* ── The travel and leave panels ──────────────────────────────────────
     Rendered here rather than on the server so a status changed while the
     board is up appears without a reload — the live feed already merges
     availability into facultyData, and renderBoard() calls this.

     Each panel shows a handful and then offers the rest, so a department with
     a dozen people away does not push the main grid off the screen. The
     expanded state is per panel and survives a re-render, because a dean who
     opened one to read it should not have it close under them when somebody
     across campus walks into a room. */

  var PANEL_VISIBLE = 6;
  var panelExpanded = { travel: false, leave: false };

  function miniCard(f, kind) {
    var card = document.createElement('div');
    card.className = 'fs-mini-card ' + kind;

    var face = f.photo
      ? '<img src="' + esc(f.photo) + '" alt="" loading="lazy">'
      : '<span class="fs-mini-initials">' + esc(initials(f.name)) + '</span>';

    card.innerHTML =
      '<div class="fs-mini-photo">' + face + '</div>' +
      '<div><p class="fs-mini-name">' + esc(f.name) + '</p>' +
      '<p class="fs-mini-sub">' + esc(f.position) + '</p></div>';

    // Same fallback as the main board: a missing file must not leave a hole.
    var img = card.querySelector('.fs-mini-photo img');
    if (img) {
      img.addEventListener('error', function () {
        img.remove();
        var holder = card.querySelector('.fs-mini-photo');
        if (holder && !holder.querySelector('.fs-mini-initials')) {
          var span = document.createElement('span');
          span.className = 'fs-mini-initials';
          span.textContent = initials(f.name);
          holder.appendChild(span);
        }
      });
    }
    return card;
  }

  function fillPanel(gridId, kind, list, emptyText) {
    var grid = document.getElementById(gridId);
    if (!grid) return;
    grid.innerHTML = '';

    if (!list.length) {
      var none = document.createElement('p');
      none.className = 'fs-bottom-empty';
      none.textContent = emptyText;
      grid.appendChild(none);
      return;
    }

    var expanded = panelExpanded[kind];
    var shown = expanded ? list : list.slice(0, PANEL_VISIBLE);
    shown.forEach(function (f) { grid.appendChild(miniCard(f, kind)); });

    var hidden = list.length - shown.length;
    if (hidden > 0 || expanded) {
      var more = document.createElement('button');
      more.type = 'button';
      more.className = 'fs-mini-more';
      more.textContent = expanded ? 'Show fewer' : '+' + hidden + ' more';
      more.setAttribute('aria-expanded', String(expanded));
      more.addEventListener('click', function () {
        panelExpanded[kind] = !panelExpanded[kind];
        renderBottomPanels();
      });
      grid.appendChild(more);
    }
  }

  function renderBottomPanels() {
    var travel = facultyData.filter(function (f) { return f.availability === 'travel'; });
    var leave  = facultyData.filter(function (f) { return f.availability === 'leave'; });

    // Alphabetical: a list that reorders itself as people move is unreadable.
    travel.sort(function (a, b) { return a.name.localeCompare(b.name); });
    leave.sort(function (a, b) { return a.name.localeCompare(b.name); });

    fillPanel('fsTravelGrid', 'travel', travel, 'Nobody is on official travel');
    fillPanel('fsLeaveGrid', 'leave', leave, 'Nobody is on leave');
  }

  /**
   * Only the close button follows the mouse.
   *
   * The header carries the room being shown and the clock — content, not
   * chrome. Hiding it after three idle seconds made the board harder to read
   * from across the room, which is the one thing it exists for.
   */
  function showChrome(){
    closeBtn.classList.remove('faded');
    clearTimeout(fadeTimer);
    fadeTimer = setTimeout(function(){
      closeBtn.classList.add('faded');
    }, 3000);
  }

  /**
   * Draws the board.
   *
   * With a room selected it shows only who BLE reports inside it — anyone who
   * leaves drops off the board, which is the point of pinning a room. With no
   * room selected it lists every instructor with their current room, and
   * nothing is abbreviated.
   */
  function renderBoard(){
    var grid = document.getElementById('fsGrid');
    if (!grid) return;

    var room = selectedRoom();
    var list = room
      ? facultyData.filter(function(f){
          return f.bleStatus === 'in-room' && String(f.detectedRoomId) === String(room.id);
        })
      : facultyData.slice().sort(function(a, b){
          // In-room first so a wall display leads with who is actually around
          var rank = { 'in-room': 0, 'out-of-room': 1, 'unknown': 2 };
          return (rank[a.bleStatus] - rank[b.bleStatus]) || a.name.localeCompare(b.name);
        });

    document.getElementById('fsTitle').textContent = room ? room.room_number : 'Faculty Monitoring';
    document.getElementById('fsSubtitle').textContent = room
      ? room.room_type + ' · ' + list.length + ' inside'
      : facultyData.length + ' instructor' + (facultyData.length === 1 ? '' : 's');
    // The In/Out key means nothing on a board showing only people who are in
    document.getElementById('fsLegend').style.display = room ? 'none' : '';

    var note = document.getElementById('fsPresenceNote');
    if (note) note.style.display = room ? 'none' : '';

    grid.innerHTML = '';
    list.forEach(function(f){
      var cls = f.bleStatus === 'in-room' ? 'in' : (f.bleStatus === 'out-of-room' ? 'out' : 'unknown');
      var card = document.createElement('div');
      card.className = 'fs-card ' + cls;
      card.dataset.name = f.name.toLowerCase();

      // Current room, said plainly — never the office standing in for a detection
      var whereText = f.bleStatus === 'in-room'
        ? (f.detectedRoom || 'In a room')
        : (f.bleStatus === 'out-of-room' ? 'Not in a room' : 'No presence data');

      // A face is what makes this board readable from across a room — a wall
      // of identical silhouettes is not. Initials stand in when there is no
      // photo, rather than a generic outline that tells nobody anything.
      var face = f.photo
        ? '<img src="' + esc(f.photo) + '" alt="" loading="lazy">'
        : '<span class="fs-initials">' + esc(initials(f.name)) + '</span>';

      card.innerHTML =
        '<div class="fs-photo">' + face + '</div>' +
        '<p class="fs-name">' + esc(f.name) + '</p>' +
        '<p class="fs-room">' + esc(room ? (f.bleLastDetected || 'just now') : whereText) + '</p>';

      // A photo whose file has gone missing must not leave an empty circle —
      // the row can outlive the upload.
      var img = card.querySelector('.fs-photo img');
      if (img) {
        img.addEventListener('error', function () {
          img.remove();
          var holder = card.querySelector('.fs-photo');
          if (holder && !holder.querySelector('.fs-initials')) {
            var span = document.createElement('span');
            span.className = 'fs-initials';
            span.textContent = initials(f.name);
            holder.appendChild(span);
          }
        });
      }

      grid.appendChild(card);
    });

    // The bottom panels follow the same data, so they refresh together.
    renderBottomPanels();

    var empty = document.getElementById('fsNoResults');
    if (empty) {
      empty.style.display = list.length ? 'none' : 'block';
      empty.textContent = room
        ? 'No one is currently detected in ' + room.room_number + '.'
        : 'No instructor found.';
    }
  }

  document.getElementById('roomSelectClear').addEventListener('click', function(){
    selectedRoomId = null;
    renderRooms();
    syncRoomBanner();
    renderBoard();
  });

  function updateBoardClock(){
    var now = new Date();
    var h = now.getHours();
    var m = String(now.getMinutes()).padStart(2,'0');
    var ampm = h >= 12 ? 'PM' : 'AM';
    h = h % 12 || 12;
    document.getElementById('fsClock').textContent = String(h).padStart(2,'0') + ':' + m;
    document.getElementById('fsAmpm').textContent  = ampm;
  }

  function openPreview(){
    // Redraw on open so the board reflects whichever room is selected now
    renderBoard();
    document.getElementById('previewOverlay').classList.add('open');
    document.body.style.overflow = 'hidden';
    showChrome();
    updateBoardClock();
    clockInterval = setInterval(updateBoardClock, 1000);
  }
  function closePreview(){
    document.getElementById('previewOverlay').classList.remove('open');
    document.body.style.overflow = '';
    clearTimeout(fadeTimer);
    if (clockInterval){ clearInterval(clockInterval); clockInterval = null; }
  }

  document.getElementById('previewOverlay').addEventListener('mousemove', showChrome);
  document.getElementById('previewOverlay').addEventListener('touchstart', showChrome);
  document.getElementById('btnFullPreview').addEventListener('click', openPreview);
  closeBtn.addEventListener('click', closePreview);
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape'){ closePreview(); closeModal('detailModal'); }
  });
  document.getElementById('detailModal').addEventListener('click', function(e){
    if (e.target === this) closeModal('detailModal');
  });

  /* ── Live presence ──
     Everything on this page is grouped by bleStatus, so a stale value does not
     just show the wrong badge — it files someone under the wrong heading and
     miscounts it. Merging into the array the page already renders from means
     the sections, the counts, the table and the room board all follow. */
  if (window.PresenceLive) {
    window.PresenceLive.onUpdate(function (live) {
      var byId = {};
      live.forEach(function (f) { byId[f.id] = f; });

      var changed = false;
      facultyData.forEach(function (f) {
        var entry = byId[f.id];
        if (!entry) return;
        if (f.bleStatus !== entry.presence) { f.bleStatus = entry.presence; changed = true; }
        if (f.availability !== entry.availability) {
          f.availability = entry.availability;
          f.availabilityLabel = entry.availabilityLabel;
          changed = true;
        }

        // Moving between two rooms changes neither the presence nor the
        // availability, so without this the card and the room board kept
        // whichever room was true when the page loaded — somebody could walk
        // from one laboratory to the next and this page would never say so.
        // 'room' is absent for any role not shown rooms, and skipping the
        // merge in that case leaves what the server rendered untouched.
        if ('room' in entry) {
          if (f.detectedRoom !== entry.room) { f.detectedRoom = entry.room; changed = true; }
          if (String(f.detectedRoomId) !== String(entry.roomId)) {
            f.detectedRoomId = entry.roomId;
            changed = true;
          }
        }
      });

      // Re-rendering rebuilds every card, which would fight someone mid-search
      // or with a modal open for no reason if nothing actually moved.
      if (!changed) return;
      render();
      renderRooms();
      renderBoard();

      // The detail panel is not rebuilt by render(), so somebody left reading
      // it would keep the room that was true when they opened it.
      var panel = document.getElementById('detailModal');
      if (panel && panel.classList.contains('open') && panel.dataset.facultyId) {
        var shownId = panel.dataset.facultyId;
        for (var i = 0; i < facultyData.length; i++) {
          if (String(facultyData[i].id) === shownId) { window.openDetail(facultyData[i]); break; }
        }
      }
    });
  }

  render();
  renderRooms();
  syncRoomBanner();
  renderBoard();
}());
</script>
