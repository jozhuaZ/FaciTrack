    <button class="fs-close-btn" id="previewClose" title="Exit (Esc)">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>

    <div class="fs-header" id="fsHeader">
      <div class="fs-header-left">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563eb" stroke-width="2.5" style="flex-shrink:0"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <div style="min-width:0">
          <h2 class="fs-board-title" id="fsTitle">Faculty Monitoring</h2>
          <p class="fs-board-sub" id="fsSubtitle"></p>
        </div>
      </div>
