<%- include('../../partials/script') %>

<script>
// ===== Tab Switching =====
function switchReport(name, btn) {
    // Hide all sections
    document.querySelectorAll('.report-section').forEach(function(s) {
        s.classList.remove('active');
    });
    // Deactivate all tabs
    document.querySelectorAll('.report-tab').forEach(function(t) {
        t.classList.remove('active');
    });
    // Show target section
    var section = document.getElementById('section-' + name);
    if (section) section.classList.add('active');
    // Activate clicked tab
    if (btn) btn.classList.add('active');
}

// ===== Data =====
var ALL_SLOTS        = <%- JSON.stringify(typeof slots !== 'undefined' ? slots : []) %>;
var ALL_APPOINTMENTS = <%- JSON.stringify(typeof allAppointments !== 'undefined' ? allAppointments : []) %>;
var ALL_LOGS         = <%- JSON.stringify(typeof logs !== 'undefined' ? logs : []) %>;
var PAGE = 20;

// ===== Helpers =====
function esc(s) {
    return String(s || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function emptyRow(cols, message) {
    return '<tr><td colspan="' + cols + '">'
        + '<div class="empty-state">'
        + '<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">'
        + '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>'
        + '</svg>'
        + '<p>' + esc(message) + '</p>'
        + '</div>'
        + '</td></tr>';
}

function badgeHtml(status) {
    var map = {
        pending:   'pending',
        confirmed: 'confirmed',
        declined:  'declined',
        login:     'confirmed',
        logout:    'pending',
        update:    'workload',
        create:    'presence',
        delete:    'declined',
        Available: 'confirmed',
        Booked:    'workload',
        Booking:   'pending'
    };
    var cls = map[status] || 'pending';
    return '<span class="table-badge ' + cls + '">' + esc(status) + '</span>';
}

function renderPagination(idPrev, idNext, idInfo, idBar, page, total) {
    var pages = Math.max(1, Math.ceil(total / PAGE));
    var bar   = document.getElementById(idBar);
    var info  = document.getElementById(idInfo);
    var prev  = document.getElementById(idPrev);
    var next  = document.getElementById(idNext);
    if (!bar) return;
    if (total === 0) { bar.style.display = 'none'; return; }
    bar.style.display = 'flex';
    var start = (page - 1) * PAGE + 1;
    var end   = Math.min(page * PAGE, total);
    if (info)  info.textContent = 'Showing ' + start + '-' + end + ' of ' + total;
    if (prev)  prev.disabled = (page <= 1);
    if (next)  next.disabled = (page >= pages);
}

// ===== Consultation Slots =====
var csPage = 1;
var csSearch = '';
var csStatus = 'all';

function filterCs() {
    var rows = ALL_SLOTS.slice();
    if (csStatus !== 'all') rows = rows.filter(function(s) { return s.status === csStatus; });
    if (csSearch) {
        var q = csSearch.toLowerCase();
        rows = rows.filter(function(s) {
            return (s.instructor || '').toLowerCase().indexOf(q) >= 0
                || (s.student || '').toLowerCase().indexOf(q) >= 0;
        });
    }
    return rows;
}

function renderCsTable() {
    var tbody = document.getElementById('csReportBody');
    if (!tbody) return;
    var rows = filterCs();
    if (rows.length === 0) {
        tbody.innerHTML = emptyRow(8, 'No Consultation Slot records found');
        renderPagination('csReportPrev', 'csReportNext', 'csReportPageInfo', 'csReportPagBar', csPage, 0);
        return;
    }
    var pages = Math.max(1, Math.ceil(rows.length / PAGE));
    if (csPage > pages) csPage = pages;
    var start = (csPage - 1) * PAGE;
    var slice = rows.slice(start, start + PAGE);
    tbody.innerHTML = slice.map(function(s, i) {
        var t = (s.start_time || '') + (s.end_time ? ' - ' + s.end_time : '');
        return '<tr>'
            + '<td>' + (start + i + 1) + '</td>'
            + '<td>' + esc(s.date) + (s.day ? ' &mdash; ' + s.day : '') + '</td>'
            + '<td style="white-space:nowrap">' + esc(t) + '</td>'
            + '<td style="font-weight:600">' + esc(s.instructor) + '</td>'
            + '<td>' + esc(s.mode || '—') + '</td>'
            + '<td>' + badgeHtml(s.status) + '</td>'
            + '<td>' + esc(s.student || '—') + '</td>'
            + '<td>' + esc(s.room || '—') + '</td>'
            + '</tr>';
    }).join('');
    renderPagination('csReportPrev', 'csReportNext', 'csReportPageInfo', 'csReportPagBar', csPage, rows.length);
}

document.getElementById('csReportPrev').addEventListener('click', function() {
    if (csPage > 1) { csPage--; renderCsTable(); }
});
document.getElementById('csReportNext').addEventListener('click', function() {
    var pages = Math.ceil(filterCs().length / PAGE);
    if (csPage < pages) { csPage++; renderCsTable(); }
});

// ===== Appointments =====
var clPage   = 1;
var clPeriod = 'all';
var clStatus = 'all';
var clSearch = '';

function filterCl() {
    var rows = ALL_APPOINTMENTS.slice();
    if (clStatus !== 'all') rows = rows.filter(function(a) { return a.status === clStatus; });
    if (clSearch) {
        var q = clSearch.toLowerCase();
        rows = rows.filter(function(a) {
            return (a.studentName || '').toLowerCase().indexOf(q) >= 0
                || (a.instructorName || '').toLowerCase().indexOf(q) >= 0
                || (a.topic || '').toLowerCase().indexOf(q) >= 0;
        });
    }
    return rows;
}

function renderClTable() {
    var tbody = document.getElementById('clReportBody');
    if (!tbody) return;
    var rows  = filterCl();
    if (rows.length === 0) {
        tbody.innerHTML = emptyRow(6, 'No Appointment records found');
        renderPagination('clReportPrev', 'clReportNext', 'clReportPageInfo', 'clReportPagBar', clPage, 0);
        return;
    }
    var pages = Math.max(1, Math.ceil(rows.length / PAGE));
    if (clPage > pages) clPage = pages;
    var start = (clPage - 1) * PAGE;
    var slice = rows.slice(start, start + PAGE);
    tbody.innerHTML = slice.map(function(a) {
        return '<tr>'
            + '<td><div style="display:flex;align-items:center;gap:.5rem">'
            + '<div class="apt-avatar-xs" style="width:32px;height:32px;font-size:.625rem;flex-shrink:0">' + esc((a.studentName || '?').split(' ').map(function(n){return n[0]||'';}).join('').slice(0,2).toUpperCase()) + '</div>'
            + '<span style="font-weight:600;font-size:.875rem">' + esc(a.studentName) + '</span></div></td>'
            + '<td style="font-size:.875rem">' + esc(a.instructorName) + '</td>'
            + '<td style="font-size:.875rem">' + esc(a.date) + '</td>'
            + '<td style="font-size:.875rem">' + esc(a.time) + '</td>'
            + '<td style="font-size:.875rem;max-width:220px;white-space:normal">' + esc(a.topic) + '</td>'
            + '<td>' + badgeHtml(a.status) + '</td>'
            + '</tr>';
    }).join('');
    renderPagination('clReportPrev', 'clReportNext', 'clReportPageInfo', 'clReportPagBar', clPage, rows.length);
}

document.getElementById('clReportPrev').addEventListener('click', function() {
    if (clPage > 1) { clPage--; renderClTable(); }
});
document.getElementById('clReportNext').addEventListener('click', function() {
    var pages = Math.ceil(filterCl().length / PAGE);
    if (clPage < pages) { clPage++; renderClTable(); }
});

// Wire up filter-bar for appointments (cl)
document.addEventListener('fbChange', function(e) {
    if (!e.detail) return;
    var id = e.detail.filterId, key = e.detail.section, val = e.detail.value;
    if (id === 'cs') {
        if (key === 'status') { csStatus = val; csPage = 1; renderCsTable(); }
    }
    if (id === 'cl') {
        if (key === 'status') { clStatus = val; clPage = 1; renderClTable(); }
        if (key === 'period') { clPeriod = val; clPage = 1; renderClTable(); }
    }
    if (id === 'al') {
        alPage = 1; renderAlTable();
    }
});
document.addEventListener('fbSearch', function(e) {
    if (!e.detail) return;
    if (e.detail.filterId === 'cs') { csSearch = e.detail.value; csPage = 1; renderCsTable(); }
    if (e.detail.filterId === 'cl') { clSearch = e.detail.value; clPage = 1; renderClTable(); }
    if (e.detail.filterId === 'al') { alSearch = e.detail.value; alPage = 1; renderAlTable(); }
});

// ===== Audit Logs =====
var alPage   = 1;
var alSearch = '';

function filterAl() {
    var rows = ALL_LOGS.slice();
    if (alSearch) {
        var q = alSearch.toLowerCase();
        rows = rows.filter(function(l) {
            return (l.user || '').toLowerCase().indexOf(q) >= 0
                || (l.role || '').toLowerCase().indexOf(q) >= 0
                || (l.email || '').toLowerCase().indexOf(q) >= 0;
        });
    }
    return rows;
}

function renderAlTable() {
    var tbody = document.getElementById('alReportBody');
    if (!tbody) return;
    var rows = filterAl();
    if (rows.length === 0) {
        tbody.innerHTML = emptyRow(4, 'No Audit Log records found');
        renderPagination('alReportPrev', 'alReportNext', 'alReportPageInfo', 'alReportPagBar', alPage, 0);
        return;
    }
    var pages = Math.max(1, Math.ceil(rows.length / PAGE));
    if (alPage > pages) alPage = pages;
    var start = (alPage - 1) * PAGE;
    var slice = rows.slice(start, start + PAGE);
    tbody.innerHTML = slice.map(function(l) {
        return '<tr>'
            + '<td style="font-weight:600;font-size:.875rem">' + esc(l.user) + '</td>'
            + '<td><span class="table-badge ' + (l.role === 'Admin' ? 'confirmed' : l.role === 'Dean' ? 'workload' : 'presence') + '">' + esc(l.role) + '</span></td>'
            + '<td style="font-size:.875rem">' + esc(l.email) + '</td>'
            + '<td style="font-size:.8125rem;color:var(--gray-500)">' + esc(l.timestamp) + '</td>'
            + '</tr>';
    }).join('');
    renderPagination('alReportPrev', 'alReportNext', 'alReportPageInfo', 'alReportPagBar', alPage, rows.length);
}

document.getElementById('alReportPrev').addEventListener('click', function() {
    if (alPage > 1) { alPage--; renderAlTable(); }
});
document.getElementById('alReportNext').addEventListener('click', function() {
    var pages = Math.ceil(filterAl().length / PAGE);
    if (alPage < pages) { alPage++; renderAlTable(); }
});

// ===== Initial Render =====
renderCsTable();
renderClTable();
renderAlTable();

// ===== Print Helper =====
function preparePrintReport(btn) {
    var preview = btn.closest('.report-preview');
    if (!preview) return;
    preview.querySelectorAll('.report-header-block').forEach(function(hdr) {
        var existing = hdr.querySelector('.print-header-inner');
        if (existing) existing.remove();
        var titleEl    = hdr.querySelector('.report-title-block');
        var subtitleEl = hdr.querySelector('.report-subtitle');
        var imgEl      = hdr.querySelector('img');
        var title    = titleEl    ? titleEl.textContent.trim() : '';
        var subtitle = subtitleEl ? subtitleEl.textContent.trim() : '';
        var imgSrc   = imgEl      ? imgEl.src : '/images/CSPC-logo.png';
        var inner = document.createElement('div');
        inner.className = 'print-header-inner';
        inner.innerHTML =
            '<img src="' + imgSrc + '" alt="CSPC Logo">'
            + '<div class="print-header-text">'
            + '<span class="ph-republic">Republic of the Philippines</span>'
            + '<span class="ph-institution">Camarines Sur Polytechnic Colleges</span>'
            + '<span class="ph-address">Nabua, Camarines Sur</span>'
            + '<span class="ph-title">' + title + '</span>'
            + '<span class="ph-subtitle">' + subtitle + '</span>'
            + '</div>';
        hdr.appendChild(inner);
    });
    document.body.classList.add('print-mode');
    preview.classList.add('print-only');
    setTimeout(function() {
        window.print();
        setTimeout(function() {
            preview.classList.remove('print-only');
            document.body.classList.remove('print-mode');
            preview.querySelectorAll('.print-header-inner').forEach(function(el) { el.remove(); });
        }, 500);
    }, 50);
}
</script>
