<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/instructor/dashboard.css?v=<%= Date.now() %>">
<style>
@media print{
  @page{size:A4 portrait;margin:1.5cm}
  *{box-sizing:border-box!important;-webkit-print-color-adjust:exact!important;print-color-adjust:exact!important}
  html,body{width:100%!important;height:auto!important;margin:0!important;padding:0!important;background:#fff!important;color:#000!important;font-family:'Arial','Helvetica',sans-serif!important}
  body.print-mode .report-preview:not(.print-only){display:none!important}
  .instructor-layout,.instructor-main,.main-container{width:100%!important;margin:0!important;padding:0!important;display:block!important;overflow:visible!important}
  .instructor-sidebar,.sidebar-footer,.header-actions,.stats-overview,.pagination-bar,.toast-container,.page-header,.filter-bar-container,.fb-bar,.fb-filter-menu,.dropdown-menu,.btn-header-action,.main-header{display:none!important}
  .content-card{box-shadow:none!important;border:none!important;border-radius:0!important;background:#fff!important;margin:0!important;padding:0!important}
  .card-header,.card-body{padding:0!important;margin:0!important;background:transparent!important;border:none!important;box-shadow:none!important}
  .report-preview{display:block!important;margin:0!important;padding:0!important;width:100%!important}
  .report-preview.print-only{display:block!important}
  .report-preview + .report-preview{page-break-before:always!important}
  /* ── Official CSPC Letterhead Header ── */
  .report-header-block{display:block!important;width:100%!important;border-bottom:2.5pt solid #000!important;padding:0 0 0.3cm 0!important;margin:0 0 0.4cm 0!important;position:relative!important;overflow:visible!important}
  .report-header-block::before{content:'CSPC-F-STA-01';display:block!important;font-size:7pt!important;font-weight:700!important;text-align:right!important;position:absolute!important;top:0!important;right:0!important;font-family:'Arial',sans-serif!important}
  .report-header-block > *{display:none!important}
  .report-header-block > .print-header-inner{display:flex!important;align-items:center!important;gap:0.4cm!important;padding-top:0.2cm!important}
  .report-header-block > .print-header-inner > img{width:1.4cm!important;height:1.4cm!important;object-fit:contain!important;flex-shrink:0!important;display:block!important}
  .report-header-block > .print-header-inner > .print-header-text{flex:1!important;text-align:center!important;display:block!important}
  .print-header-inner .ph-republic{display:block!important;font-size:7.5pt!important;font-weight:400!important;font-style:italic!important;text-align:center!important;margin:0!important;line-height:1.4!important}
  .print-header-inner .ph-institution{display:block!important;font-size:13pt!important;font-weight:900!important;text-transform:uppercase!important;text-align:center!important;letter-spacing:0.03em!important;margin:0.04cm 0 0!important;line-height:1.2!important}
  .print-header-inner .ph-address{display:block!important;font-size:8pt!important;text-align:center!important;margin:0.02cm 0 0.12cm!important;line-height:1.3!important}
  .print-header-inner .ph-title{display:block!important;font-size:13pt!important;font-weight:800!important;text-transform:uppercase!important;text-align:center!important;text-decoration:underline!important;letter-spacing:0.04em!important;margin:0.12cm 0 0.04cm!important;line-height:1.2!important}
  .print-header-inner .ph-subtitle{display:block!important;font-size:9pt!important;font-weight:600!important;text-align:center!important;margin:0 0 0.04cm!important}
  .print-header-inner .ph-period{display:block!important;font-size:8pt!important;text-align:center!important;margin:0.04cm 0 0!important;color:#333!important}
  /* ── Table ── */
  div[style*="padding:0 1.5rem"]{padding:0!important}
  div[style*="overflow-x:auto"]{overflow:visible!important}
  .pagination-bar,button{display:none!important}
  .data-table{margin:0!important;padding:0!important;width:100%!important;border-collapse:collapse!important;font-family:'Arial',sans-serif!important;font-size:8.5pt!important}
  .data-table th{background:#e8e8e8!important;border:1pt solid #000!important;padding:0.18cm 0.2cm!important;font-weight:700!important;text-align:left!important;vertical-align:middle!important}
  .data-table td{border:1pt solid #000!important;padding:0.15cm 0.2cm!important;text-align:left!important;vertical-align:top!important}
  .data-table tr:nth-child(even) td{background:#f5f5f5!important}
  .table-badge{background:none!important;border:none!important;padding:0!important;font-weight:700!important;font-size:8pt!important;color:#000!important}
  .apt-avatar-xs{display:none!important}
  .section-divider{border-top:1px solid #000!important;margin:0.3cm 0!important}
}
</style>

<div class="instructor-layout">
    <%- include('../../partials/admin-sidebar', { activePage: 'reports' }) %>
    <main class="instructor-main">
        <div class="main-container">

            <div class="page-header">
                <div>
                    <h1 class="page-title">Reports</h1>
                    <p class="page-subtitle">System audit records — College of Computer Studies</p>
                </div>
            </div>

            <!-- Audit Logs Report -->
            <div class="content-card">

              <div class="card-header">
                  <h3 class="card-title">
                      Audit Logs (<span id="alReportCount">0</span>)
                  </h3>
              </div>

              <%- include('../../partials/filter-bar', {
                  filterId: 'al',
                  searchPlaceholder: 'Search user or action…',
                  filterSections: [
                      {
                          label: 'By Type',
                          key: 'type',
                          type: 'buttons',
                          items: [
                              { value:'all', label:'All Types' },
                              { value:'login', label:'Login' },
                              { value:'logout', label:'Logout' },
                              { value:'navigation', label:'Navigation' },
                              { value:'users', label:'User' },
                              { value:'appointments', label:'Appointment' },
                              { value:'workload', label:'Workload' },
                              { value:'rooms', label:'Room' }
                          ]
                      },
                      {
                          label: 'By Role',
                          key: 'role',
                          type: 'buttons',
                          items: [
                              { value:'all', label:'All Roles' },
                              { value:'Admin', label:'Admin' },
                              { value:'Dean', label:'Dean' },
                              { value:'Instructor', label:'Instructor' },
                              { value:'Student', label:'Student' }
                          ]
                      }
                  ]
              }) %>

              <div class="card-body" style="padding:0;">

                  <div style="overflow-x:auto;">

                      <table class="data-table" id="auditLogTable">

                          <thead>
                              <tr>
                                  <th>#</th>
                                  <th>User</th>
                                  <th>Role</th>
                                  <th>Action</th>
                                  <th>Type</th>
                                  <th>Timestamp</th>
                              </tr>
                          </thead>

                          <tbody id="alReportBody">
                          </tbody>

                      </table>

                  </div>

              </div>

              <div class="pagination-bar">

                  <span class="page-info" id="alReportPageInfo">
                      -
                  </span>

                  <div class="pagination-controls">

                      <button class="btn-page" id="alReportPrev" disabled>
                          ← Prev
                      </button>

                      <button class="btn-page" id="alReportNext" disabled>
                          Next →
                      </button>

                  </div>

              </div>

          </div>

        </div>
    </main>
</div>

<div class="toast-container" id="toastContainer"></div>
<%- include('../../partials/footer') %>
<%- include('../../partials/script') %>
<script>
(function(){
  const PAGE = 10;

  function esc(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function parseDate(v){ var d = new Date(v); return isNaN(d.getTime()) ? null : d; }
  function formatDate(v){ var d = parseDate(v); return d ? d.toLocaleDateString('en-PH', { month:'long', day:'numeric', year:'numeric' }) : '—'; }

  function weekRange(){
    var d=new Date(), s=new Date(d);
    s.setDate(d.getDate()-d.getDay());
    var e=new Date(s); e.setDate(s.getDate()+6);
    return {s:s, e:e};
  }
  function monthRange(){
    var d=new Date();
    return {s:new Date(d.getFullYear(),d.getMonth(),1), e:new Date(d.getFullYear(),d.getMonth()+1,0)};
  }

  // ===== Audit Logs Report =====
  var LOGS = <%- JSON.stringify(logs) %>;
  var alPage = 1, alType = 'all', alRole = 'all', alSearch = '';
  var alBody = document.getElementById('alReportBody');
  var alPageInfo = document.getElementById('alReportPageInfo');
  var alFilterText = document.getElementById('alReportFilterText');

  function filterAlRows(){
    var rows = LOGS.slice();
    if(alType !== 'all') rows = rows.filter(function(l){ return l.type===alType; });
    if(alRole !== 'all') rows = rows.filter(function(l){ return l.role===alRole; });
    if (alSearch) {
      rows = rows.filter(function (l) {

          const user =
              ((l.first_name || '') + ' ' + (l.last_name || ''))
                  .toLowerCase();

          const action =
              (l.action || '').toLowerCase();

          return user.includes(alSearch) ||
                action.includes(alSearch);
      });
  }
    return rows;
  }

  function renderAlTable(rows) {
      const total = rows.length;
      const pages = Math.max(1, Math.ceil(total / PAGE));

      if (alPage > pages) alPage = pages;

      const start = (alPage - 1) * PAGE;
      const slice = rows.slice(start, start + PAGE);

      alBody.innerHTML = '';

      if (!slice.length) {
          alBody.innerHTML = `
              <tr>
                  <td colspan="6" style="text-align:center;padding:2rem;color:var(--gray-400)">
                      No audit logs found.
                  </td>
              </tr>
          `;
      } else {
          slice.forEach(function (log) {

              const tr = document.createElement('tr');

              // ─────────────────────────────
              // TYPE BADGE STYLE
              // ─────────────────────────────
              let badgeTypeClass = 'pending';

              switch (log.type) {
                  case 'login':
                      badgeTypeClass = 'confirmed';
                      break;

                  case 'logout':
                      badgeTypeClass = 'declined';
                      break;

                  case 'navigation':
                      badgeTypeClass = 'pending';
                      break;

                  case 'users':
                      badgeTypeClass = 'workload';
                      break;

                  case 'appointments':
                      badgeTypeClass = 'confirmed';
                      break;

                  case 'workload':
                      badgeTypeClass = 'workload';
                      break;

                  case 'rooms':
                      badgeTypeClass = 'pending';
                      break;

                  default:
                      badgeTypeClass = 'pending';
              }


              // ─────────────────────────────
              // ROLE BADGE STYLE
              // ─────────────────────────────
              let badgeRoleClass = 'confirmed';

              switch (log.role) {
                  case 'Admin':
                      badgeRoleClass = 'workload';
                      break;

                  case 'Dean':
                      badgeRoleClass = 'pending';
                      break;

                  case 'Instructor':
                      badgeRoleClass = 'confirmed';
                      break;

                  case 'Student':
                      badgeRoleClass = 'confirmed';
                      break;

                  default:
                      badgeRoleClass = 'pending';
              }


              // ─────────────────────────────
              // DISPLAY TYPE NAME
              // ─────────────────────────────
              const typeNames = {
                  login: 'Login',
                  logout: 'Logout',
                  navigation: 'Navigation',
                  users: 'User',
                  appointments: 'Appointment',
                  workload: 'Workload',
                  rooms: 'Room'
              };

              const typeLabel =
                  typeNames[log.type] ||
                  log.type.charAt(0).toUpperCase() + log.type.slice(1);


              // ─────────────────────────────
              // TABLE ROW
              // ─────────────────────────────
              tr.innerHTML =
                '<td style="color:var(--gray-400);font-size:0.8125rem;">' +
                    esc(log.id) +
                '</td>' +

                '<td style="font-size:0.8125rem;color:var(--gray-700);">' +
                    esc((log.first_name || '') + ' ' + (log.last_name || '')) +
                '</td>' +

                '<td>' +
                    '<span class="table-badge ' + badgeRoleClass + '">' +
                        esc(log.role) +
                    '</span>' +
                '</td>' +

                '<td style="font-size:0.8125rem;color:var(--gray-700);">' +
                    esc(log.action) +
                '</td>' +

                '<td>' +
                    '<span class="table-badge ' + badgeTypeClass + '">' +
                        esc(typeLabel) +
                    '</span>' +
                '</td>' +

                '<td style="font-size:0.8125rem;color:var(--gray-500);white-space:nowrap;">' +
                    esc(log.created_at) +
                '</td>';

              alBody.appendChild(tr);
          });
      }

      // Count
      document.getElementById('alReportCount').textContent = total;

      // Pagination
      alPageInfo.textContent = total
          ? 'Showing ' + (start + 1) + '-' + Math.min(start + PAGE, total) + ' of ' + total
          : 'No results';

      document.getElementById('alReportPrev').disabled = alPage <= 1;
      document.getElementById('alReportNext').disabled = alPage >= pages;

      updateAlFilter();
  }
  function updateAlFilter() {
      const parts = [];

      const typeNames = {
          login: 'Login',
          logout: 'Logout',
          navigation: 'Navigation',
          users: 'User',
          appointments: 'Appointment',
          workload: 'Workload',
          rooms: 'Room'
      };

      if (alType !== 'all') {
          parts.push(
              'Type: ' + (typeNames[alType] || alType)
          );
      }

      if (alRole !== 'all') {
          parts.push('Role: ' + alRole);
      }

      if (alSearch) {
          parts.push('Search: ' + alSearch);
      }

      if (alFilterText) {
          alFilterText.textContent =
              parts.length > 0
                  ? parts.join(' · ')
                  : 'All Events';
      }
  }
  // Filter handlers for Audit Logs Report
  document.addEventListener('fbChange', function(e){
    if(e.detail.filterId !== 'al') return;
    if(e.detail.section === 'type'){ alType = e.detail.value||'all'; alPage=1; }
    if(e.detail.section === 'role'){ alRole = e.detail.value||'all'; alPage=1; }
    renderAlTable(filterAlRows());
  });

  document.addEventListener('fbSearch', function(e){
    if(e.detail.filterId !== 'al') return;
    alSearch = e.detail.value.toLowerCase();
    alPage = 1;
    renderAlTable(filterAlRows());
  });

  document.getElementById('alReportPrev').addEventListener('click', function(){
    if(alPage>1){ alPage--; renderAlTable(filterAlRows()); }
  });
  document.getElementById('alReportNext').addEventListener('click', function(){
    var r=filterAlRows(), pages=Math.ceil(r.length/PAGE);
    if(alPage<pages){ alPage++; renderAlTable(r); }
  });

  // Initial render
  renderAlTable(filterAlRows());
}());

</script>
