<%- include('../../partials/header') %>
<link rel="stylesheet" href="/css/instructor/dashboard.css?v=<%= assetVersion %>">
<link rel="stylesheet" href="/css/settings-chrome.css?v=<%= assetVersion %>">
<style>
    .settings-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 1.25rem; align-items: start; }
    .settings-section-desc { font-size: .8125rem; color: var(--gray-500); margin: 0 0 1rem; line-height: 1.5; }
    .settings-group { display: flex; flex-direction: column; gap: .875rem; }
    .settings-field { display: flex; flex-direction: column; gap: .3rem; }
    .settings-label { font-size: .75rem; font-weight: 700; color: var(--gray-700); }
    .settings-hint { font-size: .72rem; color: var(--gray-500); margin: 0; line-height: 1.45; }
    .settings-input { width: 100%; padding: .55rem .75rem; border: 1.5px solid var(--gray-200); border-radius: var(--radius-md); font-size: .875rem; font-family: inherit; color: var(--gray-900); outline: none; }
    .settings-input:focus { border-color: var(--primary-blue); box-shadow: 0 0 0 3px rgba(10,61,98,.1); }
    .settings-subhead { font-size: .68rem; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: var(--gray-400); margin: .5rem 0 -.25rem; }
    .settings-divider { border: none; border-top: 1px solid var(--gray-100); margin: .35rem 0 0; }

    .settings-toggle-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .875rem; border: 1px solid var(--gray-200); border-radius: var(--radius-md); background: #fff; transition: border-color .2s, background .2s; }
    .settings-toggle-row:hover { border-color: var(--primary-blue); background: rgba(10,61,98,.02); }
    .settings-toggle-label { font-size: .875rem; font-weight: 600; color: var(--gray-900); margin: 0 0 .125rem; }
    .settings-toggle-desc { font-size: .75rem; color: var(--gray-500); margin: 0; line-height: 1.4; }
    .toggle-switch { position: relative; width: 44px; height: 24px; flex-shrink: 0; }
    .toggle-switch input { opacity: 0; width: 0; height: 0; position: absolute; }
    .toggle-slider { position: absolute; cursor: pointer; inset: 0; background: var(--gray-300); border-radius: 24px; transition: .3s; }
    .toggle-slider:before { content: ''; position: absolute; width: 18px; height: 18px; left: 3px; bottom: 3px; background: #fff; border-radius: 50%; transition: .3s; box-shadow: 0 1px 4px rgba(0,0,0,.2); }
    input:checked + .toggle-slider { background: var(--primary-blue); }
    input:checked + .toggle-slider:before { transform: translateX(20px); }

    .settings-note { display: flex; gap: .55rem; align-items: flex-start; font-size: .72rem; color: var(--gray-500); background: var(--gray-50, #f8fafc); border: 1px solid var(--gray-200); border-radius: var(--radius-md); padding: .6rem .75rem; margin-top: .875rem; line-height: 1.5; }
    .settings-note svg { flex-shrink: 0; margin-top: .1rem; }

    @media (max-width: 640px) {
        .settings-grid { grid-template-columns: 1fr; }
    }
</style>

<div class="instructor-layout">
    <%- include('../../partials/admin-sidebar', { activePage: 'settings' }) %>

    <main class="instructor-main">
        <div class="main-container">

            <div class="page-header">
                <div>
                    <h1 class="page-title">System Settings</h1>
                    <p class="page-subtitle">Rules that apply across FaciTrack. Changes take effect immediately — no restart needed.</p>
                </div>
            </div>

            <div class="settings-grid">

                <!-- Appointment Settings -->
                <div class="content-card settings-card" data-card="appointments">
                    <div class="card-header">
                        <h3 class="card-title">Appointment Settings</h3>
                    </div>
                    <div class="card-body">
                        <p class="settings-section-desc">How far ahead students may book, and how often instructors are chased about requests they have not answered.</p>
                        <div class="settings-group">

                            <div class="settings-field">
                                <label class="settings-label" for="bookingLeadTimeHours">Booking lead time (hours)</label>
                                <input type="number" class="settings-input" id="bookingLeadTimeHours" min="0" max="168" step="1"
                                       value="<%= settings.booking_lead_time_hours %>">
                                <p class="settings-hint">Students may book the same day, but not a slot starting within this many hours.</p>
                            </div>

                            <div class="settings-field">
                                <label class="settings-label" for="pendingNudgeEveryHours">Remind instructors every (hours)</label>
                                <input type="number" class="settings-input" id="pendingNudgeEveryHours" min="1" max="168" step="1"
                                       value="<%= settings.pending_nudge_every_hours %>">
                                <p class="settings-hint">How often an unanswered booking request is chased, until it is approved or declined.</p>
                            </div>

                            <hr class="settings-divider">
                            <p class="settings-subhead">Make-up classes</p>

                            <div class="settings-field">
                                <label class="settings-label" for="makeupMaxWeeksAhead">Booking window (weeks ahead)</label>
                                <input type="number" class="settings-input" id="makeupMaxWeeksAhead" min="1" max="52" step="1"
                                       value="<%= settings.makeup_max_weeks_ahead %>">
                                <p class="settings-hint">The furthest ahead a make-up class may be scheduled.</p>
                            </div>

                            <div class="settings-field">
                                <label class="settings-label" for="makeupDayStart">Earliest start</label>
                                <input type="time" class="settings-input" id="makeupDayStart" value="<%= settings.makeup_day_start %>">
                            </div>

                            <div class="settings-field">
                                <label class="settings-label" for="makeupDayEnd">Latest end</label>
                                <input type="time" class="settings-input" id="makeupDayEnd" value="<%= settings.makeup_day_end %>">
                                <p class="settings-hint">Make-up sessions must fall inside these hours.</p>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Presence Detection -->
                <div class="content-card settings-card" data-card="presence">
                    <div class="card-header">
                        <h3 class="card-title">Presence Detection</h3>
                    </div>
                    <div class="card-body">
                        <p class="settings-section-desc">How the BLE scanners decide who is in a room. Changes take effect on the next report — no board needs re-flashing.</p>
                        <div class="settings-group">

                            <div class="settings-field">
                                <label class="settings-label" for="presenceRssiThreshold">Default in-room signal threshold (dBm)</label>
                                <input type="number" class="settings-input" id="presenceRssiThreshold" min="-100" max="-30" step="1"
                                       value="<%= settings.presence_rssi_threshold %>">
                                <p class="settings-hint">A tag heard at this strength or better counts as in the room. Closer to 0 is stronger, so −60 is stricter than −85. Individual rooms can override this in <a href="/admin/beacons">BLE Devices</a>.</p>
                            </div>

                            <div class="settings-field">
                                <label class="settings-label" for="presenceRssiExitMargin">Exit margin (dB)</label>
                                <input type="number" class="settings-input" id="presenceRssiExitMargin" min="0" max="30" step="1"
                                       value="<%= settings.presence_rssi_exit_margin %>">
                                <p class="settings-hint">Once someone counts as in a room they stay in until they fall this far below the threshold. It stops a person sitting near the cutoff flickering in and out as the signal wavers. With a threshold of <%= settings.presence_rssi_threshold %> dBm they would enter at <%= settings.presence_rssi_threshold %> and only leave below <%= settings.presence_rssi_threshold - settings.presence_rssi_exit_margin %>. Set 0 for a single hard cutoff.</p>
                            </div>

                            <div class="settings-field">
                                <label class="settings-label" for="presenceRoomSwitchMargin">Room switch margin (dB)</label>
                                <input type="number" class="settings-input" id="presenceRoomSwitchMargin" min="0" max="30" step="1"
                                       value="<%= settings.presence_room_switch_margin %>">
                                <p class="settings-hint">When two rooms can both hear the same tag, the room already holding someone keeps them until another room hears them this much more strongly. Without it presence flips to whichever scanner reported most recently. Raise it if people flicker between adjacent rooms; if that keeps happening, the two rooms overlap and one needs a tighter threshold instead. At 0 the strongest reading still wins — there is just no dead band, so a single dB is enough to move somebody.</p>
                            </div>

                            <div class="settings-field">
                                <label class="settings-label" for="presenceSightingFresh">Treat a sighting as current for (seconds)</label>
                                <input type="number" class="settings-input" id="presenceSightingFresh" min="3" max="60" step="1"
                                       value="<%= settings.presence_sighting_fresh_sec %>">
                                <p class="settings-hint">A scanner keeps reporting a tag for up to 30 seconds after it last actually heard it. Past this age the reading counts as a memory rather than a sighting, and the person is marked out — so this is the main control over how quickly someone shows as gone. <strong>Keep it below your scanners' report interval</strong> (10 seconds in the shipped firmware): at 8 seconds a departure is caught on the very next report, while at 10 or more it waits for the one after, which doubles the delay. Raise it if people flicker out while still in the room — that means the signal is too weak to sustain a short window, and the fix is signal strength, not this number.</p>
                            </div>

                            <div class="settings-field">
                                <label class="settings-label" for="presenceAbsentAfter">Mark absent after (seconds)</label>
                                <input type="number" class="settings-input" id="presenceAbsentAfter" min="30" max="3600" step="1"
                                       value="<%= settings.presence_absent_after_sec %>">
                                <p class="settings-hint">Nothing announces a departure, so someone is counted as gone once they have not been heard for this long.</p>
                            </div>

                            <div class="settings-field">
                                <label class="settings-label" for="presenceScannerOffline">Call a scanner offline after (seconds)</label>
                                <input type="number" class="settings-input" id="presenceScannerOffline" min="30" max="3600" step="1"
                                       value="<%= settings.presence_scanner_offline_after_sec %>">
                                <p class="settings-hint">Scanners report every 10 seconds, so this should span several missed reports.</p>
                            </div>

                            <div class="settings-toggle-row">
                                <div>
                                    <p class="settings-toggle-label">Presence history</p>
                                    <p class="settings-toggle-desc">Record every entry and exit for the dean's presence log.</p>
                                </div>
                                <label class="toggle-switch">
                                    <input type="checkbox" id="presenceLoggingEnabled" <%= settings.presence_logging_enabled ? 'checked' : '' %>>
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>

                        </div>
                    </div>
                </div>

                <!-- Notification Channels -->
                <div class="content-card settings-card" data-card="channels">
                    <div class="card-header">
                        <h3 class="card-title">Notification Channels</h3>
                    </div>
                    <div class="card-body">
                        <p class="settings-section-desc">Switch an outbound channel off for everyone. The in-app notification bell is unaffected either way.</p>
                        <div class="settings-group">

                            <div class="settings-toggle-row">
                                <div>
                                    <p class="settings-toggle-label">Email notifications</p>
                                    <p class="settings-toggle-desc">Send confirmations, reminders and verification codes by email.</p>
                                </div>
                                <label class="toggle-switch">
                                    <input type="checkbox" id="emailEnabled" <%= settings.email_enabled ? 'checked' : '' %>>
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>

                            <div class="settings-toggle-row">
                                <div>
                                    <p class="settings-toggle-label">Push notifications</p>
                                    <p class="settings-toggle-desc">Send device notifications, which arrive with the app closed.</p>
                                </div>
                                <label class="toggle-switch">
                                    <input type="checkbox" id="pushEnabled" <%= settings.push_enabled ? 'checked' : '' %>>
                                    <span class="toggle-slider"></span>
                                </label>
                            </div>

                        </div>

                        <div class="settings-note">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                            <span>
                                <% if (smtpConfigured) { %>
                                    Mail server: <strong><%= smtpHost %></strong>. With email switched off, messages are written to the server log instead of being sent.
                                <% } else { %>
                                    No mail server is configured, so email is written to the server log whatever this switch says. SMTP host and credentials live in <strong>.env</strong> — they are deployment secrets and are deliberately not editable here.
                                <% } %>
                            </span>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Unsaved-changes bar -->
            <div class="dirty-bar" id="dirtyBar">
                <div class="dirty-bar-inner">
                    <div>
                        <p class="dirty-bar-text" id="dirtyBarText">You have unsaved changes.</p>
                        <p class="dirty-bar-sub">They will be lost if you leave this page.</p>
                    </div>
                    <div class="dirty-bar-actions">
                        <button type="button" class="btn-discard" id="btnDiscardAll">Discard</button>
                        <button type="button" class="btn-save-all" id="btnSaveAll">Save all changes</button>
                    </div>
                </div>
            </div>

        </div>
    </main>
</div>

<!-- Leave confirmation, for in-app navigation -->
<div class="modal-overlay" id="leaveOverlay">
    <div class="modal-content" style="max-width:420px;">
        <div class="modal-header">
            <h3 class="modal-title">Unsaved changes</h3>
        </div>
        <div class="modal-body">
            <p style="font-size:.875rem;color:var(--gray-600);line-height:1.65;margin:0;" id="leaveBody">
                You have unsaved changes on this page. What would you like to do?
            </p>
            <div class="leave-modal-actions">
                <button type="button" class="btn-modal btn-cancel" id="leaveStay">Stay on page</button>
                <button type="button" class="btn-modal btn-cancel" id="leaveDiscard">Leave without saving</button>
                <button type="button" class="btn-modal btn-primary" id="leaveSave">Save &amp; leave</button>
            </div>
        </div>
    </div>
</div>

<div class="toast-container" id="toastContainer"></div>
<%- include('../../partials/footer') %>
<%- include('../../partials/script') %>
<script src="/js/settings-tracker.js?v=<%= assetVersion %>"></script>
<script src="/js/admin-settings.js?v=<%= assetVersion %>"></script>
