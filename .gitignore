# 3D assets. Meshy_AI_*/ are the raw Meshy exports the models were built from;
# nothing in the app references them, and they are far too big for GitHub.
# public/models/*.glb ARE committed: they are the compressed copies the 3D
# building view loads (about 12 MB in all). The uncompressed originals are kept
# in backups/models-original/, which is ignored below.
Meshy_AI_*/

# Database dumps taken before migrations. Real data — never committed.
backups/

