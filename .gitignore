# 3D assets — kept out of git because they blow past GitHub's limits.
# Meshy_AI_*/ are the raw Meshy exports the .glb files were built from; nothing
# in the app references them. public/models/*.glb ARE loaded at runtime by
# public/js/ccs-building-loader.js, so they must be copied onto any new clone
# by hand or the 3D building view will fail to load.
Meshy_AI_*/
public/models/*.glb

# Database dumps taken before migrations. Real data — never committed.
backups/

# Exclude jmeter metrics and statistics
jmeter